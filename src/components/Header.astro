---
import { getBusinessInfo } from "../lib/sanity.js";
import ThemeToggle from "./ThemeToggle.astro";
import { safeCmsUrl } from "../utils/url";

const business = await getBusinessInfo();

const businessName = business?.name || "Podologos Via Morelos";
const businessArea = business?.area || "Tulpetlac, Ecatepec";
const address = business?.address || "Dirección pendiente";
const phone = business?.phone || "Teléfono pendiente";
const weekdayHours = business?.weekdayHours || "10 a.m. – 6 p.m.";
const saturdayHours = business?.saturdayHours || "10 a.m. – 4 p.m.";
const sundayOpen = Boolean(business?.sundayOpen);
const sundayHours = business?.sundayHours || "";

const currentDay = new Date().getDay();
const dayNames = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
const todayName = dayNames[currentDay] || "hoy";
const scheduleLabel =
  currentDay >= 1 && currentDay <= 5
    ? `Horario de hoy: ${todayName} de ${weekdayHours}`
    : currentDay === 6 && saturdayHours
      ? `Horario de hoy: ${todayName} de ${saturdayHours}`
      : currentDay === 6
        ? `Horario de hoy: ${todayName} cerrado`
        : sundayOpen && sundayHours
          ? `Horario de hoy: ${todayName} de ${sundayHours}`
          : "Horario de hoy: domingo cerrado";
const logoUrl = business?.logoImageUrl || "/default-logo-clinica.svg";

const facebookUrl = safeCmsUrl(business?.facebookUrl, "");
const instagramUrl = safeCmsUrl(business?.instagramUrl, "");
const tiktokUrl = safeCmsUrl(business?.tiktokUrl, "");

const socialLinks = [
  { key: "facebook", label: "Facebook", url: facebookUrl },
  { key: "instagram", label: "Instagram", url: instagramUrl },
  { key: "tiktok", label: "TikTok", url: tiktokUrl },
];

const primaryNavItems = [
  { href: "/servicios", label: "Servicios" },
  { href: "/precios", label: "Precios" },
  { href: "/ubicacion", label: "Ubicación" },
];
const primaryCta = { href: "/agendar", label: "Agenda tu cita" };
const secondaryNavItems = [
  { href: "/", label: "Inicio" },
  { href: "/especialistas", label: "Especialistas" },
  { href: "/promociones", label: "Promociones" },
  { href: "/galeria", label: "Fotos y videos" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/faq", label: "FAQ" },
  { href: "/contacto", label: "Contacto" },
];
const desktopNavItems = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/especialistas", label: "Especialistas" },
  { href: "/precios", label: "Precios" },
  { href: "/ubicacion", label: "Ubicación" },
  { href: "/promociones", label: "Promociones" },
  { href: "/galeria", label: "Fotos y videos" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/faq", label: "FAQ" },
  { href: "/contacto", label: "Contacto" },
  primaryCta,
];

const currentPath = (Astro.url?.pathname || "/").replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const cleanHref = href.replace(/\/+$/, "") || "/";
  if (cleanHref === "/") return currentPath === "/";
  return currentPath === cleanHref || currentPath.startsWith(`${cleanHref}/`);
};
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur dark:border-[rgb(36,58,86)] dark:bg-[rgb(8,20,38)]/95">
  <div class="hidden border-b border-slate-100 bg-white md:block dark:border-[rgb(28,48,74)] dark:bg-[rgb(6,16,32)]">
    <div class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-between gap-3 px-5 py-2.5 text-[13px] text-slate-600 dark:text-[rgb(186,205,227)]">
      <p
        id="today-hours"
        class="min-w-[14rem] flex-1 truncate"
        data-weekday-hours={weekdayHours}
        data-saturday-hours={saturdayHours}
        data-sunday-open={sundayOpen ? "true" : "false"}
        data-sunday-hours={sundayHours}
      >
        {scheduleLabel}
      </p>
      <p class="hidden min-w-[18rem] flex-[1.2] truncate text-center lg:block">{address}</p>
      <p class="shrink-0 font-semibold text-sky-700 dark:text-[rgb(123,198,255)]">Tel: {phone}</p>
    </div>
  </div>

  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-3.5 sm:px-5 sm:py-4 lg:gap-6">
    <a href="/" class="flex min-w-0 max-w-[calc(100%-7.5rem)] items-center gap-2.5 sm:max-w-[calc(100%-8.5rem)] sm:gap-3 md:max-w-none">
      <img src={logoUrl} alt={businessName} class="h-10 w-10 shrink-0 rounded-md object-contain sm:h-11 sm:w-11 md:h-12 md:w-12 lg:h-14 lg:w-14" loading="eager" data-fallback-src="/default-logo-clinica.svg" />
      <div class="min-w-0">
        <p class="truncate text-[1rem] font-semibold tracking-tight text-slate-900 sm:text-[1.08rem] dark:text-[rgb(236,244,255)]">{businessName}</p>
        <p class="hidden max-w-[34ch] text-[0.92rem] font-medium leading-5 text-slate-600 sm:block dark:text-[rgb(186,205,227)]">{businessArea}</p>
      </div>
    </a>

    <div class="hidden shrink-0 items-center gap-2 md:flex">
      <div class="flex items-center gap-2">
        {socialLinks.map((social) => {
          const configured = Boolean(social.url);
          const sharedClass = configured
            ? "rounded-full border border-slate-200 p-1.5 text-slate-600 hover:bg-slate-100 dark:border-[rgb(59,87,120)] dark:text-[rgb(196,216,240)] dark:hover:bg-[rgb(25,48,76)]"
            : "rounded-full border border-slate-200 p-1.5 text-slate-400 opacity-70 cursor-not-allowed dark:border-[rgb(59,87,120)] dark:text-[rgb(128,152,182)]";

          return (
            <a
              class={sharedClass}
              href={configured ? social.url : "#"}
              target={configured ? "_blank" : undefined}
              rel={configured ? "noopener noreferrer" : undefined}
              aria-label={social.label}
              title={configured ? social.label : `Configura ${social.label} en CMS > Información del negocio > Redes`}
              aria-disabled={configured ? "false" : "true"}
              tabindex={configured ? "0" : "-1"}
            >
              {social.key === "facebook" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M13 9h3V6h-3c-2.8 0-5 2.2-5 5v2H6v3h2v5h3v-5h3l1-3h-4v-2c0-1.1.9-2 2-2z"/></svg>}
              {social.key === "instagram" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm10.5 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>}
              {social.key === "tiktok" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M14 3c.4 1.7 1.8 3 3.5 3.2V9c-1.4-.1-2.6-.6-3.5-1.4V14a6 6 0 1 1-5.4-6v2.8a3.2 3.2 0 1 0 2.6 3.2V3H14z"/></svg>}
            </a>
          );
        })}
      </div>
      <ThemeToggle compact />
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2 md:hidden">
      <ThemeToggle compact />
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-[rgb(59,87,120)] dark:text-[rgb(214,228,245)] dark:hover:bg-[rgb(25,48,76)]"
        data-mobile-menu-button
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="menu-icon-open h-5 w-5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="menu-icon-close h-5 w-5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        <span data-menu-label>Menú</span>
      </button>
    </div>
  </div>

  <div class="hidden border-t border-slate-200 md:block dark:border-[rgb(36,58,86)]">
    <nav class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-center gap-x-6 gap-y-3 px-5 py-3 text-[15px] font-medium lg:gap-x-8">
      {desktopNavItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class={`nav-link whitespace-nowrap ${isActive(item.href) ? "text-sky-700 dark:text-[rgb(126,203,255)] after:scale-x-100 font-semibold" : "hover:text-sky-700 dark:hover:text-[rgb(126,203,255)]"}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div id="mobile-nav-panel" class="hidden border-t border-slate-100 bg-white px-4 pb-5 pt-4 md:hidden dark:border-[rgb(36,58,86)] dark:bg-[rgb(8,20,38)]">
    <a href={primaryCta.href} class={`btn-base w-full ${isActive(primaryCta.href) ? "btn-primary" : "btn-secondary"}`}>
      {primaryCta.label}
    </a>
    <p class="mb-2 mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-[rgb(166,190,218)]">Accesos principales</p>
    <nav class="grid gap-1.5 text-sm font-medium">
      {primaryNavItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class={`rounded-lg px-3 py-2 ${isActive(item.href) ? "bg-sky-100 text-sky-800 dark:bg-[rgb(25,48,76)] dark:text-[rgb(126,203,255)]" : "hover:bg-sky-50 dark:hover:bg-[rgb(18,39,65)]"}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mt-4 border-t border-sky-100 pt-4 dark:border-[rgb(36,58,86)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-[rgb(166,190,218)]">Más secciones</p>
      <nav class="grid gap-1.5 text-sm font-medium">
        {secondaryNavItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`rounded-lg px-3 py-2 ${isActive(item.href) ? "bg-sky-100 text-sky-800 dark:bg-[rgb(25,48,76)] dark:text-[rgb(126,203,255)]" : "hover:bg-sky-50 dark:hover:bg-[rgb(18,39,65)]"}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const todayHoursEl = document.getElementById("today-hours");
    const button = document.querySelector("[data-mobile-menu-button]");
    const panel = document.getElementById("mobile-nav-panel");
    if (!button || !panel) return;

    if (todayHoursEl) {
      const weekdayHours = todayHoursEl.dataset.weekdayHours || "10 a.m. – 6 p.m.";
      const saturdayHours = todayHoursEl.dataset.saturdayHours || "10 a.m. – 4 p.m.";
      const sundayOpen = todayHoursEl.dataset.sundayOpen === "true";
      const sundayHours = todayHoursEl.dataset.sundayHours || "";

      const day = new Date().getDay();
      const dayNames = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
      const todayName = dayNames[day] || "hoy";

      const todayText =
        day >= 1 && day <= 5
          ? `Horario de hoy: ${todayName} de ${weekdayHours}`
          : day === 6 && saturdayHours
            ? `Horario de hoy: ${todayName} de ${saturdayHours}`
            : day === 6
              ? `Horario de hoy: ${todayName} cerrado`
              : sundayOpen && sundayHours
                ? `Horario de hoy: ${todayName} de ${sundayHours}`
                : "Horario de hoy: domingo cerrado";

      todayHoursEl.textContent = todayText;
    }

    const closeMenu = () => {
      panel.classList.add("hidden");
      panel.classList.remove("menu-slide-in");
      button.setAttribute("aria-expanded", "false");
      const label = button.querySelector("[data-menu-label]");
      if (label) label.textContent = "Menú";
    };

    button.addEventListener("click", () => {
      const willOpen = panel.classList.contains("hidden");
      panel.classList.toggle("hidden");
      button.setAttribute("aria-expanded", willOpen ? "true" : "false");
      const label = button.querySelector("[data-menu-label]");
      if (label) label.textContent = willOpen ? "Cerrar" : "Menú";
      if (willOpen) {
        panel.classList.remove("menu-slide-in");
        void panel.offsetWidth;
        panel.classList.add("menu-slide-in");
      }
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });
  })();
</script>

---
import { getBusinessInfo } from "../lib/sanity.js";
import { safeCmsUrl } from "../utils/url";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { business as biz } from "../config/clinic";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = lang === "en" ? "/en" : "";

const cms = await getBusinessInfo();
const businessName = cms?.name || biz.name;
const phone = cms?.phone || biz.phoneDisplay;
const logoUrl = cms?.logoImageUrl || "/default-logo.svg";

const facebookUrl = safeCmsUrl(cms?.facebookUrl, "");
const instagramUrl = safeCmsUrl(cms?.instagramUrl, "");

const menuTitle = lang === "en" ? t.footer.menu : (cms?.footerMenuTitle || "Menú");
const siteTitle = lang === "en" ? t.footer.site : (cms?.footerSiteTitle || "Sobre el sitio");
const privacyLabel = lang === "en" ? t.footer.privacy : (cms?.footerPrivacyLabel || "Aviso de privacidad");
const privacyUrl = safeCmsUrl(cms?.footerPrivacyUrl, `${pfx}/privacidad`);
const noticesLabel = lang === "en" ? t.footer.notices : (cms?.footerNoticesLabel || "Comunicados");
const noticesUrl = safeCmsUrl(cms?.footerNoticesUrl, `${pfx}/comunicados`);
const copyrightText = lang === "en" ? t.footer.rights : (cms?.footerCopyrightText || "Todos los derechos reservados.");
const footerTagline = lang === "en"
  ? biz.taglineEn
  : (cms?.footerTagline || biz.tagline);

const weekdayHours = cms?.weekdayHours || "8 a.m. – 5 p.m.";
const saturdayHours = cms?.saturdayHours || "8 a.m. – 12 p.m.";
const sundayOpen = Boolean(cms?.sundayOpen);
const sundayHours = cms?.sundayHours || "";

const socialLinks = [
  { key: "facebook", label: "Facebook", url: facebookUrl },
  { key: "instagram", label: "Instagram", url: instagramUrl },
];

const menuLinks = lang === "en"
  ? [
      { href: "/en",              label: "Home"          },
      { href: "/en/servicios",    label: "Services"      },
      { href: "/en/precios",      label: "Pricing"       },
      { href: "/en/especialistas",label: "Technicians"   },
      { href: "/en/galeria",      label: "Gallery"       },
      { href: "/en/nosotros",     label: "About Us"      },
      { href: "/en/ubicacion",    label: "Location"      },
      { href: "/en/contacto",     label: "Contact"       },
      { href: "/en/faq",          label: "FAQ"           },
      { href: "/en/agendar",      label: "Request Service"},
    ]
  : [
      { href: "/",            label: "Inicio"          },
      { href: "/servicios",   label: "Servicios"       },
      { href: "/precios",     label: "Precios"         },
      { href: "/especialistas",label: "Técnicos"       },
      { href: "/galeria",     label: "Galería"          },
      { href: "/nosotros",    label: "Nosotros"        },
      { href: "/ubicacion",   label: "Ubicación"       },
      { href: "/contacto",    label: "Contacto"        },
      { href: "/faq",         label: "FAQ"             },
      { href: "/agendar",     label: "Solicitar servicio"},
    ];
---

<footer class="mt-16 overflow-hidden bg-[#1a0505] text-[rgb(252,225,225)]">
  <div class="h-1 w-full bg-gradient-to-r from-red-900 via-red-400 to-red-900"></div>

  <div class="border-b border-[rgb(48,10,10)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 py-10 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <p class="font-['Manrope',sans-serif] text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
          {lang === "en" ? "Ready to protect your home?" : "¿Listo para proteger tu hogar?"}
        </p>
        <p class="mt-1.5 text-base font-medium text-[rgb(245,195,195)]">
          {lang === "en"
            ? "Request a service today and keep pests away."
            : "Solicita un servicio hoy y mantén las plagas fuera."}
        </p>
      </div>
      <a href={`${pfx}/agendar`} class="btn-base btn-primary shrink-0 shadow-[0_8px_28px_-8px_rgba(2,120,210,0.6)]">
        {lang === "en" ? "Request service" : "Solicitar servicio"}
      </a>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-4 lg:gap-10">
      <div class="col-span-2 lg:col-span-1">
        <a href={lang === "en" ? "/en" : "/"} class="inline-flex items-center gap-3">
          <img src={logoUrl} alt={businessName} class="h-10 w-auto rounded-md bg-white/10 p-1 sm:h-11 md:h-12" loading="lazy" data-fallback-src="/default-logo.svg" />
          <span class="font-['Manrope',sans-serif] text-base font-bold leading-tight text-white">{businessName}</span>
        </a>
        <p class="type-footer-body mt-3 text-[rgb(245,195,195)]">{footerTagline}</p>
        {phone && (
          <a href={`tel:${phone}`} class="type-footer-body mt-2 inline-flex items-center gap-1.5 font-semibold text-[rgb(255,150,150)] transition hover:text-[rgb(252,210,210)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
            {phone}
          </a>
        )}
        <div class="mt-4 flex gap-2.5">
          {socialLinks.map((social) => {
            const configured = Boolean(social.url);
            return (
              <a
                class={`inline-flex h-9 w-9 items-center justify-center rounded-full transition-all duration-200 ${configured
                  ? "bg-white/10 text-[rgb(248,220,220)] hover:scale-110 hover:bg-white/20 hover:shadow-md"
                  : "cursor-not-allowed bg-white/5 text-[rgb(200,120,120)]"}`}
                href={configured ? social.url : "#"}
                target={configured ? "_blank" : undefined}
                rel={configured ? "noopener noreferrer" : undefined}
                aria-label={social.label}
                title={social.label}
                aria-disabled={configured ? "false" : "true"}
                tabindex={configured ? "0" : "-1"}
              >
                {social.key === "facebook" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="currentColor"><path d="M13 9h3V6h-3c-2.8 0-5 2.2-5 5v2H6v3h2v5h3v-5h3l1-3h-4v-2c0-1.1.9-2 2-2z"/></svg>}
                {social.key === "instagram" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="currentColor"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm10.5 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>}
              </a>
            );
          })}
        </div>
      </div>

      <div>
        <h3 class="type-footer-title text-[rgb(240,185,185)]">{menuTitle}</h3>
        <ul class="type-footer-body mt-4 space-y-2 text-[rgb(245,195,195)]">
          {menuLinks.map((link) => (
            <li><a class="footer-link hover:text-[rgb(255,150,150)]" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="type-footer-title text-[rgb(240,185,185)]">{siteTitle}</h3>
        <ul class="type-footer-body mt-4 space-y-2 text-[rgb(245,195,195)]">
          <li><a class="footer-link hover:text-[rgb(255,150,150)]" href={privacyUrl}>{privacyLabel}</a></li>
          <li><a class="footer-link hover:text-[rgb(255,150,150)]" href={noticesUrl}>{noticesLabel}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="type-footer-title text-[rgb(240,185,185)]">{lang === "en" ? "Hours" : "Horario"}</h3>
        <div class="mt-4 space-y-1.5 text-sm font-medium text-[rgb(245,195,195)]">
          <p class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            {lang === "en" ? "Mon – Fri:" : "Lun – Vie:"} {weekdayHours}
          </p>
          {saturdayHours && (
            <p class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
              {lang === "en" ? "Saturday:" : "Sábado:"} {saturdayHours}
            </p>
          )}
          {sundayOpen && sundayHours ? (
            <p class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              {lang === "en" ? "Sunday:" : "Domingo:"} {sundayHours}
            </p>
          ) : (
            <p class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span>
              {lang === "en" ? "Sunday: Closed" : "Domingo: Cerrado"}
            </p>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-[rgb(42,8,8)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 py-4 sm:flex-row sm:justify-between">
      <p class="text-xs font-medium text-[rgb(200,115,115)]">
        <a href="https://www.linkedin.com/in/ingabrahamjv/" target="_blank" rel="noopener noreferrer" class="underline-offset-2 hover:text-[rgb(255,190,190)] hover:underline">Sitio WEB-ABJV</a>
      </p>
      <p class="text-center text-xs font-medium text-[rgb(200,115,115)]">
        &copy; {new Date().getFullYear()} {businessName} &mdash; {copyrightText}
      </p>
      <div class="hidden sm:block" aria-hidden="true"></div>
    </div>
  </div>
</footer>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getAboutSection, getBusinessInfo, getGallery, getPromotions } from "../lib/sanity.js";
import { clinic } from "../config/clinic";
import { getGooglePlaceReviews } from "../lib/googleReviews.js";
import { normalizeServiceSlug } from "../utils/prefill";

type HomePromo = {
  _id?: string;
  slug?: string;
  title?: string;
  label?: string;
  shortDescription?: string;
  description?: string;
  startDate?: string;
  endDate?: string;
  pinned?: boolean;
  targetCategories?: string[];
  appliesTo?: string[];
  serviceCategories?: string[];
  imageUrl?: string;
};

type HomeGalleryItem = {
  _id?: string;
  title?: string;
  category?: string;
  type?: "image" | "video";
  featured?: boolean;
  imageUrl?: string;
  platform?: "youtube" | "tiktok" | "facebook";
  url?: string;
  linkOnly?: boolean;
  linkText?: string;
  linkPreviewImageUrl?: string;
  resolvedPreviewImageUrl?: string;
};

type AboutSection = {
  title?: string;
  intro?: string;
  secondary?: string;
  keyPoints?: string[];
  ctaText?: string;
  ctaUrl?: string;
  secondaryCtaText?: string;
  secondaryCtaUrl?: string;
  mainImageUrl?: string;
  galleryImageUrls?: string[];
  galleryCarouselIntervalMs?: number;
};

type GoogleReviewItem = {
  authorName: string;
  authorUrl: string;
  profilePhotoUrl: string;
  rating: number;
  text: string;
  relativeTimeDescription: string;
  unixTime: number;
};

type GoogleReviewsData = {
  placeName: string;
  rating: number;
  userRatingsTotal: number;
  googleMapsUrl: string;
  reviews: GoogleReviewItem[];
};

const business = await getBusinessInfo();
const about: AboutSection | null = await getAboutSection();
const promos = (await getPromotions()) || [];
const galleryItems = (await getGallery()) || [];

const normalized: HomePromo[] = promos.map((p: HomePromo) => ({
  ...p,
  pinned: Boolean(p.pinned),
  title: p.title || "Promocion",
}));

const todayForPromos = new Date();
todayForPromos.setHours(0, 0, 0, 0);
const activePromos = normalized.filter((promo) => {
  if (!promo.endDate) return true;
  const end = new Date(promo.endDate);
  if (Number.isNaN(end.getTime())) return true;
  end.setHours(0, 0, 0, 0);
  return todayForPromos <= end;
});

const homePromos = [...activePromos].sort((a, b) => Number(b.pinned) - Number(a.pinned)).slice(0, 8);
const featuredGallery: HomeGalleryItem[] = galleryItems.filter((it: HomeGalleryItem) => Boolean(it.featured));
const homeGallery: HomeGalleryItem[] = featuredGallery.length > 0 ? featuredGallery : galleryItems;
const homeGalleryPhotos: HomeGalleryItem[] = homeGallery.filter((it: HomeGalleryItem) => it.type !== "video");
const rawHomeGalleryVideos: HomeGalleryItem[] = homeGallery.filter((it: HomeGalleryItem) => it.type === "video");
const googleReviews: GoogleReviewsData | null = await getGooglePlaceReviews(business?.googlePlaceId, {
  maxReviews: 4,
});

const heroEyebrow = business?.homeHeroEyebrow || "Atención integral";
const heroTitle = business?.homeHeroTitle || "Cuidado profesional para tus pies y bienestar integral";
const heroSubtitle =
  business?.homeHeroSubtitle ||
  "Más de 20 años cuidando la salud de tus pies en Tulpetlac, Ecatepec. Servicios de podología, psicología, óptica, quiropráctica y dentista.";
const heroImageUrl =
  business?.homeHeroImageUrl ||
  "https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1800&q=80";
const heroCarouselFromCms = Array.isArray(business?.homeHeroCarouselImageUrls)
  ? business.homeHeroCarouselImageUrls.filter(Boolean)
  : [];
const heroSlides = Array.from(new Set([heroImageUrl, ...heroCarouselFromCms].filter(Boolean)));
const heroAutoplayMsRaw = Number(business?.homeHeroCarouselIntervalMs);
const heroAutoplayMs =
  Number.isFinite(heroAutoplayMsRaw) && heroAutoplayMsRaw >= 3000 && heroAutoplayMsRaw <= 12000
    ? Math.round(heroAutoplayMsRaw)
    : 5000;

const heroPrimaryCtaText = business?.homePrimaryCtaText || "Agenda tu cita";
const heroPrimaryCtaUrl = business?.homePrimaryCtaUrl || "/agendar";
const heroSecondaryCtaText = business?.homeSecondaryCtaText || "Nuestros servicios";
const heroSecondaryCtaUrl = business?.homeSecondaryCtaUrl || "/servicios";
const heroServiceChips = clinic.serviceCategories.map((category) => ({
  key: category.key,
  label: category.key === "optica" ? "Optica" : category.label,
  href: `/agendar?service=${encodeURIComponent(category.key)}`,
}));

const promotionsTitle = business?.homePromotionsTitle || "Promociones vigentes";
const promotionsSubtitle =
  business?.homePromotionsSubtitle || "Aprovecha descuentos y paquetes especiales sujetos a disponibilidad.";
const promotionsFallbackImage =
  business?.homePromotionFallbackImageUrl ||
  "https://images.unsplash.com/photo-1512069772995-ec65ed45afd6?auto=format&fit=crop&w=1400&q=80";
const googleReviewsTitle = business?.homeGoogleReviewsTitle || "Resenas de nuestros pacientes";
const googleReviewsSubtitle =
  business?.homeGoogleReviewsSubtitle ||
  "Conoce experiencias reales publicadas en Google Maps.";
const googleReviewsCtaText = business?.homeGoogleReviewsCtaText || "Ver resenas en Google";
const googleReviewsCtaUrl =
  googleReviews?.googleMapsUrl || business?.mapsUrl || clinic.googleMapsUrl;

const aboutTitle = about?.title || "Nosotros";
const aboutIntro =
  about?.intro ||
  "Somos un centro integral de salud en Tulpetlac enfocado en podología, psicología, óptica, quiropráctica y dentista con atención cercana y profesional.";
const aboutSecondary =
  about?.secondary ||
  "Nuestro objetivo es ayudarte a mejorar tu bienestar con tratamientos personalizados, explicaciones claras y seguimiento continuo.";
const aboutGallery = Array.isArray(about?.galleryImageUrls) ? about?.galleryImageUrls.filter(Boolean).slice(0, 4) : [];
const aboutGalleryPreview = aboutGallery.slice(0, 3);
const aboutMainImage =
  about?.mainImageUrl ||
  (aboutGallery[0] ||
    "https://images.unsplash.com/photo-1488972685288-c3fd157d7c7a?auto=format&fit=crop&w=1600&q=80");
const aboutKeyPoints = Array.isArray(about?.keyPoints) ? about.keyPoints.filter(Boolean).slice(0, 6) : [];
const aboutCtaText = about?.ctaText || "Agenda tu cita";
const aboutCtaUrl = about?.ctaUrl || "/agendar";
const aboutSecondaryCtaText = about?.secondaryCtaText || "Conócenos más";
const aboutSecondaryCtaUrl = about?.secondaryCtaUrl || "/nosotros";

function fmt(d: string | Date | null | undefined) {
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    });
  } catch {
    return String(d);
  }
}

function excerpt(p: HomePromo) {
  return (p.shortDescription || p.description || "").trim();
}

function promotionValidityText(p: HomePromo) {
  const hasStart = Boolean(p.startDate);
  const hasEnd = Boolean(p.endDate);
  if (!hasStart && !hasEnd) return "";
  if (hasStart && hasEnd) return `Vigencia: ${fmt(p.startDate)} a ${fmt(p.endDate)}`;
  if (hasStart) return `Vigencia desde: ${fmt(p.startDate)}`;
  return `Vigencia hasta: ${fmt(p.endDate)}`;
}

function promotionHref(p: HomePromo) {
  return `/promociones/${encodeURIComponent((p.slug || p._id || "").trim())}`;
}

const normalizeCategory = normalizeServiceSlug;

function agendarPromoHref(p: HomePromo) {
  const params = new URLSearchParams();
  const category =
    normalizeCategory((p.targetCategories || [])[0]) ||
    normalizeCategory((p.appliesTo || [])[0]) ||
    normalizeCategory((p.serviceCategories || [])[0]);
  if (category) params.set("service", category);
  if (p.title) params.append("services", p.title);
  const qs = params.toString();
  return qs ? `/agendar?${qs}` : "/agendar";
}

function extractYouTubeId(url?: string) {
  if (!url) return "";
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes("youtu.be")) {
      return parsed.pathname.replace("/", "");
    }
    if (parsed.hostname.includes("youtube.com")) {
      const fromQuery = parsed.searchParams.get("v");
      if (fromQuery) return fromQuery;
      const pathParts = parsed.pathname.split("/").filter(Boolean);
      const shortsIdx = pathParts.indexOf("shorts");
      if (shortsIdx >= 0 && pathParts[shortsIdx + 1]) return pathParts[shortsIdx + 1];
      const embedIdx = pathParts.indexOf("embed");
      if (embedIdx >= 0 && pathParts[embedIdx + 1]) return pathParts[embedIdx + 1];
      return "";
    }
  } catch {
    return "";
  }
  return "";
}

async function fetchWithTimeout(url: string, timeoutMs = 2500) {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, { signal: controller.signal });
  } finally {
    clearTimeout(timeoutId);
  }
}

async function fetchOEmbedThumbnail(url?: string, platform?: string) {
  if (!url) return "";
  try {
    if (platform === "tiktok") {
      const res = await fetchWithTimeout(`https://www.tiktok.com/oembed?url=${encodeURIComponent(url)}`);
      if (!res.ok) return "";
      const data = await res.json();
      return data?.thumbnail_url || "";
    }
    if (platform === "facebook") {
      const res = await fetchWithTimeout(`https://www.facebook.com/plugins/video/oembed.json/?url=${encodeURIComponent(url)}`);
      if (!res.ok) return "";
      const data = await res.json();
      return data?.thumbnail_url || "";
    }
  } catch {
    return "";
  }
  return "";
}

const homeGalleryVideos: HomeGalleryItem[] = await Promise.all(
  rawHomeGalleryVideos.map(async (it) => {
    const localPreview = it.linkPreviewImageUrl || it.imageUrl || "";
    const ytId = extractYouTubeId(it.url);
    const ytPreview = ytId ? `https://img.youtube.com/vi/${ytId}/hqdefault.jpg` : "";
    const remotePreview = await fetchOEmbedThumbnail(it.url, it.platform);
    return {
      ...it,
      resolvedPreviewImageUrl: localPreview || ytPreview || remotePreview || "",
    };
  })
);

function getVideoPreviewSource(it: HomeGalleryItem) {
  if (it.resolvedPreviewImageUrl) return it.resolvedPreviewImageUrl;
  return "";
}

function getVideoAspectClass(it: HomeGalleryItem) {
  if (it.platform === "tiktok") return "aspect-[4/3] w-full";
  if (it.platform === "facebook" || it.platform === "youtube") return "aspect-video w-full";
  return "aspect-video w-full";
}

function formatGoogleReviewDate(unixTime?: number) {
  if (!Number.isFinite(unixTime) || Number(unixTime) <= 0) return "";
  try {
    return new Date(Number(unixTime) * 1000).toLocaleDateString("es-MX", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  } catch {
    return "";
  }
}

function trimGoogleReviewText(text?: string) {
  const raw = String(text || "").replace(/\s+/g, " ").trim();
  if (!raw) return "";
  if (raw.length <= 260) return raw;
  return `${raw.slice(0, 257).trim()}...`;
}
---

<Layout>
  <Header />

  <main class="pb-12">
    <section class="relative overflow-hidden border-y border-sky-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
      <div class="absolute inset-0 overflow-hidden" data-hero-carousel data-hero-autoplay-ms={heroAutoplayMs}>
        {heroSlides.map((slide, index) => (
          <img
            class={`hero-slide absolute inset-0 h-full w-full object-cover ${index === 0 ? "is-active" : ""}`}
            data-hero-slide={index}
            src={slide}
            alt="Consultorio medico"
            loading={index === 0 ? "eager" : "lazy"}
            data-fallback-src="/placeholder.jpg"
          />
        ))}
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-sky-950/82 via-sky-900/68 to-slate-900/48"></div>
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -right-24 -top-24 h-[32rem] w-[32rem] rounded-full bg-sky-300/10 blur-[100px]"></div>
        <div class="absolute bottom-0 right-1/4 h-[22rem] w-[22rem] rounded-full bg-cyan-400/8 blur-[80px]"></div>
      </div>

      <div class="relative mx-auto max-w-6xl px-4 py-20 text-white md:py-28">
        <div class="max-w-4xl">
          <div>
            <div class="hero-animate hero-delay-1 mb-5 inline-flex items-center gap-2.5 rounded-full border border-white/18 bg-white/10 px-4 py-2 text-xs font-semibold text-white backdrop-blur-sm">
              <span class="relative flex h-2 w-2 shrink-0">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
              </span>
              Centro integral de salud · Tulpetlac, Ecatepec
            </div>
            <p class="hero-animate hero-delay-2 type-hero-eyebrow text-sky-100">{heroEyebrow}</p>
            <h1 class="hero-animate hero-delay-3 type-hero-title mt-3 max-w-4xl">{heroTitle}</h1>
            <p class="hero-animate hero-delay-4 type-hero-subtitle mt-4 max-w-3xl text-sky-50/95">{heroSubtitle}</p>

            <div class="hero-animate hero-delay-5 mt-8 flex flex-wrap gap-3">
              <a class="btn-base btn-primary shadow-[0_8px_24px_-8px_rgba(2,132,199,0.7)]" href={heroPrimaryCtaUrl}>
                {heroPrimaryCtaText}
              </a>
              <a class="btn-base border border-white/60 bg-white/10 text-white shadow-none backdrop-blur-sm hover:bg-white/20" href={heroSecondaryCtaUrl}>
                {heroSecondaryCtaText}
              </a>
            </div>

            <div class="hero-animate hero-delay-5 mt-8 max-w-4xl">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-100/75">Elige por servicio</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {heroServiceChips.map((chip) => (
                  <a
                    href={chip.href}
                    class="rounded-full border border-white/20 bg-white/8 px-3.5 py-1.5 text-sm font-semibold text-white/90 backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/16 hover:text-white"
                  >
                    {chip.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      {heroSlides.length > 1 && (
        <div class="absolute bottom-5 left-0 right-0 z-10 flex justify-center gap-2">
          {heroSlides.map((_, index) => (
            <button
              type="button"
              data-hero-dot={index}
              aria-label={`Imagen ${index + 1}`}
              class={`h-2 rounded-full transition-all duration-300 ${index === 0 ? "w-7 bg-white" : "w-2 bg-white/35 hover:bg-white/60"}`}
            />
          ))}
        </div>
      )}

      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#eef5fb] to-transparent dark:from-[#071428]" aria-hidden="true"></div>
    </section>

    <div data-reveal class="relative z-10 mx-auto -mt-4 max-w-4xl px-4">
      <div class="grid grid-cols-3 divide-x divide-sky-200/60 overflow-hidden rounded-2xl border border-sky-200/80 bg-white/96 shadow-[0_20px_48px_-18px_rgb(14_116_144/0.24)] backdrop-blur-md dark:divide-slate-700/60 dark:border-slate-800/80 dark:bg-slate-900/96 dark:shadow-[0_20px_48px_-18px_rgb(2_6_23/0.9)]">
        <div class="flex flex-col items-center gap-1 py-4 text-center sm:py-5">
          <span class="font-['Manrope',sans-serif] text-2xl font-extrabold leading-none tracking-tight text-sky-700 dark:text-sky-300 sm:text-3xl">20+</span>
          <span class="mt-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:text-xs">años de exp.</span>
        </div>
        <div class="flex flex-col items-center gap-1 py-4 text-center sm:py-5">
          <span class="font-['Manrope',sans-serif] text-2xl font-extrabold leading-none tracking-tight text-sky-700 dark:text-sky-300 sm:text-3xl">5</span>
          <span class="mt-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:text-xs">especialidades</span>
        </div>
        <div class="flex flex-col items-center gap-1 py-4 text-center sm:py-5">
          <span class="font-['Manrope',sans-serif] text-2xl font-extrabold leading-none tracking-tight text-amber-500 dark:text-amber-400 sm:text-3xl">
            {googleReviews ? `${Number(googleReviews.rating || 0).toFixed(1)}★` : "5.0★"}
          </span>
          <span class="mt-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:text-xs">Google Maps</span>
        </div>
      </div>
    </div>

    <section class="mx-auto mt-10 max-w-6xl px-4">
      <div data-reveal class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="mb-2 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-sky-700 dark:text-sky-300">
            <span class="h-px w-5 bg-sky-500" aria-hidden="true"></span>Ofertas especiales
          </p>
          <h2 class="type-section-title text-slate-900 dark:text-slate-100">{promotionsTitle}</h2>
          <p class="type-section-subtitle text-slate-800 dark:text-slate-200">{promotionsSubtitle}</p>
        </div>
        <div class="flex flex-col items-start gap-2 md:items-end">
          <a class="text-sm font-semibold text-sky-700 hover:underline dark:text-sky-300" href="/promociones">
            Ver todas las promociones
          </a>
        </div>
      </div>

      {homePromos.length === 0 ? (
        <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
          Pronto compartiremos promociones vigentes. Mientras tanto, puedes agendar tu cita.
        </div>
      ) : (
        <div data-home-promos-wrap class="mt-5">
          <div class="relative">
            <button
              type="button"
              data-promo-carousel-prev
              aria-label="Anterior"
              class="absolute left-1 top-1/2 z-20 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-lg text-slate-700 shadow-sm transition hover:scale-105 hover:bg-white sm:left-2 md:left-3 md:h-10 md:w-10 md:text-xl lg:-left-10 xl:-left-12 dark:border-slate-700 dark:bg-slate-900/95 dark:text-slate-100 dark:hover:bg-slate-900"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
            </button>

            <button
              type="button"
              data-promo-carousel-next
              aria-label="Siguiente"
              class="absolute right-1 top-1/2 z-20 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-lg text-slate-700 shadow-sm transition hover:scale-105 hover:bg-white sm:right-2 md:right-3 md:h-10 md:w-10 md:text-xl lg:-right-10 xl:-right-12 dark:border-slate-700 dark:bg-slate-900/95 dark:text-slate-100 dark:hover:bg-slate-900"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
            </button>

          <div data-promo-carousel-track class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none]">
            {homePromos.map((p, index) => (
              <article data-promo-carousel-item={index} data-promo-end={p.endDate || ""} class="group flex min-h-[29rem] min-w-[86%] snap-start flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_44px_-12px_rgb(14_116_144/0.18)] md:min-w-[48%] lg:min-w-[32%] dark:border-slate-800/80 dark:bg-slate-950 dark:hover:shadow-[0_20px_44px_-12px_rgb(2_6_23/0.6)]">
                <div class="h-1 w-full bg-gradient-to-r from-sky-500 via-cyan-400 to-sky-600"></div>
                <div data-promo-media class="promo-media w-full overflow-hidden bg-slate-50 ring-1 ring-slate-200/70 dark:bg-slate-900 dark:ring-slate-700/70">
                  <img data-promo-image class="h-full w-full object-contain object-center transition duration-500 group-hover:scale-[1.02]" src={p.imageUrl || promotionsFallbackImage} alt={p.title} loading="lazy" data-fallback-src={promotionsFallbackImage || "/placeholder.jpg"} />
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="type-card-title">{p.title}</h3>
                    {p.label && (
                      <span class="shrink-0 rounded-full bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-700 dark:bg-sky-900/40 dark:text-sky-300">
                        {p.label}
                      </span>
                    )}
                  </div>

                  <div class="mt-2 min-h-[4.8rem]">
                    {excerpt(p) && (
                      <p class="type-card-body overflow-hidden text-slate-600 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] dark:text-slate-300">
                        {excerpt(p)}
                      </p>
                    )}
                  </div>

                  {promotionValidityText(p) && (
                    <p class="type-meta mt-3 text-slate-500 dark:text-slate-400">{promotionValidityText(p)}</p>
                  )}

                  <div class="mt-auto flex gap-2 pt-4">
                    <a class="btn-base btn-primary flex-1" href={agendarPromoHref(p)}>
                      Agendar
                    </a>
                    <a class="btn-base btn-secondary" href={promotionHref(p)}>
                      Ver promocion
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          </div>

        </div>
      )}
    </section>

    <section class="mx-auto mt-12 max-w-6xl px-4">
      <div data-reveal class="grid gap-6 overflow-hidden rounded-3xl border border-sky-200/80 bg-gradient-to-br from-white via-sky-50/20 to-white p-6 shadow-[0_14px_48px_-20px_rgb(14_116_144/0.14)] md:grid-cols-[1.08fr,0.92fr] md:items-center dark:border-slate-800/80 dark:from-slate-950 dark:via-sky-950/20 dark:to-slate-950 dark:shadow-[0_14px_48px_-20px_rgb(2_6_23/0.7)] md:p-10">
        <div>
          <p class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">
            <span class="h-px w-5 bg-sky-500"></span>
            Conócenos
          </p>
          <h2 class="type-section-title mt-2">{aboutTitle}</h2>
          <p class="type-section-subtitle mt-4 text-slate-700 dark:text-slate-300">{aboutIntro}</p>
          <p class="type-section-subtitle mt-4 text-slate-700 dark:text-slate-300">{aboutSecondary}</p>

          {aboutKeyPoints.length > 0 && (

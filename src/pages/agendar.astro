---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../config/clinic";
import { getBusinessInfo, getPrices, getServices, getSpecialists } from "../lib/sanity.js";
import { getPrefillFromUrl, normalizeServiceSlug } from "../utils/prefill";
import { safeCmsUrl } from "../utils/url";
import { resolveWhatsAppNumber } from "../utils/whatsapp";

type ServiceItem = {
  title?: string;
  category?: string;
  slug?: string | { current?: string };
  priceFrom?: number;
  leadSpecialistSlug?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
};

type Specialist = {
  _id?: string;
  slug?: string;
  name?: string;
  specialty?: string;
  specialtyCategory?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  active?: boolean;
};

type PriceRow = {
  _id?: string;
  serviceTitle?: string;
  category?: string;
  leadSpecialistSlug?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  priceFrom?: number;
};

const business = await getBusinessInfo();
const services: ServiceItem[] = (await getServices()) || [];
const specialists: Specialist[] = (await getSpecialists()) || [];
const prices: PriceRow[] = (await getPrices()) || [];

const generalWhatsappNumber = resolveWhatsAppNumber(
  business?.whatsappCitasNumber,
  business.whatsappNumber
);
const specialistsWhatsappNumber = resolveWhatsAppNumber(
  business?.whatsappSpecialistsNumber,
  generalWhatsappNumber
);
const generalWhatsAppMessage = String(business?.whatsappGeneralMessage || "").trim();
const specialistsWhatsAppMessage = String(business?.whatsappSpecialistsMessage || "").trim();
const quickProblemDefault = String(business?.whatsappQuickProblemDefault || "").trim();
const address = business?.address || business.address;
const phoneDisplay = business?.phone || business.phoneDisplay;
const phoneHref = `tel:${String(phoneDisplay).replace(/\D/g, "") || business.phoneTel}`;
const hoursText = business?.hoursText || "L-V 10:00 a 18:00 · Sábado 10:00 a 16:00 · Domingo cerrado";
const mapsUrl = safeCmsUrl(business?.mapsUrl, business.googleMapsUrl);
const hasQuickWhatsApp = Boolean(generalWhatsappNumber);
const quickWhatsAppHref = hasQuickWhatsApp
  ? `https://wa.me/${generalWhatsappNumber}?text=${encodeURIComponent("Hola, quiero informacion para solicitar un servicio de fumigacion.")}`
  : "/contacto";

const categoryMap = new Map<string, string>();
for (const c of business.serviceCategories) categoryMap.set(c.key, c.label);
for (const s of services) {
  const key = normalizeServiceSlug(s?.category || "");
  if (key && !categoryMap.has(key)) categoryMap.set(key, s?.category || key);
}
for (const sp of specialists) {
  const key = normalizeServiceSlug(sp?.specialtyCategory || sp?.specialty || "");
  if (key && !categoryMap.has(key)) categoryMap.set(key, sp?.specialtyCategory || key);
}

const serviceOptions = Array.from(categoryMap.entries()).map(([key, label]) => ({ key, label }));

const specialistOptions = specialists
  .filter((sp) => Boolean((sp?.slug || sp?._id || "").trim()))
  .map((sp) => ({
    slug: String(sp?.slug || sp?._id || "").trim(),
    name: sp?.name || "Especialista",
    category: normalizeServiceSlug(sp?.specialtyCategory || sp?.specialty || ""),
    specialty: sp?.specialty || "",
    whatsAppNumber: String(sp?.whatsAppNumber || "").trim(),
    whatsAppMessage: String(sp?.whatsAppMessage || "").trim(),
  }));

const prefill = getPrefillFromUrl(Astro.url);
const quoteSelectionLimit = Math.max(1, Number(business.quoteSelectionLimit || 6));
const rawPrefillServices = Array.isArray(prefill.services) ? prefill.services.slice(0, quoteSelectionLimit) : [];

const priceCatalog = prices.map((item) => ({
  id: item._id || "",
  title: item.serviceTitle || "",
  category: normalizeServiceSlug(item.category || ""),
  specialist: String(item.leadSpecialistSlug || "").trim(),
  waNumber: resolveWhatsAppNumber(item.whatsAppNumber),
  waMessage: String(item.whatsAppMessage || "").trim(),
  priceFrom: Number(item.priceFrom || 0),
}));

const serviceCatalog = services.map((item) => ({
  title: item.title || "",
  category: normalizeServiceSlug(item.category || item.title || ""),
  specialist: String(item.leadSpecialistSlug || "").trim(),
  waNumber: resolveWhatsAppNumber(item.whatsAppNumber),
  waMessage: String(item.whatsAppMessage || "").trim(),
  priceFrom: Number(item.priceFrom || 0),
}));

function normalizeCatalogText(value: string | null | undefined) {
  return String(value || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

const prefillPriceIds = Array.isArray(prefill.priceIds) ? prefill.priceIds.slice(0, quoteSelectionLimit) : [];
const prefillServicesFromIds = prefillPriceIds
  .map((priceId) => priceCatalog.find((row) => row.id === priceId)?.title || "")
  .filter(Boolean);
const prefillServices =
  rawPrefillServices.length > 0
    ? rawPrefillServices.map((serviceName, index) => {
        const priceId = prefillPriceIds[index] || "";
        const trustedPrice = priceId ? priceCatalog.find((row) => row.id === priceId) : undefined;
        return trustedPrice?.title || serviceName;
      })
    : prefillServicesFromIds;
const prefillApproxTotal = prefillServices.reduce((sum, serviceName, index) => {
  const priceId = prefillPriceIds[index] || "";
  const priceMatch =
    (priceId &&
      priceCatalog.find(
        (row) => row.id === priceId && normalizeCatalogText(row.title) === normalizeCatalogText(serviceName)
      )) ||
    priceCatalog.find(
      (row) => normalizeCatalogText(row.title) === normalizeCatalogText(serviceName)
    );
  const price = Number(priceMatch?.priceFrom || 0);
  return sum + (Number.isFinite(price) && price > 0 ? price : 0);
}, 0);
const bookingPageContent = business?.bookingPageContent || {};
const bookingPageText = {
  eyebrow: String(bookingPageContent.eyebrow || "Solicitud rapida").trim(),
  title: String(bookingPageContent.title || "Solicita tu servicio").trim(),
  intro: String(
    bookingPageContent.intro ||
      "Dejanos tus datos y te ayudamos a solicitar tu servicio por WhatsApp. Si vienes desde servicios o precios, tu seleccion ya aparece aqui para que sigas sin empezar otra vez."
  ).trim(),
  primaryCtaText: String(bookingPageContent.primaryCtaText || "Llenar formulario").trim(),
  primaryCtaUrl: String(bookingPageContent.primaryCtaUrl || "#appointment-form").trim(),
  secondaryCtaText: String(bookingPageContent.secondaryCtaText || "Ver servicios").trim(),
  secondaryCtaUrl: String(bookingPageContent.secondaryCtaUrl || "/servicios").trim(),
  panelLabel: String(bookingPageContent.panelLabel || "Te tomara poco").trim(),
  stepOneTitle: String(bookingPageContent.stepOneTitle || "Cuentanos lo basico").trim(),
  stepOneBody: String(
    bookingPageContent.stepOneBody || "Con tu servicio, nombre y telefono ya podemos recibir tu solicitud."
  ).trim(),
  stepTwoTitle: String(bookingPageContent.stepTwoTitle || "Lo demas lo vemos contigo").trim(),
  stepTwoBody: String(
    bookingPageContent.stepTwoBody || "Si aun no sabes fecha, hora o tecnico disponible, puedes decidirlo despues."
  ).trim(),
  metaOneValue: String(bookingPageContent.metaOneValue || "WhatsApp").trim(),
  metaOneLabel: String(bookingPageContent.metaOneLabel || "te respondemos por mensaje").trim(),
  metaTwoValue: String(bookingPageContent.metaTwoValue || "Sin prisa").trim(),
  metaTwoLabel: String(bookingPageContent.metaTwoLabel || "fecha y hora pueden esperar").trim(),
  formTitle: String(bookingPageContent.formTitle || "Datos del servicio").trim(),
  summaryTitle: String(bookingPageContent.summaryTitle || "Resumen de tu solicitud").trim(),
  summaryEmptyStateText: String(
    bookingPageContent.summaryEmptyStateText || "Selecciona un servicio y te mostramos un precio aproximado."
  ).trim(),
  summaryCategoriesLabel: String(bookingPageContent.summaryCategoriesLabel || "Areas elegidas:").trim(),
  summaryCategoriesHint: String(bookingPageContent.summaryCategoriesHint || "Toca una para quitarla.").trim(),
  summaryRestoreLabel: String(bookingPageContent.summaryRestoreLabel || "Recuperar mi lista").trim(),
  summaryTotalLabel: String(bookingPageContent.summaryTotalLabel || "Total aproximado:").trim(),
};

const validServiceKeys = new Set(serviceOptions.map((option) => option.key));
let resolvedPrefillService = prefill.service || "";
if (!validServiceKeys.has(resolvedPrefillService)) {
  const firstServiceFromList = prefillServices[0] || "";
  const matchedCatalog = priceCatalog.find(
    (row) =>
      row.title &&
      row.category &&
      row.title.toLowerCase().trim() === firstServiceFromList.toLowerCase().trim() &&
      validServiceKeys.has(row.category)
  );
  if (matchedCatalog?.category) resolvedPrefillService = matchedCatalog.category;
}
---

<Layout title="Agendar | FumiPro NC">
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-10" id="contenido-principal">
    <section class="page-intro">
      <div class="page-intro__layout">
        <div>
          <p class="page-intro__eyebrow">{bookingPageText.eyebrow}</p>
          <h1 class="page-intro__title mt-3">{bookingPageText.title}</h1>
          <p class="page-intro__copy mt-3">{bookingPageText.intro}</p>
          <div class="page-intro__actions mt-6">
            <a class="btn-base btn-primary" href={bookingPageText.primaryCtaUrl}>{bookingPageText.primaryCtaText}</a>
            <a class="btn-base btn-secondary" href={bookingPageText.secondaryCtaUrl}>{bookingPageText.secondaryCtaText}</a>
          </div>
        </div>

        <aside class="page-intro__panel">
          <p class="page-intro__panel-label">{bookingPageText.panelLabel}</p>
          <div class="page-intro__panel-list mt-4">
            <div class="page-intro__panel-item">
              <span class="page-intro__step">1</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{bookingPageText.stepOneTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{bookingPageText.stepOneBody}</p>
              </div>
            </div>
            <div class="page-intro__panel-item">
              <span class="page-intro__step">2</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{bookingPageText.stepTwoTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{bookingPageText.stepTwoBody}</p>
              </div>
            </div>
          </div>

          <div class="page-intro__meta-grid">
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{bookingPageText.metaOneValue}</span>
              <span class="page-intro__meta-label">{bookingPageText.metaOneLabel}</span>
            </div>
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{bookingPageText.metaTwoValue}</span>
              <span class="page-intro__meta-label">{bookingPageText.metaTwoLabel}</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)] lg:items-start">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_24px_40px_-34px_rgba(15,23,42,0.45)] dark:border-slate-800 dark:bg-slate-950 md:p-7">
        <h2 class="text-lg font-semibold">{bookingPageText.formTitle}</h2>

        <form id="appointment-form" class="mt-4 grid gap-4" novalidate autocomplete="off">
          <div id="quote-summary" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm dark:border-red-900/40 dark:bg-red-950/20">
            <p class="font-semibold text-slate-900 dark:text-slate-100">{bookingPageText.summaryTitle}</p>
            <p id="context-badge" class="mt-1 hidden text-xs font-semibold text-red-700 dark:text-red-300">
              Especialista sugerido
            </p>
            <p id="quote-routing-target" class="mt-1 hidden text-xs font-medium text-slate-600 dark:text-slate-300"></p>
            <p id="quote-services" class="mt-1 text-slate-700 dark:text-slate-200">
              {prefillServices.length > 0 ? prefillServices.join(" · ") : bookingPageText.summaryEmptyStateText}
            </p>
            <div id="quote-categories-wrap" class="mt-1 hidden">
              <p class="text-xs font-medium text-slate-600 dark:text-slate-300">{bookingPageText.summaryCategoriesLabel}</p>
              <div id="quote-categories" class="mt-1 flex flex-wrap gap-2"></div>
              <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{bookingPageText.summaryCategoriesHint}</p>
            </div>
            <button id="restore-quote-btn" type="button" class="btn-base btn-ghost mt-2 hidden !h-8 !gap-1 !px-3 !text-xs">
              <span aria-hidden="true">↺</span>
              <span>{bookingPageText.summaryRestoreLabel}</span>
            </button>
            <p id="quote-total" class={`mt-1 text-slate-700 dark:text-slate-200 ${prefillApproxTotal > 0 ? "" : "hidden"}`}>
              <span class="font-semibold">{bookingPageText.summaryTotalLabel}</span>{" "}
              {new Intl.NumberFormat("es-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(prefillApproxTotal)}
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-800 dark:bg-slate-900/40">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-700 text-sm font-bold text-white">
                1
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">Datos básicos</p>
                <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Datos básicos del servicio</h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Con servicio, nombre y teléfono ya podemos recibir tu solicitud y darte seguimiento.</p>
              </div>
            </div>

            <div class="mt-4 grid gap-4">
              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="service">Servicio</label>
                <select id="service" name="service" required class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950">
                  <option value="" selected={!resolvedPrefillService} disabled>Selecciona servicio...</option>
                  {serviceOptions.map((s) => (
                    <option value={s.key} selected={resolvedPrefillService === s.key}>{s.label}</option>
                  ))}
                </select>
              </div>

              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="name">Nombre</label>
                <input id="name" name="name" required minlength="2" maxlength="80" autocomplete="name" class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950" placeholder="Tu nombre completo" />
              </div>

              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="phone">Teléfono</label>
                <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="numeric" class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950" placeholder="Ej. 55 2538 8683" />
                <p class="text-xs text-slate-500 dark:text-slate-400">Acepta espacios o guiones. Se valida entre 10 y 15 dígitos y evita números inválidos.</p>
                <p id="phone-error" class="hidden text-xs font-medium text-rose-600 dark:text-rose-400">Ingresa un teléfono válido de 10 a 15 dígitos.</p>
              </div>
            </div>
          </div>

          <details id="appointment-optional-panel" class="rounded-2xl border border-slate-200 bg-white/90 p-5 dark:border-slate-800 dark:bg-slate-950/80">
            <summary class="flex cursor-pointer list-none items-start gap-3">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                2
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Detalles opcionales</p>
                <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Horario, especialista y detalles</h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Abre esta sección solo si quieres afinar la solicitud antes de enviarla.</p>
              </div>
              <span class="mt-1 text-slate-500 transition details-chevron dark:text-slate-400" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.512a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
                </svg>
              </span>
            </summary>

            <div class="mt-4 grid gap-4">
              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="specialist">Especialista (opcional)</label>
                <select id="specialist" name="specialist" disabled class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] disabled:opacity-60 dark:border-slate-800 dark:bg-slate-950">
                  <option value="">Sin preferencia (el que esté disponible)</option>
                </select>
              </div>

              <div class="grid gap-4 sm:grid-cols-3">
                <div class="grid gap-2 sm:col-span-2">
                  <label class="text-[0.95rem] font-semibold" for="date">Fecha preferida (opcional)</label>
                  <input
                    id="date"
                    name="date"
                    type="date"
                    class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950"
                  />
                  <p id="date-readable" class="text-xs text-slate-500 dark:text-slate-400"></p>
                  <p id="date-error" class="hidden text-xs font-medium text-rose-600 dark:text-rose-400">Selecciona una fecha válida.</p>
                </div>
                <div class="grid gap-2">
                  <label class="text-[0.95rem] font-semibold" for="timeSlot">Hora exacta</label>
                  <select id="timeSlot" name="timeSlot" disabled class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] disabled:opacity-60 dark:border-slate-800 dark:bg-slate-950">
                    <option value="">Selecciona hora</option>
                  </select>
                  <p id="time-help" class="text-xs text-slate-500 dark:text-slate-400">Si prefieres, deja vacío y usa el turno.</p>
                </div>
              </div>

              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="shift">Turno (si no eliges hora)</label>
                <select id="shift" name="shift" class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950">
                  <option value="">Por definir</option>
                  <option value="Manana">Mañana</option>
                  <option value="Tarde">Tarde</option>
                </select>
              </div>

              <div class="grid gap-2">
                <label class="text-[0.95rem] font-semibold" for="notes">Problema o notas (opcional)</label>
                <textarea id="notes" name="notes" rows="3" maxlength="300" class="rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-[0.95rem] dark:border-slate-800 dark:bg-slate-950" placeholder="Describe brevemente tu motivo"></textarea>
              </div>
            </div>
          </details>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-800 dark:bg-slate-900/40">
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Confirma y continúa</p>
            <p id="send-whatsapp-help" class="mt-1 text-xs text-slate-600 dark:text-slate-300">
              Solo necesitas servicio, nombre y teléfono. Si falta algo obligatorio, te llevamos al primer campo por corregir.
            </p>
            <a id="send-whatsapp" href="#appointment-form" role="button" class="btn-base btn-primary mt-4 w-full">
              Completa tus datos para continuar por WhatsApp
            </a>
            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Validamos horario: L-V 10:00-18:00, sábado 10:00-16:00, domingo cerrado.</p>
          </div>
        </form>
      </section>

      <aside class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_24px_40px_-34px_rgba(15,23,42,0.45)] dark:border-slate-800 dark:bg-slate-950 md:p-7 lg:sticky lg:top-32 lg:translate-y-8">
        <div class="rounded-2xl border border-red-100 bg-red-50/70 p-4 dark:border-red-900/30 dark:bg-red-950/20">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">Contacto rápido</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-3 lg:grid-cols-1">
            <a
              class="btn-base btn-primary w-full"
              href={quickWhatsAppHref}
              target={hasQuickWhatsApp ? "_blank" : undefined}
              rel={hasQuickWhatsApp ? "noopener noreferrer" : undefined}
            >
              WhatsApp directo
            </a>
            <a class="btn-base btn-secondary w-full" href={phoneHref}>Llamar</a>
            <a class="btn-base btn-secondary w-full" href={mapsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          </div>
        </div>

        <div class="mt-6">
          <h2 class="text-lg font-semibold">Información</h2>
          <p class="mt-2 text-slate-700 dark:text-slate-200">{address}</p>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Teléfono: {phoneDisplay}</p>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Horarios: {hoursText}</p>
        </div>

        <div class="mt-6 border-t border-slate-200 pt-6 dark:border-slate-800">
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Qué sigue después de enviar</p>
          <ul class="mt-3 grid gap-2 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-red-600"></span><span>Recibimos tu solicitud por WhatsApp y confirmamos disponibilidad.</span></li>
            <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-red-600"></span><span>Si elegiste servicio o especialista, usamos esa referencia para orientar mejor la respuesta.</span></li>
            <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-red-600"></span><span>Duración aproximada de atención: 30 a 60 minutos según valoración.</span></li>
          </ul>
        </div>

        <div class="mt-6 border-t border-slate-200 pt-6 dark:border-slate-800">
          <a class="text-sm font-medium text-red-700 hover:underline dark:text-red-300" href="/ubicacion">Ver ubicación completa</a>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  #appointment-optional-panel > summary::-webkit-details-marker {
    display: none;
  }

  #appointment-optional-panel[open] .details-chevron {
    transform: rotate(180deg);
  }
</style>

<script
  id="agendar-config"
  type="application/json"
  is:inline
  set:html={JSON.stringify({
    generalWhatsappNumber,
    specialistsWhatsappNumber,
    generalWhatsAppMessage,
    specialistsWhatsAppMessage,
    quickProblemDefault,
    businessName: business?.name || business.name,
    pageText: bookingPageText,
    serviceOptions,
    specialistOptions,
    prefill: {
      ...prefill,
      service: resolvedPrefillService || prefill.service,
      services: prefillServices.length > 0 ? prefillServices : prefill.services,
      priceIds: prefillPriceIds.length > 0 ? prefillPriceIds : prefill.priceIds,
    },
    quoteSelectionLimit,
    priceCatalog,
    serviceCatalog,
  })}
></script>

<script>
  import {
    buildAppointmentMessage,
    buildWhatsAppUrl,
    resolveWhatsAppNumber,
    resolveWhatsAppReason,
  } from "../utils/whatsapp";
  import { formatDateMX, isSunday, isValidPhone, isValidPhoneInput, isWithinSchedule, sanitizePhone } from "../utils/validation";
  import { getPrefillFromUrl, normalizeServiceSlug } from "../utils/prefill";

  type SpecialistOption = {
    slug: string;
    name: string;
    category: string;
    specialty?: string;
    whatsAppNumber?: string;
    whatsAppMessage?: string;
  };

  type ClientConfig = {
    generalWhatsappNumber?: string;
    specialistsWhatsappNumber?: string;
    generalWhatsAppMessage?: string;
    specialistsWhatsAppMessage?: string;
    quickProblemDefault?: string;
    businessName?: string;
    pageText?: Record<string, string>;
    prefill?: {
      service?: string;
      specialist?: string;
      services?: string[];
      priceIds?: string[];
      specialists?: string[];
      waNumber?: string;
      waMessage?: string;
      waNumbers?: string[];
      waMessages?: string[];
      approxTotal?: number;
      routing?: "general";
    };
    specialistOptions?: SpecialistOption[];
    quoteSelectionLimit?: number;
    priceCatalog?: CatalogRoute[];
    serviceCatalog?: CatalogRoute[];
  };

  type CatalogRoute = {
    id?: string;
    title: string;
    category: string;
    specialist?: string;
    waNumber?: string;
    waMessage?: string;
    priceFrom: number;
  };

  const configEl = document.getElementById("agendar-config");
  const config = JSON.parse(configEl?.textContent || "{}") as ClientConfig;

  const form = document.getElementById("appointment-form") as HTMLFormElement | null;
  const sendBtn = document.getElementById("send-whatsapp") as HTMLAnchorElement | null;
  const nameInput = document.getElementById("name") as HTMLInputElement | null;
  const phoneInput = document.getElementById("phone") as HTMLInputElement | null;
  const serviceSelect = document.getElementById("service") as HTMLSelectElement | null;
  const specialistSelect = document.getElementById("specialist") as HTMLSelectElement | null;
  const dateInput = document.getElementById("date") as HTMLInputElement | null;
  const timeSlotSelect = document.getElementById("timeSlot") as HTMLSelectElement | null;
  const shiftSelect = document.getElementById("shift") as HTMLSelectElement | null;
  const notesInput = document.getElementById("notes") as HTMLTextAreaElement | null;
  const dateReadable = document.getElementById("date-readable") as HTMLParagraphElement | null;
  const dateError = document.getElementById("date-error") as HTMLParagraphElement | null;
  const phoneError = document.getElementById("phone-error") as HTMLParagraphElement | null;
  const timeHelp = document.getElementById("time-help") as HTMLParagraphElement | null;
  const quoteServicesEl = document.getElementById("quote-services") as HTMLParagraphElement | null;
  const quoteRoutingTargetEl = document.getElementById("quote-routing-target") as HTMLParagraphElement | null;
  const quoteCategoriesWrapEl = document.getElementById("quote-categories-wrap") as HTMLDivElement | null;
  const quoteCategoriesEl = document.getElementById("quote-categories") as HTMLDivElement | null;
  const restoreQuoteBtn = document.getElementById("restore-quote-btn") as HTMLButtonElement | null;
  const quoteTotalEl = document.getElementById("quote-total") as HTMLParagraphElement | null;
  const contextBadgeEl = document.getElementById("context-badge") as HTMLParagraphElement | null;
  const optionalDetails = document.getElementById("appointment-optional-panel") as HTMLDetailsElement | null;

  if (!form || !sendBtn || !nameInput || !phoneInput || !serviceSelect || !specialistSelect || !dateInput || !timeSlotSelect || !shiftSelect || !notesInput) {
    throw new Error("No se encontraron elementos del formulario de agendar");
  }

  dateInput.autocomplete = "off";
  dateInput.lang = "es-US";

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      window.location.reload();
    }
  });

  const specialistItems: SpecialistOption[] = Array.isArray(config.specialistOptions)
    ? config.specialistOptions
    : [];
  const serverPrefill = config.prefill || {};
  const urlPrefill = getPrefillFromUrl(window.location.href);
  const prefill = {
    ...serverPrefill,
    ...urlPrefill,
    services: Array.isArray(urlPrefill.services) && urlPrefill.services.length > 0
      ? urlPrefill.services
      : (Array.isArray(serverPrefill.services) ? serverPrefill.services : []),
    priceIds: Array.isArray(urlPrefill.priceIds) && urlPrefill.priceIds.length > 0
      ? urlPrefill.priceIds
      : (Array.isArray(serverPrefill.priceIds) ? serverPrefill.priceIds : []),
    specialists: Array.isArray(urlPrefill.specialists) && urlPrefill.specialists.length > 0
      ? urlPrefill.specialists
      : (Array.isArray(serverPrefill.specialists) ? serverPrefill.specialists : []),
    waNumbers: [],
    waMessages: [],
    approxTotal: 0,
    routing:
      String(urlPrefill.routing || serverPrefill.routing || "").trim().toLowerCase() === "general"
        ? "general"
        : undefined,
  };
  const noneSpecialistValue = "__none__";
  const normalizeSpecialistSlug = (value: string) => {
    const slug = String(value || "").trim();
    if (!slug || slug === noneSpecialistValue) return "";
    return slug;
  };
  const quoteLimit = Math.max(1, Number(config.quoteSelectionLimit || 6));
  const priceCatalog: CatalogRoute[] = Array.isArray(config.priceCatalog) ? config.priceCatalog : [];
  const serviceCatalog: CatalogRoute[] = Array.isArray(config.serviceCatalog) ? config.serviceCatalog : [];
  const initialPriceIds = Array.isArray(prefill.priceIds)
    ? prefill.priceIds.map((value: string) => String(value || "").trim()).slice(0, quoteLimit)
    : [];
  let selectedServicesState = Array.isArray(prefill.services) ? prefill.services.slice(0, quoteLimit) : [];
  if (initialPriceIds.length > 0) {
    selectedServicesState = selectedServicesState.length > 0
      ? selectedServicesState.map((serviceName: string, index: number) => {
          const trustedPrice = priceCatalog.find((row) => String(row.id || "") === initialPriceIds[index]);
          return trustedPrice?.title || serviceName;
        })
      : initialPriceIds
          .map((priceId: string) => priceCatalog.find((row) => String(row.id || "") === priceId)?.title || "")
          .filter(Boolean);
  }
  let selectedPriceIdsState = initialPriceIds;
  let selectedServicesSpecialistsState = Array.isArray(prefill.specialists)
    ? prefill.specialists
        .map((value: string) => normalizeSpecialistSlug(value))
        .slice(0, quoteLimit)
    : [];
  let selectedServicesWaNumbersState: string[] = [];
  let selectedServicesWaMessagesState: string[] = [];
  if (selectedPriceIdsState.length < selectedServicesState.length) {
    selectedPriceIdsState = [
      ...selectedPriceIdsState,
      ...Array(selectedServicesState.length - selectedPriceIdsState.length).fill(""),
    ];
  } else if (selectedPriceIdsState.length > selectedServicesState.length) {
    selectedPriceIdsState = selectedPriceIdsState.slice(0, selectedServicesState.length);
  }
  if (selectedServicesSpecialistsState.length < selectedServicesState.length) {
    selectedServicesSpecialistsState = [
      ...selectedServicesSpecialistsState,
      ...Array(selectedServicesState.length - selectedServicesSpecialistsState.length).fill(""),
    ];
  } else if (selectedServicesSpecialistsState.length > selectedServicesState.length) {
    selectedServicesSpecialistsState = selectedServicesSpecialistsState.slice(0, selectedServicesState.length);
  }
  if (selectedServicesWaNumbersState.length < selectedServicesState.length) {
    selectedServicesWaNumbersState = [
      ...selectedServicesWaNumbersState,
      ...Array(selectedServicesState.length - selectedServicesWaNumbersState.length).fill(""),
    ];
  } else if (selectedServicesWaNumbersState.length > selectedServicesState.length) {
    selectedServicesWaNumbersState = selectedServicesWaNumbersState.slice(0, selectedServicesState.length);
  }
  if (selectedServicesWaMessagesState.length < selectedServicesState.length) {
    selectedServicesWaMessagesState = [
      ...selectedServicesWaMessagesState,
      ...Array(selectedServicesState.length - selectedServicesWaMessagesState.length).fill(""),
    ];
  } else if (selectedServicesWaMessagesState.length > selectedServicesState.length) {
    selectedServicesWaMessagesState = selectedServicesWaMessagesState.slice(0, selectedServicesState.length);
  }
  if (
    selectedServicesState.length === 1 &&
    selectedServicesSpecialistsState.every((slug: string) => !slug) &&
    typeof prefill.specialist === "string" &&
    prefill.specialist.trim()
  ) {
    selectedServicesSpecialistsState[0] = prefill.specialist.trim();
  }
  let quoteTotalState = Number(prefill.approxTotal || 0);
  const specialistBySlug = new Map<string, SpecialistOption>();
  specialistItems.forEach((specialist) => {
    if (specialist.slug) specialistBySlug.set(specialist.slug, specialist);
  });
  const generalWaNumber = resolveWhatsAppNumber(config.generalWhatsappNumber);
  const specialistsWaNumber = resolveWhatsAppNumber(
    config.specialistsWhatsappNumber,
    generalWaNumber
  );
  const generalWhatsAppMessage = String(config.generalWhatsAppMessage || "").trim();
  const specialistsWhatsAppMessage = String(config.specialistsWhatsAppMessage || "").trim();
  const quickProblemDefault = String(config.quickProblemDefault || "").trim();
  const businessName = String(config.businessName || "FumiPro NC").trim();
  const pageText = config.pageText || {};
  const scheduleByDay: Record<number, { open: string; close: string } | null> = {
    0: null,
    1: { open: "10:00", close: "18:00" },
    2: { open: "10:00", close: "18:00" },
    3: { open: "10:00", close: "18:00" },
    4: { open: "10:00", close: "18:00" },
    5: { open: "10:00", close: "18:00" },
    6: { open: "10:00", close: "16:00" },
  };

  const setFieldErrorStyle = (input: HTMLElement, hasError: boolean) => {
    input.classList.remove("border-emerald-500", "ring-emerald-300", "dark:ring-emerald-500/40");
    input.classList.toggle("border-rose-500", hasError);
    input.classList.toggle("ring-1", hasError);
    input.classList.toggle("ring-rose-300", hasError);
    input.classList.toggle("dark:ring-rose-500/40", hasError);
  };

  const setFieldSuccessStyle = (input: HTMLElement, hasSuccess: boolean) => {
    input.classList.remove("border-rose-500", "ring-rose-300", "dark:ring-rose-500/40");
    input.classList.toggle("border-emerald-500", hasSuccess);
    input.classList.toggle("ring-1", hasSuccess);
    input.classList.toggle("ring-emerald-300", hasSuccess);
    input.classList.toggle("dark:ring-emerald-500/40", hasSuccess);
  };

  const validatePhoneField = () => {
    const hasValue = phoneInput.value.trim().length > 0;
    const valid = isValidPhoneInput(phoneInput.value || "");
    const hasError = hasValue && !valid;
    phoneInput.setCustomValidity(hasError ? "Ingresa un telefono valido." : "");
    setFieldErrorStyle(phoneInput, hasError);
    setFieldSuccessStyle(phoneInput, hasValue && valid);
    if (phoneError) phoneError.classList.toggle("hidden", !hasError);
    return valid;
  };

  const parseDisplayDateToIso = (displayDate: string) => {
    const value = String(displayDate || "").trim();
    if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return "";

    const [yyyy, mm, dd] = value.split("-").map((part) => Number(part));
    const day = Number(dd);
    const month = Number(mm);
    const year = Number(yyyy);

    if (!Number.isInteger(day) || !Number.isInteger(month) || !Number.isInteger(year)) return "";
    if (year < 1900 || year > 2100) return "";

    const iso = `${String(year).padStart(4, "0")}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    const date = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(date.getTime())) return "";

    const validDate =
      date.getFullYear() === year &&
      date.getMonth() + 1 === month &&
      date.getDate() === day;

    return validDate ? iso : "";
  };

  const today = new Date();
  const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
  dateInput.min = todayIso;

  const toMoneyMX = (value: number) =>
    new Intl.NumberFormat("es-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value || 0);

  const getMinPriceByCategory = (category: string): number => {
    const matches = priceCatalog
      .filter((row) => row.category === category)
      .map((row) => Number(row.priceFrom || 0))
      .filter((value) => value > 0);
    if (matches.length === 0) return 0;
    return Math.min(...matches);
  };

  const normalizeText = (value: string) =>
    String(value || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/\s+/g, " ")
      .trim();

  const findTrustedRouteForService = (serviceName: string, index: number = 0) => {
    const priceId = String(selectedPriceIdsState[index] || "").trim();
    const title = normalizeText(serviceName);
    const selectedCategory = normalizeServiceSlug(String(serviceSelect.value || ""));

    if (priceId) {
      const byId = priceCatalog.find((row) => String(row.id || "") === priceId);
      if (byId && (!title || normalizeText(byId.title) === title)) return byId;
    }

    const byPriceTitle = priceCatalog.find((row) => {
      if (!row.title || normalizeText(row.title) !== title) return false;
      return !selectedCategory || !row.category || row.category === selectedCategory;
    });
    if (byPriceTitle) return byPriceTitle;

    const byServiceTitle = serviceCatalog.find((row) => {
      if (!row.title || normalizeText(row.title) !== title) return false;
      return !selectedCategory || !row.category || row.category === selectedCategory;
    });
    if (byServiceTitle) return byServiceTitle;

    return undefined;
  };

  const categoryByServiceTitle = new Map<string, string>();
  priceCatalog.forEach((row) => {
    const title = normalizeText(row.title || "");
    const category = normalizeServiceSlug(row.category || "");
    if (!title || !category || categoryByServiceTitle.has(title)) return;
    categoryByServiceTitle.set(title, category);
  });

  const getCategoryForService = (serviceName: string, index: number = 0) => {
    const trustedRoute = findTrustedRouteForService(serviceName, index);
    if (trustedRoute?.category) return trustedRoute.category;
    const byCatalog = categoryByServiceTitle.get(normalizeText(serviceName));
    if (byCatalog) return byCatalog;
    return normalizeServiceSlug(String(serviceSelect.value || serviceName || "").trim());
  };

  const getQuoteCategoryKeys = (services: string[]) => {
    const unique = new Set<string>();
    services.forEach((serviceName, index) => {
      const categoryKey = getCategoryForService(serviceName, index);
      if (categoryKey) unique.add(categoryKey);
    });
    return Array.from(unique.values());
  };

  const getCategoryLabel = (categoryKey: string) => {
    const match = Array.from(serviceSelect.options).find(
      (opt: HTMLOptionElement) => String(opt.value || "").trim() === categoryKey
    );
    return String(match?.textContent || categoryKey).trim();
  };

  const hasServiceOption = (categoryKey: string) =>
    Array.from(serviceSelect.options).some(
      (opt: HTMLOptionElement) => String(opt.value || "").trim() === categoryKey
    );

  const getApproxTotalFromSelectedServices = (services: string[]) =>
    services.reduce((sum, serviceName, index) => {
      const match = findTrustedRouteForService(serviceName, index);
      const price = Number(match?.priceFrom || 0);
      return sum + (Number.isFinite(price) && price > 0 ? price : 0);
    }, 0);

  type QuoteSnapshot = {
    selectedServices: string[];
    selectedPriceIds: string[];
    selectedSpecialists: string[];
    selectedWaNumbers: string[];
    selectedWaMessages: string[];
    quoteTotal: number;
    serviceValue: string;
    specialistValue: string;
  };

  let lastQuoteSnapshot: QuoteSnapshot | null = null;

  const setRestoreButtonVisible = (visible: boolean) => {
    if (!restoreQuoteBtn) return;
    restoreQuoteBtn.classList.toggle("hidden", !visible);
  };

  const clearQuoteSnapshot = () => {
    lastQuoteSnapshot = null;
    setRestoreButtonVisible(false);
  };

  const captureQuoteSnapshot = (): QuoteSnapshot => ({
    selectedServices: [...selectedServicesState],
    selectedPriceIds: [...selectedPriceIdsState],
    selectedSpecialists: [...selectedServicesSpecialistsState],
    selectedWaNumbers: [...selectedServicesWaNumbersState],
    selectedWaMessages: [...selectedServicesWaMessagesState],
    quoteTotal: Number(quoteTotalState || 0),
    serviceValue: String(serviceSelect.value || ""),
    specialistValue: String(specialistSelect.value || ""),
  });

  const restoreQuoteSnapshot = () => {
    if (!lastQuoteSnapshot) return;

    selectedServicesState = [...lastQuoteSnapshot.selectedServices];
    selectedPriceIdsState = [...lastQuoteSnapshot.selectedPriceIds];
    selectedServicesSpecialistsState = [...lastQuoteSnapshot.selectedSpecialists];
    selectedServicesWaNumbersState = [...lastQuoteSnapshot.selectedWaNumbers];
    selectedServicesWaMessagesState = [...lastQuoteSnapshot.selectedWaMessages];
    quoteTotalState = Number(lastQuoteSnapshot.quoteTotal || 0);

    if (lastQuoteSnapshot.serviceValue && hasServiceOption(lastQuoteSnapshot.serviceValue)) {
      serviceSelect.value = lastQuoteSnapshot.serviceValue;
    } else {
      const categoryKeys = getQuoteCategoryKeys(selectedServicesState);
      const fallbackCategory = categoryKeys.find((key) => hasServiceOption(key)) || "";
      serviceSelect.value = fallbackCategory;
    }

    const preferredSpecialist =
      selectedServicesState.length <= 1 ? String(lastQuoteSnapshot.specialistValue || "").trim() : "";
    renderSpecialists(serviceSelect.value, preferredSpecialist);

    if (selectedServicesState.length > 1) {
      specialistSelect.value = "";
    }

    clearQuoteSnapshot();
    updateQuoteSummary();
    updateCta();
  };

  const removeCategoryFromQuote = (categoryKey: string) => {
    const key = String(categoryKey || "").trim();
    if (!key || selectedServicesState.length === 0) return;

    const keepIndexes: number[] = [];
    selectedServicesState.forEach((serviceName, index) => {
      if (getCategoryForService(serviceName, index) !== key) keepIndexes.push(index);
    });

    if (keepIndexes.length === selectedServicesState.length) return;

    lastQuoteSnapshot = captureQuoteSnapshot();
    setRestoreButtonVisible(true);

    selectedServicesState = keepIndexes.map((index) => selectedServicesState[index]);
    selectedPriceIdsState = keepIndexes.map((index) => selectedPriceIdsState[index] || "");
    selectedServicesSpecialistsState = keepIndexes.map(
      (index) => selectedServicesSpecialistsState[index] || ""
    );
    selectedServicesWaNumbersState = keepIndexes.map(
      (index) => selectedServicesWaNumbersState[index] || ""
    );
    selectedServicesWaMessagesState = keepIndexes.map(
      (index) => selectedServicesWaMessagesState[index] || ""
    );
    quoteTotalState = getApproxTotalFromSelectedServices(selectedServicesState);

    const remainingCategoryKeys = getQuoteCategoryKeys(selectedServicesState);
    if (remainingCategoryKeys.length === 1 && hasServiceOption(remainingCategoryKeys[0])) {
      serviceSelect.value = remainingCategoryKeys[0];
      renderSpecialists(serviceSelect.value, "");
    } else if (remainingCategoryKeys.length === 0) {
      serviceSelect.value = "";
      renderSpecialists("", "");
    } else {
      specialistSelect.value = "";
    }

    if (selectedServicesState.length !== 1) {
      specialistSelect.value = "";
    }

    updateQuoteSummary();
    updateCta();
  };

  const getCurrentQuote = () => {
    const selectedCategory = String(serviceSelect.value || "");
    const selectedLabel = selectedCategory
      ? (serviceSelect.options[serviceSelect.selectedIndex]?.text || "")
      : "";
    const hasSelectedSpecialist = Boolean(String(specialistSelect.value || "").trim());
    const list = selectedServicesState.length > 0
      ? selectedServicesState
      : (selectedLabel ? [selectedLabel] : []);

    const catalogTotal = getApproxTotalFromSelectedServices(list);
    let total = catalogTotal > 0 ? catalogTotal : 0;
    if (total <= 0 && Number.isFinite(quoteTotalState) && quoteTotalState > 0) {
      total = quoteTotalState;
    }
    if (total <= 0 && selectedCategory && !hasSelectedSpecialist) {
      total = getMinPriceByCategory(selectedCategory);
    }

    return { list, total };
  };

  const getQuoteServiceSpecialists = () => {
    const { list } = getCurrentQuote();
    return list.map((serviceName: string, index: number) => {
      const trustedRoute = findTrustedRouteForService(serviceName, index);
      const specialistSlug = normalizeSpecialistSlug(
        selectedServicesSpecialistsState[index] || trustedRoute?.specialist || ""
      );
      const waNumber = resolveWhatsAppNumber(trustedRoute?.waNumber || "");
      const waMessage = String(trustedRoute?.waMessage || "").trim();
      const specialist = specialistSlug ? specialistBySlug.get(specialistSlug) : undefined;
      return {
        service: serviceName,
        specialistSlug,
        specialistName: specialist?.name || "",
        waNumber,
        waMessage,
        specialist: specialist || undefined,
      };
    });
  };

  const getQuoteUniqueSpecialists = () => {
    const pairs = getQuoteServiceSpecialists();
    const unique = new Map<string, SpecialistOption>();
    pairs.forEach((pair) => {
      if (!pair.specialistSlug || !pair.specialist) return;
      if (!unique.has(pair.specialistSlug)) unique.set(pair.specialistSlug, pair.specialist);
    });
    return Array.from(unique.values());
  };

  const getQuoteUniqueWaNumbers = () => {
    const pairs = getQuoteServiceSpecialists();
    const unique = new Set<string>();
    pairs.forEach((pair) => {
      const number = resolveWhatsAppNumber(pair.waNumber || "");
      if (number) unique.add(number);
    });
    return Array.from(unique.values());
  };

  const getQuoteUniqueWaMessages = () => {
    const pairs = getQuoteServiceSpecialists();
    const unique = new Set<string>();
    pairs.forEach((pair) => {
      const message = String(pair.waMessage || "").trim();
      if (message) unique.add(message);
    });
    return Array.from(unique.values());
  };

  const updateQuoteSummary = () => {
    const { list, total } = getCurrentQuote();
    const selectedServiceLabel = String(serviceSelect.value || "").trim()
      ? (serviceSelect.options[serviceSelect.selectedIndex]?.text || "")
      : "";
    const specialistSlug = String(specialistSelect.value || "").trim();
    const selectedSpecialist = specialistSlug
      ? specialistItems.find((sp: SpecialistOption) => sp.slug === specialistSlug)
      : undefined;
    const uniqueQuoteSpecialists = getQuoteUniqueSpecialists();
    const uniqueQuoteWaNumbers = getQuoteUniqueWaNumbers();
    const quoteHasMultipleServices = list.length > 1;
    const quoteCategoryKeys = getQuoteCategoryKeys(list);
    const hasMixedCategories = quoteCategoryKeys.length > 1;
    const hasMultipleRoutingTargets =
      uniqueQuoteSpecialists.length > 1 || uniqueQuoteWaNumbers.length > 1;
    const forceGeneralRouting =
      hasMixedCategories ||
      prefill.routing === "general" ||
      (quoteHasMultipleServices && hasMultipleRoutingTargets);
    const singleCategoryLabel = quoteCategoryKeys.length === 1 ? getCategoryLabel(quoteCategoryKeys[0]) : "";
    const categoryLabels = quoteCategoryKeys.map((categoryKey) => getCategoryLabel(categoryKey));
    const routingSpecialist = forceGeneralRouting
      ? undefined
      : selectedSpecialist || (uniqueQuoteSpecialists.length === 1 ? uniqueQuoteSpecialists[0] : undefined);

    if (contextBadgeEl) {
      if (forceGeneralRouting) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = hasMixedCategories
          ? "Tu solicitud se enviará al WhatsApp general de la clínica."
          : "Tu solicitud se enviará al WhatsApp general.";
      } else if (routingSpecialist) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = `Especialista sugerido: ${routingSpecialist.name || "Especialista"}`;
      } else if (quoteHasMultipleServices && singleCategoryLabel) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = `Solicitud para varios servicios de ${singleCategoryLabel}.`;
      } else if (uniqueQuoteSpecialists.length > 1) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = `Incluye varios especialistas: ${uniqueQuoteSpecialists
          .map((specialist) => specialist.name || "Especialista")
          .join(" · ")}`;
      } else if (uniqueQuoteSpecialists.length === 1) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = `Especialista sugerido: ${uniqueQuoteSpecialists[0].name || "Especialista"}`;
      } else if (selectedServiceLabel) {
        contextBadgeEl.classList.remove("hidden");
        contextBadgeEl.textContent = `Servicio seleccionado: ${selectedServiceLabel}`;
      } else {
        contextBadgeEl.classList.add("hidden");
      }
    }

    if (quoteRoutingTargetEl) {
      if (forceGeneralRouting) {
        quoteRoutingTargetEl.classList.remove("hidden");
        quoteRoutingTargetEl.textContent = "Se enviará al WhatsApp general.";
      } else if (routingSpecialist?.name) {
        quoteRoutingTargetEl.classList.remove("hidden");
        quoteRoutingTargetEl.textContent = `Se enviará al WhatsApp de ${routingSpecialist.name}.`;
      } else if (uniqueQuoteWaNumbers.length === 1) {
        quoteRoutingTargetEl.classList.remove("hidden");
        quoteRoutingTargetEl.textContent = "Se enviará al WhatsApp del servicio seleccionado.";
      } else {
        quoteRoutingTargetEl.classList.add("hidden");
        quoteRoutingTargetEl.textContent = "";
      }
    }

    if (quoteServicesEl) {
      const pairs = getQuoteServiceSpecialists();
      const hasSpecialistsInPairs = pairs.some((pair) => Boolean(pair.specialistName));
      quoteServicesEl.textContent = list.length > 0
        ? (hasSpecialistsInPairs
          ? pairs
              .map((pair) =>
                pair.specialistName ? `${pair.service} (${pair.specialistName})` : pair.service
              )
              .join(" · ")
          : list.join(" · "))
        : String(pageText.summaryEmptyStateText || "Selecciona un servicio y te mostramos un precio aproximado.");
    }

    if (quoteTotalEl) {
      if (total > 0) {
        quoteTotalEl.classList.remove("hidden");
        quoteTotalEl.innerHTML = `<span class="font-semibold">${String(pageText.summaryTotalLabel || "Total aproximado:")}</span> ${toMoneyMX(total)}`;
      } else {
        quoteTotalEl.classList.add("hidden");
      }
    }

    if (quoteCategoriesWrapEl && quoteCategoriesEl) {
      quoteCategoriesEl.innerHTML = "";
      if (hasMixedCategories && categoryLabels.length > 0) {
        quoteCategoriesWrapEl.classList.remove("hidden");
        quoteCategoryKeys.forEach((categoryKey, index) => {
          const label = categoryLabels[index] || getCategoryLabel(categoryKey);
          const chip = document.createElement("button");
          chip.type = "button";
          chip.dataset.quoteCategoryChip = categoryKey;
          chip.className = "category-chip category-chip--active";
          chip.textContent = `${label} x`;
          chip.setAttribute("aria-label", `Quitar categoría ${label} de la cotización`);
          quoteCategoriesEl.appendChild(chip);
        });
      } else {
        quoteCategoriesWrapEl.classList.add("hidden");
      }
    }
  };

  const buildTimeSlots = (open: string, close: string): string[] => {
    const [openH, openM] = open.split(":").map((x) => Number(x));
    const [closeH, closeM] = close.split(":").map((x) => Number(x));
    const start = openH * 60 + openM;
    const end = closeH * 60 + closeM;
    const slots: string[] = [];
    for (let minutes = start; minutes < end; minutes += 30) {
      const h = String(Math.floor(minutes / 60)).padStart(2, "0");
      const m = String(minutes % 60).padStart(2, "0");
      slots.push(`${h}:${m}`);
    }
    return slots;
  };

  const updateTimeLimitsByDate = () => {
    const previousValue = timeSlotSelect.value;
    const isoDate = parseDisplayDateToIso(dateInput.value);
    timeSlotSelect.innerHTML = "";
    const baseOption = document.createElement("option");
    baseOption.value = "";
    baseOption.textContent = "Selecciona hora";
    timeSlotSelect.appendChild(baseOption);

    if (!dateInput.value) {
      timeSlotSelect.disabled = true;
      if (timeHelp) {
        timeHelp.textContent = "Si prefieres, deja la fecha por definir o usa el turno.";
        timeHelp.classList.remove("text-rose-600", "dark:text-rose-400");
        timeHelp.classList.add("text-slate-500", "dark:text-slate-400");
      }
      return;
    }

    if (!isoDate) {
      timeSlotSelect.disabled = true;
      if (timeHelp) {
        timeHelp.textContent = "Selecciona una fecha válida para habilitar horarios.";
        timeHelp.classList.remove("text-slate-500", "dark:text-slate-400");
        timeHelp.classList.add("text-rose-600", "dark:text-rose-400");
      }
      return;
    }

    const date = new Date(`${isoDate}T12:00:00`);
    const day = date.getDay();
    const schedule = scheduleByDay[day];

    if (!schedule) {
      timeSlotSelect.disabled = true;
      if (timeHelp) {
        timeHelp.textContent = "Domingo cerrado. Selecciona otro día.";
        timeHelp.classList.remove("text-slate-500", "dark:text-slate-400");
        timeHelp.classList.add("text-rose-600", "dark:text-rose-400");
      }
      return;
    }

    const slots = buildTimeSlots(schedule.open, schedule.close);
    slots.forEach((slot) => {
      const option = document.createElement("option");
      option.value = slot;
      option.textContent = slot;
      timeSlotSelect.appendChild(option);
    });
    timeSlotSelect.disabled = false;

    if (slots.includes(previousValue)) {
      timeSlotSelect.value = previousValue;
    } else {
      timeSlotSelect.value = "";
    }

    if (timeHelp) {
      timeHelp.textContent = `Horario disponible: ${schedule.open} a ${schedule.close}.`;
      timeHelp.classList.remove("text-rose-600", "dark:text-rose-400");
      timeHelp.classList.add("text-slate-500", "dark:text-slate-400");
    }
  };

  const renderSpecialists = (serviceKey: string, preferredSpecialist: string = "") => {
    const filtered = specialistItems.filter((sp: SpecialistOption) => sp.category === serviceKey);
    specialistSelect.innerHTML = "";

    const baseOption = document.createElement("option");
    baseOption.value = "";
    baseOption.textContent = "Sin preferencia (el que esté disponible)";
    specialistSelect.appendChild(baseOption);

    filtered.forEach((sp: SpecialistOption) => {
      const opt = document.createElement("option");
      opt.value = sp.slug;
      opt.textContent = sp.name;
      specialistSelect.appendChild(opt);
    });

    specialistSelect.disabled = !serviceKey;
    if (preferredSpecialist && filtered.some((sp: SpecialistOption) => sp.slug === preferredSpecialist)) {
      specialistSelect.value = preferredSpecialist;
    } else {
      specialistSelect.value = "";
    }
  };

  const applyPrefill = () => {
    let serviceValue = "";
    if (prefill.service) {
      const matchService = Array.from(serviceSelect.options).find(
        (opt: HTMLOptionElement) => opt.value === prefill.service
      );
      if (matchService) serviceValue = prefill.service;
    }

    if (!serviceValue && selectedServicesState.length > 0) {
      const firstSelected = normalizeText(selectedServicesState[0] || "");
      const fromCatalog = priceCatalog.find((row) => {
        const title = normalizeText(row.title || "");
        const category = String(row.category || "").trim();
        return Boolean(title) && Boolean(category) && title === firstSelected;
      });
      if (fromCatalog?.category) {
        const existsInSelect = Array.from(serviceSelect.options).some(
          (opt: HTMLOptionElement) => opt.value === fromCatalog.category
        );
        if (existsInSelect) serviceValue = fromCatalog.category;
      }
    }

    if (!serviceValue && prefill.specialist) {
      const specialistMatch = specialistItems.find((sp: SpecialistOption) => sp.slug === prefill.specialist);
      if (specialistMatch?.category) serviceValue = specialistMatch.category;
    }

    if (serviceValue) {
      serviceSelect.value = serviceValue;
    }

    const shouldPrefillSpecialist =
      selectedServicesState.length <= 1 ? String(prefill.specialist || "").trim() : "";
    renderSpecialists(serviceSelect.value, shouldPrefillSpecialist);
  };

  const updateDatePreview = () => {
    if (!dateReadable) return;
    const isoDate = parseDisplayDateToIso(dateInput.value);
    if (!dateInput.value) {
      dateReadable.textContent = "Si no eliges fecha, se enviara como por definir.";
      dateReadable.classList.remove("text-emerald-600", "dark:text-emerald-400", "text-rose-600", "dark:text-rose-400");
      dateReadable.classList.add("text-slate-500", "dark:text-slate-400");
      return;
    }

    if (isoDate) {
      dateReadable.textContent = `Fecha seleccionada: ${formatDateMX(isoDate)}`;
      dateReadable.classList.remove("text-slate-500", "dark:text-slate-400", "text-rose-600", "dark:text-rose-400");
      dateReadable.classList.add("text-emerald-600", "dark:text-emerald-400");
      return;
    }

    dateReadable.textContent = "Selecciona una fecha válida en el calendario.";
    dateReadable.classList.remove("text-slate-500", "dark:text-slate-400", "text-emerald-600", "dark:text-emerald-400");
    dateReadable.classList.add("text-rose-600", "dark:text-rose-400");
  };

  const validateSchedule = () => {
    const isoDate = parseDisplayDateToIso(dateInput.value);
    dateInput.setCustomValidity("");
    timeSlotSelect.setCustomValidity("");
    setFieldErrorStyle(dateInput, false);
    setFieldSuccessStyle(dateInput, false);
    setFieldErrorStyle(timeSlotSelect, false);
    const selectedTime = timeSlotSelect.value;

    if (dateError) dateError.classList.add("hidden");

    if (dateInput.value && !isoDate) {
      dateInput.setCustomValidity("Selecciona una fecha válida.");
      setFieldErrorStyle(dateInput, true);
      if (dateError) {
        dateError.textContent = "Selecciona una fecha válida.";
        dateError.classList.remove("hidden");
      }
      return false;
    }

    if (isoDate && isoDate < todayIso) {
      dateInput.setCustomValidity("No puedes elegir una fecha pasada.");
      setFieldErrorStyle(dateInput, true);
      if (dateError) {
        dateError.textContent = "No puedes elegir una fecha pasada.";
        dateError.classList.remove("hidden");
      }
      return false;
    }

    if (isoDate && isSunday(isoDate)) {
      dateInput.setCustomValidity("Los domingos no hay atención.");
      setFieldErrorStyle(dateInput, true);
      if (dateError) {
        dateError.textContent = "Domingo cerrado. Elige otro día.";
        dateError.classList.remove("hidden");
      }
      return false;
    }

    if (isoDate) {
      setFieldSuccessStyle(dateInput, true);
    }

    if (selectedTime && !isoDate) {
      dateInput.setCustomValidity("Selecciona fecha para validar la hora.");
      setFieldErrorStyle(dateInput, true);
      if (dateError) {
        dateError.textContent = "Selecciona una fecha válida para usar hora exacta.";
        dateError.classList.remove("hidden");
      }
      return false;
    }

    if (isoDate && selectedTime && !isWithinSchedule(isoDate, selectedTime)) {
      timeSlotSelect.setCustomValidity("La hora está fuera de horario para ese día.");
      setFieldErrorStyle(timeSlotSelect, true);
      return false;
    }

    if (dateError) {
      dateError.textContent = "Selecciona una fecha válida.";
      dateError.classList.add("hidden");
    }

    return true;
  };

  const openOptionalPanel = () => {
    if (optionalDetails && !optionalDetails.open) {
      optionalDetails.open = true;
    }
  };

  const focusFirstInvalidField = () => {
    const orderedFields = [serviceSelect, nameInput, phoneInput, dateInput, timeSlotSelect];
    const firstInvalid = orderedFields.find((field) => field && !field.checkValidity());
    if (!firstInvalid) return;
    if (firstInvalid === dateInput || firstInvalid === timeSlotSelect) {
      openOptionalPanel();
    }
    firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
    window.setTimeout(() => firstInvalid.focus(), 90);
  };

  const setDisabledCta = (text: string) => {
    sendBtn.classList.remove("pointer-events-none", "btn-muted");
    sendBtn.classList.add("btn-primary");
    sendBtn.textContent = text;
    sendBtn.setAttribute("href", "#appointment-form");
    sendBtn.setAttribute("data-cta-state", "invalid");
    sendBtn.setAttribute("role", "button");
    sendBtn.removeAttribute("target");
    sendBtn.removeAttribute("rel");
  };

  const setEnabledCta = (href: string) => {
    sendBtn.classList.remove("pointer-events-none", "btn-muted");
    sendBtn.classList.add("btn-primary");
    sendBtn.textContent = "Enviar solicitud por WhatsApp";
    sendBtn.setAttribute("href", href);
    sendBtn.setAttribute("data-cta-state", "ready");
    sendBtn.setAttribute("target", "_blank");
    sendBtn.setAttribute("rel", "noopener noreferrer");
  };

  const updateCta = () => {
    validatePhoneField();
    updateTimeLimitsByDate();
    updateDatePreview();

    if (!validateSchedule()) {
      setDisabledCta("Completa tus datos para continuar por WhatsApp");
      return;
    }

    const name = String(nameInput.value || "").trim();
    const phone = sanitizePhone(String(phoneInput.value || ""));
    const service = String(serviceSelect.value || "").trim();

    if (!name || !service || !isValidPhoneInput(phoneInput.value || "") || !isValidPhone(phone)) {
      setDisabledCta("Completa tus datos para continuar por WhatsApp");
      return;
    }

    const specialistValue = String(specialistSelect.value || "").trim();
    const selectedSpecialist = specialistValue
      ? specialistItems.find((sp: SpecialistOption) => sp.slug === specialistValue)
      : undefined;
    const quote = getCurrentQuote();
    const quotePairs = getQuoteServiceSpecialists();
    const quoteSpecialists = getQuoteUniqueSpecialists();
    const quoteWaNumbers = getQuoteUniqueWaNumbers();
    const quoteWaMessages = getQuoteUniqueWaMessages();
    const quoteHasMultipleServices = quote.list.length > 1;
    const quoteCategoryKeys = getQuoteCategoryKeys(quote.list);
    const hasMixedCategories = quoteCategoryKeys.length > 1;
    const hasMultipleRoutingTargets =
      quoteSpecialists.length > 1 || quoteWaNumbers.length > 1;
    const forceGeneralRouting =
      hasMixedCategories ||
      prefill.routing === "general" ||
      (quoteHasMultipleServices && hasMultipleRoutingTargets);
    const routingSpecialist = forceGeneralRouting
      ? undefined
      : selectedSpecialist ||
        (quoteSpecialists.length === 1 ? quoteSpecialists[0] : undefined);
    const selectedServiceLabel = serviceSelect.options[serviceSelect.selectedIndex]?.text || service;
    const effectiveServiceLabel = quoteHasMultipleServices
      ? "Variados"
      : (selectedServiceLabel || service);
    const specialistName = selectedSpecialist
      ? selectedSpecialist.name || "Especialista"
      : forceGeneralRouting
        ? quoteSpecialists.length > 1
          ? "Múltiples especialistas"
          : hasMixedCategories
            ? "Sin preferencia (múltiples servicios)"
            : "Sin preferencia (enrutamiento general)"
      : quoteSpecialists.length > 1
        ? "Múltiples especialistas"
        : routingSpecialist?.name || "Sin preferencia";
    const targetWaNumber = forceGeneralRouting
      ? resolveWhatsAppNumber(generalWaNumber)
      : routingSpecialist
      ? resolveWhatsAppNumber(
          routingSpecialist?.whatsAppNumber,
          specialistsWaNumber,
          generalWaNumber
        )
      : resolveWhatsAppNumber(
          quoteWaNumbers.length === 1 ? quoteWaNumbers[0] : "",
          generalWaNumber
        );

    if (!targetWaNumber) {
      setDisabledCta("WhatsApp no configurado");
      return;
    }

    const notesValue = String(notesInput.value || "").trim();
    const problemValue = notesValue || quickProblemDefault || "Por definir";
    const introTemplate = forceGeneralRouting
      ? generalWhatsAppMessage
      : routingSpecialist
      ? (routingSpecialist?.whatsAppMessage || specialistsWhatsAppMessage || generalWhatsAppMessage)
      : (quoteWaMessages.length === 1 ? quoteWaMessages[0] : "") ||
        generalWhatsAppMessage;
    const introMessage = resolveWhatsAppReason(
      introTemplate,
      routingSpecialist
        ? "Hola, quiero solicitar servicio con {especialista} en {negocio}."
        : quoteSpecialists.length > 1
          ? "Hola, quiero solicitar varios servicios de fumigacion en {negocio}."
          : "Hola, quiero solicitar un servicio de fumigacion en {negocio}.",
      {
        specialist: specialistName,
        service: effectiveServiceLabel,
        business: businessName,
        problem: problemValue,
      }
    );

    const message = buildAppointmentMessage({
      introMessage,
      name,
      phone,
      service: effectiveServiceLabel,
      selectedServices: quote.list,
      serviceSpecialists: quotePairs
        .filter((pair) => pair.specialistName)
        .map((pair) => ({ service: pair.service, specialist: pair.specialistName })),
      approxTotal: quote.total > 0 ? quote.total : undefined,
      specialist: specialistName,
      date: parseDisplayDateToIso(dateInput.value) || undefined,
      time: timeSlotSelect.value || undefined,
      shift: String(shiftSelect.value || "") || undefined,
      notes: notesValue || undefined,
    });

    const href = buildWhatsAppUrl(message, targetWaNumber);
    setEnabledCta(href);
  };

  const revealOptionalPanelIfNeeded = () => {
    const hasOptionalValue =
      Boolean(String(specialistSelect.value || "").trim()) ||
      Boolean(String(dateInput.value || "").trim()) ||
      Boolean(String(timeSlotSelect.value || "").trim()) ||
      Boolean(String(shiftSelect.value || "").trim()) ||
      Boolean(String(notesInput.value || "").trim());
    if (hasOptionalValue) openOptionalPanel();
  };

  form.reset();
  applyPrefill();
  revealOptionalPanelIfNeeded();
  updateTimeLimitsByDate();
  updateDatePreview();
  updateQuoteSummary();
  updateCta();

  serviceSelect.addEventListener("change", () => {
    clearQuoteSnapshot();
    const selectedLabel = serviceSelect.options[serviceSelect.selectedIndex]?.text || "";
    selectedServicesState = selectedLabel ? [selectedLabel] : [];
    selectedPriceIdsState = [""];
    selectedServicesSpecialistsState = [""];
    selectedServicesWaNumbersState = [""];
    selectedServicesWaMessagesState = [""];
    quoteTotalState = 0;
    renderSpecialists(serviceSelect.value, "");
    updateQuoteSummary();
    updateCta();
  });

  specialistSelect.addEventListener("change", () => {
    if (selectedServicesState.length <= 1) {
      selectedServicesSpecialistsState = [String(specialistSelect.value || "").trim()];
    }
    revealOptionalPanelIfNeeded();
    updateQuoteSummary();
    updateCta();
  });

  if (quoteCategoriesEl) {
    quoteCategoriesEl.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest("[data-quote-category-chip]") as HTMLButtonElement | null;
      if (!button) return;
      const categoryKey = String(button.dataset.quoteCategoryChip || "").trim();
      removeCategoryFromQuote(categoryKey);
    });
  }

  restoreQuoteBtn?.addEventListener("click", () => {
    restoreQuoteSnapshot();
  });

  [nameInput, phoneInput].forEach((el) => {
    el.addEventListener("input", updateCta);
    el.addEventListener("change", updateCta);
  });

  [specialistSelect, timeSlotSelect, notesInput].forEach((el) => {
    el.addEventListener("input", () => {
      revealOptionalPanelIfNeeded();
      updateCta();
    });
    el.addEventListener("change", () => {
      revealOptionalPanelIfNeeded();
      updateCta();
    });
  });

  dateInput.addEventListener("input", () => {
    revealOptionalPanelIfNeeded();
    updateCta();
  });

  dateInput.addEventListener("change", () => {
    revealOptionalPanelIfNeeded();
    updateTimeLimitsByDate();
    updateCta();
  });

  shiftSelect.addEventListener("change", () => {
    if (shiftSelect.value && timeSlotSelect.value) {
      timeSlotSelect.value = "";
    }
    revealOptionalPanelIfNeeded();
    updateCta();
  });

  sendBtn.addEventListener("click", (event) => {
    updateCta();
    if (sendBtn.getAttribute("data-cta-state") === "ready") return;

    event.preventDefault();
    const scheduleValid = validateSchedule();
    const formValid = form.reportValidity();
    if (!scheduleValid) openOptionalPanel();
    if (!formValid || !scheduleValid) {
      focusFirstInvalidField();
    }
  });
</script>

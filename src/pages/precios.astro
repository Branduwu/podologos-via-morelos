---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getBusinessInfo, getPrices } from "../lib/sanity.js";
import { clinic } from "../config/clinic";
import { normalizeCategory } from "../utils/category";

type PriceRow = {
  _id?: string;
  serviceTitle?: string;
  category?: string;
  leadSpecialistSlug?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  priceFrom?: number;
  duration?: string;
  note?: string;
};

const business = await getBusinessInfo();
const prices: PriceRow[] = (await getPrices()) || [];
const quoteSelectionLimit = Math.max(1, Number(clinic.quoteSelectionLimit || 6));
const noneSpecialistValue = "__none__";

const priceCategories = [
  { key: "all", label: "Todas" },
  { key: "roedores", label: "Roedores" },
  { key: "cucarachas", label: "Cucarachas" },
  { key: "termitas", label: "Termitas" },
  { key: "chinches", label: "Chinches" },
  { key: "hormigas", label: "Hormigas" },
  { key: "avispas", label: "Avispas" },
  { key: "inspeccion", label: "Inspección" },
  { key: "general", label: "General" },
];
const priceCategoryLabelByKey = new Map(priceCategories.map((item) => [item.key, item.label]));

function applyTemplate(value: string | null | undefined, replacements: Record<string, string | number>) {
  let resolved = String(value || "");
  Object.entries(replacements).forEach(([key, replacement]) => {
    resolved = resolved.replaceAll(`{${key}}`, String(replacement));
  });
  return resolved;
}

function priceCategoryKey(price: PriceRow) {
  const fromCms = normalizeCategory(price.category || "");
  if (["roedores", "cucarachas", "termitas", "chinches", "hormigas", "avispas", "inspeccion", "general"].includes(fromCms)) return fromCms;
  const text = normalizeCategory(`${price.serviceTitle || ""} ${price.note || ""}`);
  if (!text) return "general";
  if (text.includes("roed") || text.includes("rata") || text.includes("raton")) return "roedores";
  if (text.includes("cucar")) return "cucarachas";
  if (text.includes("termit")) return "termitas";
  if (text.includes("chinch")) return "chinches";
  if (text.includes("hormig")) return "hormigas";
  if (text.includes("avispa") || text.includes("abeja")) return "avispas";
  if (text.includes("inspec")) return "inspeccion";
  return "general";
}

const priceCategoryCount =
  new Set(prices.map((price) => priceCategoryKey(price)).filter((key) => key && key !== "general")).size ||
  Math.max(1, priceCategories.length - 1);
const pricesPageContent = business?.pricesPageContent || {};
const pricesPageText = {
  eyebrow: String(pricesPageContent.eyebrow || "Cotizacion y servicio").trim(),
  title: String(pricesPageContent.title || "Precios de fumigación").trim(),
  intro: String(
    pricesPageContent.intro ||
      "Revisa los precios de cada tratamiento y compara opciones. Si necesitas varios servicios, inclúyelos en una sola cotización por WhatsApp."
  ).trim(),
  primaryCtaText: String(pricesPageContent.primaryCtaText || "Solicitar inspección").trim(),
  primaryCtaUrl: String(pricesPageContent.primaryCtaUrl || "/agendar").trim(),
  secondaryCtaText: String(pricesPageContent.secondaryCtaText || "Ver servicios").trim(),
  secondaryCtaUrl: String(pricesPageContent.secondaryCtaUrl || "/servicios").trim(),
  panelLabel: String(pricesPageContent.panelLabel || "Antes de decidir").trim(),
  stepOneTitle: String(pricesPageContent.stepOneTitle || "Elige tu tratamiento").trim(),
  stepOneBody: String(
    pricesPageContent.stepOneBody || "Así puedes estimar el costo antes de contactarnos."
  ).trim(),
  stepTwoTitle: String(pricesPageContent.stepTwoTitle || "Combina tratamientos").trim(),
  stepTwoBody: String(
    pricesPageContent.stepTwoBody || "Si necesitas tratar varias plagas, inclúyelas en un mensaje y te hacemos una cotización completa."
  ).trim(),
  pricesCountLabel: String(pricesPageContent.pricesCountLabel || "tratamientos con precio").trim(),
  areasCountLabel: String(pricesPageContent.areasCountLabel || "tipos de plaga").trim(),
  emptyStateText: String(pricesPageContent.emptyStateText || "Aun no tenemos precios publicados.").trim(),
  filterLabel: String(pricesPageContent.filterLabel || "Elige un area").trim(),
  quoteTitle: String(pricesPageContent.quoteTitle || "Tu cotizacion").trim(),
  quoteSingleActionLabel: String(pricesPageContent.quoteSingleActionLabel || "Agendar solo este").trim(),
  quoteSingleActionHelp: String(pricesPageContent.quoteSingleActionHelp || "envia un solo servicio.").trim(),
  quoteAddActionLabel: String(pricesPageContent.quoteAddActionLabel || "Agregar a cotizacion").trim(),
  quoteAddActionHelp: String(
    pricesPageContent.quoteAddActionHelp || "guarda varios para mandarlos en un solo mensaje."
  ).trim(),
  quoteMobileHelp: String(
    pricesPageContent.quoteMobileHelp || "Mientras recorres la lista, tu resumen se queda abajo para no perderlo."
  ).trim(),
  quoteLimitBadge: applyTemplate(
    pricesPageContent.quoteLimitBadgeTemplate || "Hasta {limite} servicios",
    { limite: quoteSelectionLimit }
  ).trim(),
  quoteDisabledCtaLabel: String(pricesPageContent.quoteDisabledCtaLabel || "Selecciona servicios").trim(),
  quoteContinueCtaLabel: String(pricesPageContent.quoteContinueCtaLabel || "Continuar con seleccion").trim(),
  quoteMobileCtaLabel: String(pricesPageContent.quoteMobileCtaLabel || "Ir a la agenda").trim(),
  quoteSelectedLabel: String(pricesPageContent.quoteSelectedLabel || "Seleccionados:").trim(),
  quoteSelectedCountSuffix: String(
    pricesPageContent.quoteSelectedCountSuffix || "servicios seleccionados"
  ).trim(),
  quoteTotalLabel: String(pricesPageContent.quoteTotalLabel || "Total aprox.:").trim(),
  quoteEmptyStateText: String(
    pricesPageContent.quoteEmptyStateText || "Todavia no has elegido servicios."
  ).trim(),
  quoteLimitReachedText: applyTemplate(
    pricesPageContent.quoteLimitReachedTemplate ||
      "Llegaste al limite de {limite} servicios. Quita uno para agregar otro.",
    { limite: quoteSelectionLimit }
  ).trim(),
  quoteRemoveLabel: String(pricesPageContent.quoteRemoveLabel || "Quitar").trim(),
  sectionEyebrow: String(pricesPageContent.sectionEyebrow || "Precios y opciones").trim(),
  sectionTitle: String(
    pricesPageContent.sectionTitle || "Elige con calma y revisa nuestros precios"
  ).trim(),
  sectionNote: String(
    pricesPageContent.sectionNote || "Tu cotizacion queda arriba para revisarla antes de bajar a la lista."
  ).trim(),
  tableServiceLabel: String(pricesPageContent.tableServiceLabel || "Servicio").trim(),
  tableFromLabel: String(pricesPageContent.tableFromLabel || "Desde").trim(),
  tableDurationLabel: String(pricesPageContent.tableDurationLabel || "Duracion").trim(),
  tableNoteLabel: String(pricesPageContent.tableNoteLabel || "Nota").trim(),
  tableActionLabel: String(pricesPageContent.tableActionLabel || "Accion").trim(),
  filteredEmptyStateText: String(
    pricesPageContent.filteredEmptyStateText || "No hay precios en esa categoria todavia."
  ).trim(),
};

function moneyUSD(n: number | string | null | undefined) {
  const num = Number(n);
  if (Number.isNaN(num) || num <= 0) return "-";
  try {
    return new Intl.NumberFormat("es-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 0,
    }).format(num);
  } catch {
    return `$${num}`;
  }
}

function resolvePreferredSpecialistSlug(price: PriceRow) {
  return String(price.leadSpecialistSlug || "").trim();
}

function buildAgendarHref(price: PriceRow) {
  const category = priceCategoryKey(price);
  const title = String(price.serviceTitle || "").trim();
  const preferredSpecialistSlug = resolvePreferredSpecialistSlug(price);
  const priceFrom = Number(price.priceFrom);
  const params = new URLSearchParams();
  if (category) params.set("service", category);
  if (preferredSpecialistSlug) params.set("specialist", preferredSpecialistSlug);
  if (price._id) params.append("priceIds", price._id);
  if (title) params.append("services", title);
  if (title) params.append("specialists", preferredSpecialistSlug || noneSpecialistValue);
  if (Number.isFinite(priceFrom) && priceFrom > 0) params.set("approxTotal", String(priceFrom));
  return params.toString() ? `/agendar?${params.toString()}` : "/agendar";
}
---

<Layout
  title={`Precios | ${business?.name || "FumiPro NC Charlotte"}`}
  description={`Consulta los precios de todos nuestros servicios de fumigación en ${business?.area || "Charlotte, NC"}. Cotiza tratamientos y agenda tu inspección en línea.`}
>
  <Header />

  <main class="mx-auto max-w-[92rem] px-4 py-10 pb-36 xl:px-6 md:pb-10">
    <section class="page-intro">
      <div class="page-intro__layout">
        <div>
          <p class="page-intro__eyebrow">{pricesPageText.eyebrow}</p>
          <h1 class="page-intro__title mt-3">{pricesPageText.title}</h1>
          <p class="page-intro__copy mt-3">{pricesPageText.intro}</p>
          <div class="page-intro__actions mt-6">
            <a class="btn-base btn-primary" href={pricesPageText.primaryCtaUrl}>{pricesPageText.primaryCtaText}</a>
            <a class="btn-base btn-secondary" href={pricesPageText.secondaryCtaUrl}>{pricesPageText.secondaryCtaText}</a>
          </div>
        </div>

        <aside class="page-intro__panel">
          <p class="page-intro__panel-label">{pricesPageText.panelLabel}</p>
          <div class="page-intro__panel-list mt-4">
            <div class="page-intro__panel-item">
              <span class="page-intro__step">1</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{pricesPageText.stepOneTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{pricesPageText.stepOneBody}</p>
              </div>
            </div>
            <div class="page-intro__panel-item">
              <span class="page-intro__step">2</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{pricesPageText.stepTwoTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{pricesPageText.stepTwoBody}</p>
              </div>
            </div>
          </div>

          <div class="page-intro__meta-grid">
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{prices.length}</span>
              <span class="page-intro__meta-label">{pricesPageText.pricesCountLabel}</span>
            </div>
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{priceCategoryCount}</span>
              <span class="page-intro__meta-label">{pricesPageText.areasCountLabel}</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    {prices.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white/95 p-6 text-left text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
        {pricesPageText.emptyStateText}
      </div>
    ) : (
      <>
        <div class="mt-6 space-y-4">
          <section class="rounded-3xl border border-slate-200 bg-white/92 p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950 md:p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">{pricesPageText.filterLabel}</p>
            <div class="mt-4 flex flex-wrap gap-2.5" id="price-filters">
              {priceCategories.map((cat, idx) => (
                <button
                  type="button"
                  data-price-filter={cat.key}
                  class:list={[
                    "category-chip",
                    idx === 0 && "category-chip--active",
                  ]}
                >
                  {cat.label}
                </button>
              ))}
            </div>
          </section>

          <section
            class="rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_24px_40px_-34px_rgba(15,23,42,0.5)] dark:border-slate-800 dark:bg-slate-950 md:p-6"
            id="quote-builder"
            data-quote-limit={quoteSelectionLimit}
          >
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="max-w-4xl">
                <p class="text-base font-semibold">{pricesPageText.quoteTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">
                  <strong>{pricesPageText.quoteSingleActionLabel}</strong> {pricesPageText.quoteSingleActionHelp}
                  {" "}
                  <strong>{pricesPageText.quoteAddActionLabel}</strong> {pricesPageText.quoteAddActionHelp}
                </p>
                <p class="mt-2 text-xs font-medium text-red-700 md:hidden dark:text-red-300">
                  {pricesPageText.quoteMobileHelp}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 dark:bg-red-950/30 dark:text-red-300 dark:ring-red-900/40">
                  {pricesPageText.quoteLimitBadge}
                </span>
                <a
                  id="quote-agendar-link"
                  href="/agendar"
                  class="btn-base btn-muted pointer-events-none"
                >
                  {pricesPageText.quoteDisabledCtaLabel}
                </a>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.98rem]">
              <p><span class="font-semibold">{pricesPageText.quoteSelectedLabel}</span> <span id="quote-count">0</span></p>
              <p><span class="font-semibold">{pricesPageText.quoteTotalLabel}</span> <span id="quote-total">$0</span></p>
            </div>
            <p id="quote-list" class="mt-2 text-sm text-slate-600 dark:text-slate-300">{pricesPageText.quoteEmptyStateText}</p>
            <p id="quote-limit-msg" class="mt-2 hidden text-xs font-medium text-amber-700 dark:text-amber-300">
              {pricesPageText.quoteLimitReachedText}
            </p>
          </section>

          <section class="space-y-6">
            <div class="hidden items-start justify-between gap-4 rounded-3xl border border-slate-200 bg-white/78 p-4 shadow-sm md:flex dark:border-slate-800 dark:bg-slate-950/90">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">{pricesPageText.sectionEyebrow}</p>
                <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">{pricesPageText.sectionTitle}</p>
              </div>
              <p class="max-w-sm text-sm leading-6 text-slate-600 dark:text-slate-300">
                {pricesPageText.sectionNote}
              </p>
            </div>

            <div
              id="quote-mobile-bar"
              class="fixed bottom-20 left-4 right-[5.25rem] z-[68] hidden rounded-2xl border border-slate-200 bg-white/98 p-3 shadow-[0_18px_36px_-18px_rgba(15,23,42,0.55)] backdrop-blur md:hidden dark:border-slate-800 dark:bg-slate-950/98"
            >
              <div class="flex items-center gap-3">
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
                    {pricesPageText.quoteTitle}
                  </p>
                  <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                    <span id="quote-mobile-count">0</span> {pricesPageText.quoteSelectedCountSuffix}
                  </p>
                  <p class="text-sm text-slate-600 dark:text-slate-300">
                    {pricesPageText.quoteTotalLabel} <span id="quote-mobile-total">$0</span>
                  </p>
                </div>
                <a
                  id="quote-mobile-link"
                  href="/agendar"
                  class="btn-base btn-muted !min-w-0 !px-4 text-center"
                >
                  {pricesPageText.quoteDisabledCtaLabel}
                </a>
              </div>
            </div>

            <div id="prices-cards-mobile" class="grid gap-3 md:hidden">
              {prices.map((p: PriceRow) => {
                const categoryKey = priceCategoryKey(p);
                const categoryLabel = priceCategoryLabelByKey.get(categoryKey) || "Atencion integral";
                return (
                  <article
                    data-price-row
                    data-category={categoryKey}
                    data-service-title={p.serviceTitle || ""}
                    data-service-id={p._id || ""}
                    data-service-category={categoryKey}
                    data-service-specialist={resolvePreferredSpecialistSlug(p)}
                    data-service-price={Number(p.priceFrom || 0)}
                    class="rounded-[1.6rem] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">
                          {categoryLabel}
                        </p>
                        <p class="mt-2 text-base font-semibold text-slate-900 dark:text-slate-100">{p.serviceTitle || "-"}</p>
                      </div>
                      <span class="rounded-full border border-red-200 bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300">
                        {moneyUSD(p.priceFrom)}
                      </span>
                    </div>

                    <div class="mt-3 grid grid-cols-[auto,1fr] gap-x-4 gap-y-2 text-sm">
                      <p class="text-slate-500 dark:text-slate-400">Duracion</p>
                      <p class="font-medium text-slate-900 dark:text-slate-100">{p.duration || "-"}</p>
                      <p class="text-slate-500 dark:text-slate-400">Nota</p>
                      <p class="font-medium text-slate-700 dark:text-slate-300">{p.note || "-"}</p>
                    </div>

                    <div class="mt-4 grid grid-cols-2 gap-2">
                      <a
                        class="btn-base btn-primary w-full"
                        href={buildAgendarHref(p)}
                      >
                        {pricesPageText.quoteSingleActionLabel}
                      </a>
                      <button
                        type="button"
                        data-select-service
                        class="btn-base btn-secondary w-full"
                      >
                        {pricesPageText.quoteAddActionLabel}
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>

            <div class="hidden overflow-x-auto rounded-3xl border border-slate-200 bg-white/95 md:block xl:overflow-visible dark:border-slate-800 dark:bg-slate-950">
              <table class="min-w-[1080px] w-full table-auto text-[15px] lg:text-base">
                <colgroup>
                  <col class="w-[24%]" />
                  <col class="w-[10%]" />
                  <col class="w-[12%]" />
                  <col class="w-[31%]" />
                  <col class="w-[23%]" />
                </colgroup>
                <thead class="bg-slate-50 text-[0.72rem] uppercase tracking-[0.16em] text-slate-600 dark:bg-slate-900 dark:text-slate-300">
                  <tr>
                    <th class="px-4 py-4 text-left font-medium">{pricesPageText.tableServiceLabel}</th>
                    <th class="px-4 py-4 text-left font-medium">{pricesPageText.tableFromLabel}</th>
                    <th class="px-4 py-4 text-left font-medium">{pricesPageText.tableDurationLabel}</th>
                    <th class="px-4 py-4 text-left font-medium">{pricesPageText.tableNoteLabel}</th>
                    <th class="px-4 py-4 text-left font-medium">{pricesPageText.tableActionLabel}</th>
                  </tr>
                </thead>
                <tbody id="prices-table-body">
                  {prices.map((p: PriceRow, index: number) => (
                    <tr
                      data-price-row
                      data-category={priceCategoryKey(p)}
                      data-service-title={p.serviceTitle || ""}
                      data-service-id={p._id || ""}
                      data-service-category={priceCategoryKey(p)}
                      data-service-specialist={resolvePreferredSpecialistSlug(p)}
                      data-service-price={Number(p.priceFrom || 0)}
                      class:list={[
                        "align-top dark:border-slate-800",
                        index === 0 ? "" : "border-t border-slate-200",
                        index % 2 === 1 && "bg-slate-50/40 dark:bg-slate-900/30",
                      ]}
                    >
                      <td class="px-4 py-5 font-semibold leading-7 text-slate-900 dark:text-slate-100">{p.serviceTitle || "-"}</td>
                      <td class="px-4 py-5 font-medium">{moneyUSD(p.priceFrom)}</td>
                      <td class="px-4 py-5 leading-7">{p.duration || "-"}</td>
                      <td class="px-4 py-5 leading-7 text-slate-600 dark:text-slate-300">{p.note || ""}</td>
                      <td class="px-4 py-5">
                        <div class="flex min-w-[12.75rem] flex-col gap-2">
                          <a
                            class="btn-base btn-primary !min-w-0 w-full !px-3 text-sm"
                            href={buildAgendarHref(p)}
                          >
                            {pricesPageText.quoteSingleActionLabel}
                          </a>
                          <button
                            type="button"
                            data-select-service
                            class="btn-base btn-secondary !min-w-0 w-full !px-3 text-sm"
                          >
                            {pricesPageText.quoteAddActionLabel}
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p id="prices-empty" class="hidden rounded-2xl border border-slate-200 bg-white p-4 text-left text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
              {pricesPageText.filteredEmptyStateText}
            </p>

          </section>
        </div>
      </>
    )}
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ pricesPageText }}>
  const quoteBuilder = document.getElementById("quote-builder");
  const MAX_QUOTE_ITEMS = Math.max(1, Number(quoteBuilder?.getAttribute("data-quote-limit") || 6));
  const priceFilterButtons = Array.from(document.querySelectorAll("[data-price-filter]"));
  const priceRows = Array.from(document.querySelectorAll("[data-price-row]"));
  const addButtons = Array.from(document.querySelectorAll("[data-select-service]"));
  const pricesEmpty = document.getElementById("prices-empty");
  const quoteCount = document.getElementById("quote-count");
  const quoteTotal = document.getElementById("quote-total");
  const quoteList = document.getElementById("quote-list");
  const quoteLimitMsg = document.getElementById("quote-limit-msg");
  const quoteAgendarLink = document.getElementById("quote-agendar-link");
  const quoteMobileBar = document.getElementById("quote-mobile-bar");
  const quoteMobileCount = document.getElementById("quote-mobile-count");
  const quoteMobileTotal = document.getElementById("quote-mobile-total");
  const quoteMobileLink = document.getElementById("quote-mobile-link");
  let activePriceFilter = "all";
  const selectedServices = new Map();
  const getRowKey = (row) =>
    String(
      row?.getAttribute("data-service-id") ||
      row?.getAttribute("data-service-title") ||
      ""
    ).trim();

  const animateFilteredItems = (items) => {
    items.forEach((item, index) => {
      item.classList.remove("filter-item-in", "filter-item-in-slide");
      item.style.animationDelay = `${Math.min(index, 10) * 40}ms`;
      // Reinicia la animacion para cada cambio de filtro.
      void item.offsetWidth;
      item.classList.add(item.tagName === "TR" ? "filter-item-in" : "filter-item-in-slide");
    });
  };

  const moneyMX = (value) =>
    new Intl.NumberFormat("es-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value || 0);

  const updatePriceFilterUI = () => {
    priceFilterButtons.forEach((btn) => {
      const isActive = btn.dataset.priceFilter === activePriceFilter;
      btn.classList.toggle("category-chip--active", isActive);
    });
  };

  const applyPriceFilter = (animate = false) => {
    let visibleCount = 0;
    const visibleRows = [];

    priceRows.forEach((row) => {
      const category = row.dataset.category || "general";
      const visible = activePriceFilter === "all" || category === activePriceFilter;
      row.classList.toggle("hidden", !visible);
      if (visible) {
        visibleCount += 1;
        visibleRows.push(row);
      }
    });

    if (pricesEmpty) pricesEmpty.classList.toggle("hidden", visibleCount > 0);
    if (animate) requestAnimationFrame(() => animateFilteredItems(visibleRows));
  };

  const updateQuoteUI = () => {
    const selected = Array.from(selectedServices.values());
    const total = selected.reduce((acc, item) => acc + (Number(item.price) || 0), 0);
    const reachedLimit = selected.length >= MAX_QUOTE_ITEMS;
    if (quoteCount) quoteCount.textContent = String(selected.length);
    if (quoteTotal) quoteTotal.textContent = moneyMX(total);
    if (quoteMobileBar) quoteMobileBar.classList.toggle("hidden", selected.length === 0);
    if (quoteMobileCount) quoteMobileCount.textContent = String(selected.length);
    if (quoteMobileTotal) quoteMobileTotal.textContent = moneyMX(total);
    if (quoteLimitMsg) quoteLimitMsg.classList.toggle("hidden", !reachedLimit);

    if (quoteList) {
      quoteList.textContent = selected.length > 0
        ? selected.map((item) => item.title).join(" | ")
        : pricesPageText.quoteEmptyStateText;
    }

    const setQuoteLinkState = (link, { enabled, href, text }) => {
      if (!link) return;
      link.setAttribute("href", href);
      link.textContent = text;
      link.classList.toggle("pointer-events-none", !enabled);
      link.classList.toggle("btn-muted", !enabled);
      link.classList.toggle("btn-primary", enabled);
    };

    if (selected.length === 0) {
      setQuoteLinkState(quoteAgendarLink, {
        enabled: false,
        href: "/agendar",
        text: pricesPageText.quoteDisabledCtaLabel,
      });
      setQuoteLinkState(quoteMobileLink, {
        enabled: false,
        href: "/agendar",
        text: pricesPageText.quoteDisabledCtaLabel,
      });
      return;
    }

    const params = new URLSearchParams();
    params.set("service", selected[0].category || "general");
    const uniqueSpecialists = Array.from(
      new Set(selected.map((item) => String(item.specialist || "").trim()).filter(Boolean))
    );
    const hasMultipleSelection = selected.length > 1;
    const shouldSetPrimaryRouting = !hasMultipleSelection;

    if (shouldSetPrimaryRouting && selected[0].specialist) params.set("specialist", selected[0].specialist);
    if (hasMultipleSelection && uniqueSpecialists.length > 1) {
      params.set("routing", "general");
    }
    selected.forEach((item) => {
      if (item.id) params.append("priceIds", item.id);
    });
    selected.forEach((item) => params.append("services", item.title));
    selected.forEach((item) => params.append("specialists", item.specialist || "__none__"));
    if (total > 0) params.set("approxTotal", String(Math.round(total)));
    const targetHref = `/agendar?${params.toString()}`;
    setQuoteLinkState(quoteAgendarLink, {
      enabled: true,
      href: targetHref,
      text: pricesPageText.quoteContinueCtaLabel,
    });
    setQuoteLinkState(quoteMobileLink, {
      enabled: true,
      href: targetHref,
      text: pricesPageText.quoteMobileCtaLabel,
    });

    addButtons.forEach((button) => {
      const row = button.closest("[data-price-row]");
      const rowKey = getRowKey(row);
      const isSelected = selectedServices.has(rowKey);
      const disableAdd = reachedLimit && !isSelected;

      button.textContent = isSelected ? pricesPageText.quoteRemoveLabel : pricesPageText.quoteAddActionLabel;
      button.classList.toggle("bg-red-100", isSelected);
      button.classList.toggle("text-red-800", isSelected);
      button.classList.toggle("border-red-300", isSelected);

      button.toggleAttribute("disabled", disableAdd);
      button.classList.toggle("opacity-50", disableAdd);
      button.classList.toggle("cursor-not-allowed", disableAdd);
    });
  };

  addButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest("[data-price-row]");
      if (!row) return;

      const rowKey = getRowKey(row);
      const title = String(row.getAttribute("data-service-title") || "").trim();
      const category = String(row.getAttribute("data-service-category") || "").trim();
      const specialist = String(row.getAttribute("data-service-specialist") || "").trim();
      const price = Number(row.getAttribute("data-service-price") || 0);
      if (!rowKey || !title) return;

      if (selectedServices.has(rowKey)) {
        selectedServices.delete(rowKey);
      } else {
        if (selectedServices.size >= MAX_QUOTE_ITEMS) {
          updateQuoteUI();
          return;
        }
        selectedServices.set(rowKey, { id: rowKey, title, category, specialist, price });
      }
      updateQuoteUI();
    });
  });

  priceFilterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activePriceFilter = btn.dataset.priceFilter || "all";
      updatePriceFilterUI();
      applyPriceFilter(true);
    });
  });

  updatePriceFilterUI();
  applyPriceFilter(false);
  updateQuoteUI();
</script>

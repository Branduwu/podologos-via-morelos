---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { business } from "../../config/clinic";
import { getBusinessInfo, getServices, getSpecialists } from "../../lib/sanity.js";
import { normalizeServiceSlug } from "../../utils/prefill";
import {
  buildContactMessage,
  buildWhatsAppUrl,
  resolveWhatsAppNumber,
  resolveWhatsAppReason,
} from "../../utils/whatsapp";

type ServiceItem = {
  title?: string;
  slug?: string | { current?: string };
  short?: string;
  duration?: string;
  priceFrom?: number;
  category?: string;
  leadSpecialistSlug?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
};

type SpecialistRoutingItem = {
  _id?: string;
  slug?: string;
  name?: string;
  specialty?: string;
  specialtyCategory?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  useWhatsAppButton?: boolean;
};

const business = await getBusinessInfo();
const services: ServiceItem[] = (await getServices()) || [];
const specialists: SpecialistRoutingItem[] = (await getSpecialists()) || [];
const validSlugRe = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

const generalWaNumber = resolveWhatsAppNumber(
  business?.whatsappCitasNumber,
  business.whatsappNumber
);
const specialistsWaNumber = resolveWhatsAppNumber(
  business?.whatsappSpecialistsNumber,
  generalWaNumber
);

const serviceCategories = [
  { key: "all", label: "Todas" },
  { key: "roedores", label: "Roedores" },
  { key: "cucarachas", label: "Cucarachas" },
  { key: "termitas", label: "Termitas" },
  { key: "chinches", label: "Chinches" },
  { key: "hormigas", label: "Hormigas" },
  { key: "avispas", label: "Avispas" },
  { key: "inspeccion", label: "Inspección" },
  { key: "general", label: "General" },
];
const serviceCategoryLabelByKey = new Map(serviceCategories.map((item) => [item.key, item.label]));
const servicesCategoryCount =
  new Set(
    services
      .map((service) => normalizeServiceSlug(service?.category || service?.title || ""))
      .filter(Boolean)
  ).size || Math.max(1, serviceCategories.length - 1);
const servicesPageContent = business?.servicesPageContent || {};
const servicesPageText = {
  eyebrow: String(servicesPageContent.eyebrow || "Fumigación certificada").trim(),
  title: String(servicesPageContent.title || "Fumigación").trim(),
  intro: String(
    servicesPageContent.intro ||
      "Conoce nuestros tratamientos de fumigación, revisa precios y elige el plan que mejor se adapte. ¿Tienes dudas? Escríbenos y te orientamos."
  ).trim(),
  primaryCtaText: String(servicesPageContent.primaryCtaText || "Solicitar inspección").trim(),
  primaryCtaUrl: String(servicesPageContent.primaryCtaUrl || "/agendar").trim(),
  secondaryCtaText: String(servicesPageContent.secondaryCtaText || "Ver precios").trim(),
  secondaryCtaUrl: String(servicesPageContent.secondaryCtaUrl || "/precios").trim(),
  panelLabel: String(servicesPageContent.panelLabel || "Te ayudamos a elegir").trim(),
  stepOneTitle: String(servicesPageContent.stepOneTitle || "Elige el tipo de plaga").trim(),
  stepOneBody: String(
    servicesPageContent.stepOneBody ||
      "Selecciona el tipo de plaga para ver los tratamientos disponibles y encontrar la solución más rápida."
  ).trim(),
  stepTwoTitle: String(servicesPageContent.stepTwoTitle || "Solicita tu servicio").trim(),
  stepTwoBody: String(
    servicesPageContent.stepTwoBody ||
      "Desde cada tratamiento puedes ver detalles, revisar precios o pedir una inspección por WhatsApp."
  ).trim(),
  servicesCountLabel: String(servicesPageContent.servicesCountLabel || "tratamientos disponibles").trim(),
  areasCountLabel: String(servicesPageContent.areasCountLabel || "tipos de plaga").trim(),
  emptyStateText: String(
    servicesPageContent.emptyStateText ||
      "Pronto publicaremos nuestros tratamientos. Contáctanos para una inspección gratuita."
  ).trim(),
  cardFallbackText: String(
    servicesPageContent.cardFallbackText ||
      "Tratamiento profesional con garantía de resultados y productos seguros para tu familia."
  ).trim(),
  filteredEmptyStateText: String(
    servicesPageContent.filteredEmptyStateText ||
      "No hay tratamientos en esa categoría todavía."
  ).trim(),
};

const specialistBySlug = new Map<string, SpecialistRoutingItem>();
for (const specialist of specialists) {
  const slug = String(specialist?.slug || specialist?._id || "").trim();
  if (!slug) continue;
  specialistBySlug.set(slug, specialist);
}

function moneyUSD(n: number | string | null | undefined) {
  const num = Number(n);
  if (Number.isNaN(num) || num <= 0) return "";
  try {
    return new Intl.NumberFormat("es-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 0,
    }).format(num);
  } catch {
    return `$${num}`;
  }
}
---

<Layout
  title={`Servicios | ${business?.name || "FumiPro NC Charlotte"}`}
  description={`Servicios de fumigación y control de plagas en ${business?.area || "Charlotte, NC"}. Inspecciones, tratamientos y planes de mantenimiento disponibles.`}
>
  <Header />

  <main class="mx-auto max-w-[88rem] px-4 py-10 xl:px-6">
    <section class="page-intro">
      <div class="page-intro__layout">
        <div>
          <p class="page-intro__eyebrow">{servicesPageText.eyebrow}</p>
          <h1 class="page-intro__title mt-3">{servicesPageText.title}</h1>
          <p class="page-intro__copy mt-3">{servicesPageText.intro}</p>
          <div class="page-intro__actions mt-6">
            <a class="btn-base btn-primary" href={servicesPageText.primaryCtaUrl}>{servicesPageText.primaryCtaText}</a>
            <a class="btn-base btn-secondary" href={servicesPageText.secondaryCtaUrl}>{servicesPageText.secondaryCtaText}</a>
          </div>
        </div>

        <aside class="page-intro__panel">
          <p class="page-intro__panel-label">{servicesPageText.panelLabel}</p>
          <div class="page-intro__panel-list mt-4">
            <div class="page-intro__panel-item">
              <span class="page-intro__step">1</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{servicesPageText.stepOneTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{servicesPageText.stepOneBody}</p>
              </div>
            </div>
            <div class="page-intro__panel-item">
              <span class="page-intro__step">2</span>
              <div>
                <p class="font-semibold text-slate-900 dark:text-slate-100">{servicesPageText.stepTwoTitle}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{servicesPageText.stepTwoBody}</p>
              </div>
            </div>
          </div>

          <div class="page-intro__meta-grid">
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{services.length}</span>
              <span class="page-intro__meta-label">{servicesPageText.servicesCountLabel}</span>
            </div>
            <div class="page-intro__meta">
              <span class="page-intro__meta-value">{servicesCategoryCount}</span>
              <span class="page-intro__meta-label">{servicesPageText.areasCountLabel}</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    {services.length === 0 && (
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white/95 p-6 text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
        {servicesPageText.emptyStateText}
      </div>
    )}

    {services.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2.5" id="service-filters">
        {serviceCategories.map((cat, idx) => (
          <button
            type="button"
            data-service-filter={cat.key}
            class:list={["category-chip", idx === 0 && "category-chip--active"]}
          >
            {cat.label}
          </button>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3 xl:items-stretch 2xl:gap-7">
      {services.map((service: ServiceItem) => {
        const rawSlug =
          typeof service.slug === "string" ? service.slug : service.slug?.current;
        const cleanSlug = typeof rawSlug === "string" ? rawSlug.trim() : "";
        const hasValidSlug = validSlugRe.test(cleanSlug);
        const detailHref = hasValidSlug ? `/servicios/${cleanSlug}` : "/servicios";

        const serviceLabel = service.title || "Servicio";
        const serviceCategory = normalizeServiceSlug(
          service.category || service.title || cleanSlug
        );
        const categoryLabel = serviceCategoryLabelByKey.get(serviceCategory) || "Fumigación";
        const servicePrice = Number(service.priceFrom || 0);
        const summaryText = String(service.short || "").trim();

        const preferredSpecialistSlug =
          String(service.leadSpecialistSlug || "").trim();
        const routingSpecialist = preferredSpecialistSlug
          ? specialistBySlug.get(preferredSpecialistSlug)
          : undefined;
        const manualServiceWaNumber = String(service.whatsAppNumber || "").trim();
        const manualServiceWaMessage = String(service.whatsAppMessage || "").trim();

        const agendarParams = new URLSearchParams();
        if (serviceCategory) agendarParams.set("service", serviceCategory);
        if (preferredSpecialistSlug) agendarParams.set("specialist", preferredSpecialistSlug);
        if (serviceLabel) agendarParams.append("services", serviceLabel);
        if (servicePrice > 0) {
          agendarParams.set("approxTotal", String(Math.round(servicePrice)));
        }
        const agendarHref = agendarParams.toString()
          ? `/agendar?${agendarParams.toString()}`
          : "/agendar";

        const useSpecialistWa = !manualServiceWaNumber && routingSpecialist?.useWhatsAppButton !== false;
        const waReasonTemplate = manualServiceWaMessage
          ? manualServiceWaMessage
          : useSpecialistWa
            ? routingSpecialist?.whatsAppMessage ||
              business?.whatsappSpecialistsMessage ||
              business?.whatsappGeneralMessage
            : business?.whatsappGeneralMessage;
        const waTargetNumber = resolveWhatsAppNumber(
          manualServiceWaNumber,
          useSpecialistWa ? routingSpecialist?.whatsAppNumber : "",
          specialistsWaNumber,
          generalWaNumber
        );
        const waHref = buildWhatsAppUrl(
          buildContactMessage({
            service: serviceLabel,
            reason: resolveWhatsAppReason(
              waReasonTemplate,
              useSpecialistWa
                ? "Hola, me interesa {servicio} y me gustaría agendar con {especialista} en {negocio}. ¿Tienen disponibilidad?"
                : "Hola, me interesa el servicio de {servicio} en {negocio}. ¿Tienen disponibilidad?",
              {
                specialist: routingSpecialist?.name || "técnico disponible",
                service: serviceLabel,
                business: business?.name || business.name,
                problem: business?.whatsappQuickProblemDefault || "",
              }
            ),
          }),
          waTargetNumber
        );

        return (
          <article
            data-service-card
            data-category={serviceCategory || "general"}
            class="card-surface group flex h-full flex-col rounded-3xl p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-xl md:p-7"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[0.74rem] font-extrabold uppercase tracking-[0.18em] text-red-700 dark:text-red-300">
                  {categoryLabel}
                </p>
                <h2 class="mt-3 text-[1.3rem] font-semibold leading-tight text-slate-900 dark:text-slate-100 md:text-[1.45rem]">
                  {serviceLabel}
                </h2>
              </div>
            </div>

            <div class="flex-1">
              {summaryText ? (
                <p class="mt-3 text-[0.98rem] leading-7 text-slate-600 dark:text-slate-300">
                  {summaryText}
                </p>
              ) : (
                <p class="mt-3 text-[0.98rem] leading-7 text-slate-500 dark:text-slate-400">
                  {servicesPageText.cardFallbackText}
                </p>
              )}

              <div class="mt-5 flex flex-wrap gap-2 text-[0.82rem] font-medium text-slate-600 dark:text-slate-300">
                {service.duration && (
                  <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-slate-800">
                    Duracion {service.duration}
                  </span>
                )}
                {!!moneyUSD(service.priceFrom) && (
                  <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-slate-800">
                    Desde {moneyUSD(service.priceFrom)}
                  </span>
                )}
              </div>
            </div>

            <div class="mt-7 space-y-3 pt-1">
              <a class="btn-base btn-primary w-full" href={agendarHref}>
                Solicitar este servicio
              </a>
              <a class="btn-base btn-secondary w-full" href={detailHref}>
                Ver detalles
              </a>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold">
                <a class="link-inline" href="/precios">
                  Ver precios
                </a>
                <a
                  class="link-inline"
                  href={waHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Escribir por WhatsApp
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p
      id="services-empty"
      class="mt-6 hidden rounded-2xl border border-slate-200 bg-white p-4 text-left text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300"
    >
      {servicesPageText.filteredEmptyStateText}
    </p>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const serviceFilterButtons = Array.from(document.querySelectorAll("[data-service-filter]"));
  const serviceCards = Array.from(document.querySelectorAll("[data-service-card]"));
  const servicesEmpty = document.getElementById("services-empty");
  let activeServiceFilter = "all";

  const animateFilteredItems = (items) => {
    items.forEach((item, index) => {
      item.classList.remove("filter-item-in", "filter-item-in-slide");
      item.style.animationDelay = `${Math.min(index, 10) * 45}ms`;
      void item.offsetWidth;
      item.classList.add("filter-item-in-slide");
    });
  };

  const updateServiceFilterUI = () => {
    serviceFilterButtons.forEach((btn) => {
      const isActive = btn.dataset.serviceFilter === activeServiceFilter;
      btn.classList.toggle("category-chip--active", isActive);
    });
  };

  const applyServiceFilter = (animate = false) => {
    let visibleCount = 0;
    const visibleCards = [];

    serviceCards.forEach((card) => {
      const category = card.dataset.category || "general";
      const visible = activeServiceFilter === "all" || category === activeServiceFilter;
      card.classList.toggle("hidden", !visible);
      if (visible) {
        visibleCount += 1;
        visibleCards.push(card);
      }
    });

    if (servicesEmpty) servicesEmpty.classList.toggle("hidden", visibleCount > 0);
    if (animate) requestAnimationFrame(() => animateFilteredItems(visibleCards));
  };

  serviceFilterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeServiceFilter = btn.dataset.serviceFilter || "all";
      updateServiceFilterUI();
      applyServiceFilter(true);
    });
  });

  updateServiceFilterUI();
  applyServiceFilter(false);
</script>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteAnnouncements } from "../lib/sanity.js";

type Announcement = {
  _id?: string;
  title?: string;
  publishDate?: string;
  body?: string;
  featured?: boolean;
};

const cmsItems: Announcement[] = (await getSiteAnnouncements()) || [];

const items =
  cmsItems.length > 0
    ? cmsItems.map((item) => ({
        id: item._id || `${item.title || "item"}-${item.publishDate || ""}`,
        title: item.title || "Comunicado",
        date: item.publishDate
          ? new Date(`${item.publishDate}T12:00:00`).toLocaleDateString("es-US")
          : "-",
        body: item.body || "",
        featured: Boolean(item.featured),
      }))
    : [];
---

<Layout title="Comunicados | FumiPro NC Charlotte" description="Noticias y avisos del consultorio.">
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Comunicados</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300">Aqui compartimos avisos y actualizaciones para pacientes.</p>

    {items.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-8 text-center text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
        <p class="text-base font-medium">No hay comunicados publicados todavía.</p>
        <p class="mt-1 text-sm">Cuando el equipo publique un aviso, aparecerá aquí.</p>
      </div>
    ) : (
      <div class="mt-6 space-y-4">
        {items.map((item) => (
          <article
            class={`rounded-2xl border p-6 ${item.featured ? "border-red-300 bg-red-50 dark:border-red-700 dark:bg-red-950/40" : "border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950"}`}
            data-announcement-id={item.id}
          >
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400">{item.date}</p>
              {item.featured && (
                <span class="rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-bold text-red-700 dark:bg-red-900/50 dark:text-red-300">
                  Destacado
                </span>
              )}
            </div>
            <h2 class="mt-2 text-xl font-bold">{item.title}</h2>
            <p class="mt-2 whitespace-pre-line text-sm text-slate-700 dark:text-slate-300">{item.body}</p>
          </article>
        ))}
      </div>
    )}
  </main>

  <Footer />
</Layout>

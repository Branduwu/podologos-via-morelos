---
/**
 * English booking/request page – /en/agendar
 */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo } from "../../lib/sanity.js";
import { business } from "../../config/clinic";
import { resolveWhatsAppNumber } from "../../utils/whatsapp";

const cms = await getBusinessInfo();
const businessName = cms?.name || business.name;
const waNumber = resolveWhatsAppNumber(cms?.whatsappCitasNumber, business.whatsappNumber);

const { service: serviceParam } = Astro.url.searchParams
  ? Object.fromEntries(Astro.url.searchParams.entries())
  : {};
---

<Layout
  title={`Request Service – ${businessName}`}
  description="Request pest control service in Charlotte, NC. Fill out the form and we'll contact you to confirm your appointment."
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-sky-50 to-white py-16 dark:from-[rgb(6,16,30)] dark:to-[rgb(8,20,38)]">
      <div class="mx-auto max-w-3xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Schedule</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">
          Request Service
        </h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(186,205,227)]">
          Fill out the form below and we'll get in touch to confirm your appointment via WhatsApp.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-3xl px-4">
        <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
          <h2 class="font-['Manrope',sans-serif] mb-6 text-xl font-bold text-slate-900 dark:text-white">Service request form</h2>

          <form id="booking-form-en" class="space-y-5">
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(196,216,240)]" for="name-en">
                Full name *
              </label>
              <input
                id="name-en"
                name="name"
                type="text"
                required
                placeholder="Your full name"
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-100 dark:border-[rgb(50,75,110)] dark:bg-[rgb(8,20,38)] dark:text-white"
              />
            </div>

            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(196,216,240)]" for="phone-en">
                Phone number *
              </label>
              <input
                id="phone-en"
                name="phone"
                type="tel"
                required
                placeholder="(704) 000-0000"
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-100 dark:border-[rgb(50,75,110)] dark:bg-[rgb(8,20,38)] dark:text-white"
              />
            </div>

            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(196,216,240)]" for="service-en">
                Service needed
              </label>
              <select
                id="service-en"
                name="service"
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-100 dark:border-[rgb(50,75,110)] dark:bg-[rgb(8,20,38)] dark:text-white"
              >
                <option value="">-- Select a service --</option>
                <option value="roedores">Rodent Control</option>
                <option value="cucarachas">Cockroach Treatment</option>
                <option value="termitas">Termite Treatment</option>
                <option value="chinches">Bed Bug Treatment</option>
                <option value="hormigas">Ant Control</option>
                <option value="avispas">Wasps & Bees</option>
                <option value="inspeccion">Inspection</option>
                <option value="general">General Fumigation</option>
              </select>
            </div>

            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(196,216,240)]" for="notes-en">
                Additional notes
              </label>
              <textarea
                id="notes-en"
                name="notes"
                rows={4}
                placeholder="Describe the pest issue, location, or any other details..."
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-100 dark:border-[rgb(50,75,110)] dark:bg-[rgb(8,20,38)] dark:text-white"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn-base btn-primary w-full py-3 text-base"
            >
              Send via WhatsApp
            </button>
          </form>

          <p class="mt-4 text-xs text-slate-400 dark:text-[rgb(120,145,175)]">
            By submitting this form you agree to be contacted via WhatsApp. We do not share your information.
          </p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script define:vars={{ waNumber, businessName, serviceParam }}>
  const form = document.getElementById("booking-form-en");
  if (form) {
    const serviceSelect = document.getElementById("service-en");
    if (serviceParam && serviceSelect) {
      serviceSelect.value = serviceParam;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const phone = String(data.get("phone") || "").trim();
      const service = String(data.get("service") || "").trim();
      const notes = String(data.get("notes") || "").trim();

      const serviceLabel = serviceSelect?.options[serviceSelect.selectedIndex]?.text || service || "pest control";
      const msg = [
        `Hi, I'd like to request a service at ${businessName}.`,
        `Name: ${name}`,
        `Phone: ${phone}`,
        service ? `Service: ${serviceLabel}` : "",
        notes ? `Notes: ${notes}` : "",
      ].filter(Boolean).join("\n");

      const number = String(waNumber || "").replace(/\D/g, "");
      if (!number) { alert("WhatsApp number not configured. Please call us."); return; }
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
    });
  }
</script>

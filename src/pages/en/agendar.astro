---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getServices } from "../../lib/sanity.js";
import { business } from "../../config/clinic";
import { resolveWhatsAppNumber } from "../../utils/whatsapp";

const cms = await getBusinessInfo();
const businessName = cms?.name || business.name;
const waNumber = resolveWhatsAppNumber(cms?.whatsappCitasNumber, business.whatsappNumber);

const allServices = (await getServices()) || [];
const activeServices = allServices.filter((s: any) => s.title || s.titleEn);

const { service: serviceParam } = Astro.url.searchParams
  ? Object.fromEntries(Astro.url.searchParams.entries())
  : {};

const getSlug = (s: any) =>
  typeof s.slug === "string" ? s.slug : s.slug?.current || "";
---

<Layout
  title={`Request Service – ${businessName}`}
  description={`Request pest control service in Charlotte, NC. Fill out the form and we'll contact you to confirm via WhatsApp.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-14 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Quick booking</p>
        <h1 class="mt-2 font-['Manrope',sans-serif] text-4xl font-extrabold text-slate-900 sm:text-5xl dark:text-white">
          Request Service
        </h1>
        <p class="mt-3 max-w-lg text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          Fill in your details below and we'll reach out via WhatsApp to confirm your appointment.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-5xl px-4">
        <div class="grid gap-8 lg:grid-cols-[1fr_340px]">

          <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
            <h2 class="mb-6 font-['Manrope',sans-serif] text-xl font-bold text-slate-900 dark:text-white">
              Service request form
            </h2>

            <form id="booking-form-en" class="space-y-5" novalidate>
              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(248,220,220)]" for="name-en">
                  Full name <span class="text-red-600" aria-hidden="true">*</span>
                </label>
                <input
                  id="name-en"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Your full name"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 dark:border-[rgb(70,15,15)] dark:bg-[rgb(28,5,5)] dark:text-white"
                />
              </div>

              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(248,220,220)]" for="phone-en">
                  Phone number <span class="text-red-600" aria-hidden="true">*</span>
                </label>
                <input
                  id="phone-en"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  inputmode="numeric"
                  placeholder="(704) 000-0000"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 dark:border-[rgb(70,15,15)] dark:bg-[rgb(28,5,5)] dark:text-white"
                />
              </div>

              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(248,220,220)]" for="service-en">
                  Service needed
                </label>
                <select
                  id="service-en"
                  name="service"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 dark:border-[rgb(70,15,15)] dark:bg-[rgb(28,5,5)] dark:text-white"
                >
                  <option value="">-- Select a service --</option>
                  {activeServices.length > 0 ? (
                    activeServices.map((svc: any) => {
                      const slug = getSlug(svc);
                      const label = svc.titleEn || svc.title || slug;
                      return <option value={slug}>{label}</option>;
                    })
                  ) : (
                    <>
                      <option value="roedores">Rodent Control</option>
                      <option value="cucarachas">Cockroach Treatment</option>
                      <option value="termitas">Termite Treatment</option>
                      <option value="chinches">Bed Bug Treatment</option>
                      <option value="hormigas">Ant Control</option>
                      <option value="avispas">Wasps &amp; Bees</option>
                      <option value="inspeccion">Inspection</option>
                      <option value="general">General Fumigation</option>
                    </>
                  )}
                </select>
              </div>

              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(248,220,220)]" for="address-en">
                  Service address
                </label>
                <input
                  id="address-en"
                  name="address"
                  type="text"
                  autocomplete="street-address"
                  placeholder="Street address, city"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 dark:border-[rgb(70,15,15)] dark:bg-[rgb(28,5,5)] dark:text-white"
                />
              </div>

              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700 dark:text-[rgb(248,220,220)]" for="notes-en">
                  Additional details
                </label>
                <textarea
                  id="notes-en"
                  name="notes"
                  rows={3}
                  placeholder="Describe the pest issue, severity, or any other details that might help us..."
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 dark:border-[rgb(70,15,15)] dark:bg-[rgb(28,5,5)] dark:text-white"
                ></textarea>
              </div>

              <button type="submit" class="btn-base btn-primary w-full py-3.5 text-base">
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 inline h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M11.999 2C6.477 2 2 6.477 2 12c0 1.821.487 3.53 1.338 5.004L2.01 22l5.132-1.348A9.963 9.963 0 0011.999 22C17.522 22 22 17.523 22 12S17.522 2 11.999 2zm0 18a7.96 7.96 0 01-4.052-1.103l-.29-.173-3.047.799.815-2.98-.19-.306A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-7.999 8z"/>
                </svg>
                Send via WhatsApp
              </button>

              <p class="text-xs text-slate-400 dark:text-[rgb(210,130,130)]">
                By submitting this form you agree to be contacted via WhatsApp. We do not share your information with third parties.
              </p>
            </form>
          </div>

          <aside class="space-y-4">
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
              <p class="text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">Contact options</p>
              <div class="mt-4 space-y-3">
                <a
                  href={`https://wa.me/${String(waNumber || "").replace(/\D/g, "")}?text=${encodeURIComponent(`Hi, I'd like to request a pest control service at ${businessName}. Can you help me?`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-base btn-primary flex w-full items-center justify-center gap-2"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M11.999 2C6.477 2 2 6.477 2 12c0 1.821.487 3.53 1.338 5.004L2.01 22l5.132-1.348A9.963 9.963 0 0011.999 22C17.522 22 22 17.523 22 12S17.522 2 11.999 2zm0 18a7.96 7.96 0 01-4.052-1.103l-.29-.173-3.047.799.815-2.98-.19-.306A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-7.999 8z"/>
                  </svg>
                  WhatsApp direct
                </a>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
              <p class="text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">What happens next?</p>
              <ol class="mt-3 space-y-2.5 text-sm text-slate-600 dark:text-[rgb(245,210,210)]">
                <li class="flex gap-2.5"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-700 dark:bg-red-900/40 dark:text-red-300">1</span>Fill out the form and tap Send</li>
                <li class="flex gap-2.5"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-700 dark:bg-red-900/40 dark:text-red-300">2</span>We'll confirm availability via WhatsApp</li>
                <li class="flex gap-2.5"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-700 dark:bg-red-900/40 dark:text-red-300">3</span>Our technician arrives on schedule</li>
              </ol>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
              <p class="text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">Our promise</p>
              <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-[rgb(245,210,210)]">
                <li class="flex items-start gap-2"><span class="mt-0.5 text-red-600" aria-hidden="true">✓</span> Free first inspection included</li>
                <li class="flex items-start gap-2"><span class="mt-0.5 text-red-600" aria-hidden="true">✓</span> Certified & experienced technicians</li>
                <li class="flex items-start gap-2"><span class="mt-0.5 text-red-600" aria-hidden="true">✓</span> 30-day satisfaction guarantee</li>
                <li class="flex items-start gap-2"><span class="mt-0.5 text-red-600" aria-hidden="true">✓</span> EPA-registered safe products</li>
              </ul>
            </div>
          </aside>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ waNumber, businessName, serviceParam }}>
  const form = document.getElementById("booking-form-en");
  if (form) {
    const serviceSelect = document.getElementById("service-en");
    if (serviceParam && serviceSelect) {
      serviceSelect.value = serviceParam;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name    = String(data.get("name")    || "").trim();
      const phone   = String(data.get("phone")   || "").trim();
      const service = String(data.get("service") || "").trim();
      const address = String(data.get("address") || "").trim();
      const notes   = String(data.get("notes")   || "").trim();

      if (!name || !phone) {
        alert("Please enter your name and phone number.");
        return;
      }

      const serviceLabel =
        serviceSelect instanceof HTMLSelectElement
          ? serviceSelect.options[serviceSelect.selectedIndex]?.text || service || "pest control"
          : service || "pest control";

      const lines = [
        `Hi, I'd like to request a service at ${businessName}.`,
        `Name: ${name}`,
        `Phone: ${phone}`,
        service  ? `Service: ${serviceLabel}` : "",
        address  ? `Address: ${address}`      : "",
        notes    ? `Notes: ${notes}`          : "",
      ].filter(Boolean);

      const number = String(waNumber || "").replace(/\D/g, "");
      if (!number) { alert("WhatsApp number not configured. Please call us directly."); return; }
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener,noreferrer");
    });
  }
</script>

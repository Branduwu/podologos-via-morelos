---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getGallery } from "../../lib/sanity.js";
import { business } from "../../config/clinic";

const cms = await getBusinessInfo();
const galleryItems = (await getGallery()) || [];
const businessName = cms?.name || business.name;

const photos = galleryItems.filter((it: any) => it.type !== "video");
---

<Layout
  title={`Gallery – ${businessName}`}
  description={`See our pest control work in Charlotte, NC. Before and after photos from ${businessName}.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-16 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Our work</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">Gallery</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          Before and after photos from our pest control treatments in Charlotte, NC.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-6xl px-4">
        {galleryItems.length === 0 ? (
          <p class="text-slate-500 dark:text-[rgb(240,190,190)]">Gallery coming soon.</p>
        ) : (
          <>
            {photos.length > 0 && (
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
                {photos.map((item: any) => (
                  <div class="overflow-hidden rounded-xl border border-slate-100 bg-white dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                    <img
                      src={item.imageUrl || "/placeholder.jpg"}
                      alt={item.title || "Gallery image"}
                      class="h-52 w-full object-cover"
                      loading="lazy"
                      data-fallback-src="/placeholder.jpg"
                    />
                    {item.title && (
                      <p class="px-4 py-2.5 text-sm font-medium text-slate-700 dark:text-[rgb(248,220,220)]">{item.title}</p>
                    )}
                  </div>
                ))}
              </div>
            )}
          </>
        )}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

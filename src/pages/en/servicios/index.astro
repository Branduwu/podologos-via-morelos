---
/**
 * English services page – /en/servicios
 * Shows service catalog with English fields preferred.
 */
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getBusinessInfo, getServices } from "../../../lib/sanity.js";
import { business } from "../../../config/clinic";

type ServiceItem = {
  _id?: string;
  title?: string;
  titleEn?: string;
  slug?: string | { current?: string };
  short?: string;
  shortEn?: string;
  long?: string;
  longEn?: string;
  duration?: string;
  priceFrom?: number;
  category?: string;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
};

const cms = await getBusinessInfo();
const services: ServiceItem[] = (await getServices()) || [];
const businessName = cms?.name || business.name;

const grouped = business.serviceCategories.map((cat) => ({
  key: cat.key,
  label: cat.labelEn,
  services: services.filter((s) => s.category === cat.key),
})).filter((g) => g.services.length > 0);

const getSlug = (s: ServiceItem) =>
  typeof s.slug === "string" ? s.slug : s.slug?.current || "";
---

<Layout
  title={`Services – ${businessName}`}
  description="Browse our pest control services in Charlotte, NC: rodents, termites, bed bugs, cockroaches, ants, wasps and more."
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-16 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">What we do</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white sm:text-5xl">
          Pest Control Services
        </h1>
        <p class="mt-4 max-w-xl text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          Specialized treatments to eliminate and prevent pests in homes and businesses in Charlotte, NC.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {business.serviceCategories.map((cat) => (
            <a
              href={`#${cat.key}`}
              class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-red-400 hover:text-red-700 dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)] dark:text-[rgb(248,220,220)]"
            >
              {cat.labelEn}
            </a>
          ))}
        </div>
      </div>
    </section>

    {grouped.length === 0 ? (
      <section class="py-20 text-center">
        <p class="text-slate-500 dark:text-[rgb(240,190,190)]">No services available at this time. Please check back soon.</p>
      </section>
    ) : (
      <section class="py-12">
        <div class="mx-auto max-w-6xl px-4 space-y-12">
          {grouped.map((group) => (
            <div id={group.key} data-reveal>
              <h2 class="font-['Manrope',sans-serif] mb-5 text-2xl font-bold text-slate-900 dark:text-white">
                {group.label}
              </h2>
              <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {group.services.map((svc) => {
                  const title = svc.titleEn || svc.title || "Service";
                  const desc = svc.shortEn || svc.short || "";
                  const slug = getSlug(svc);
                  return (
                    <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm transition hover:shadow-md dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                      <h3 class="font-['Manrope',sans-serif] font-bold text-slate-900 dark:text-white">{title}</h3>
                      {desc && <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-[rgb(245,210,210)]">{desc}</p>}
                      <div class="mt-4 flex flex-wrap items-center gap-3">
                        {svc.priceFrom != null && (
                          <span class="text-sm font-semibold text-red-700 dark:text-red-400">
                            From ${svc.priceFrom}
                          </span>
                        )}
                        {svc.duration && (
                          <span class="text-xs text-slate-500 dark:text-[rgb(240,190,190)]">{svc.duration}</span>
                        )}
                      </div>
                      <div class="mt-4">
                        <a
                          href={`/en/agendar${slug ? `?service=${encodeURIComponent(slug)}` : ""}`}
                          class="btn-base btn-secondary text-sm"
                        >
                          Request this service
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="bg-red-700 py-12 text-white dark:bg-red-900" data-reveal>
      <div class="mx-auto max-w-2xl px-4 text-center">
        <h2 class="font-['Manrope',sans-serif] text-2xl font-extrabold">Ready to get started?</h2>
        <p class="mt-2 text-red-100">Contact us today for a fast quote.</p>
        <a href="/en/agendar" class="btn-base mt-5 inline-block bg-white px-6 py-2.5 font-bold text-red-700 hover:bg-red-50">
          Request service
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

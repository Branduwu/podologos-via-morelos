---
/**
 * English home page – /en/
 * Language is auto-detected by Layout/Header via getLangFromUrl().
 * Content is fetched from Sanity; English fields (_en suffix) are preferred.
 */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getPromotions, getAboutSection, getGallery } from "../../lib/sanity.js";
import { getGooglePlaceReviews } from "../../lib/googleReviews.js";
import { business } from "../../config/clinic";

const cms = await getBusinessInfo();
const about = await getAboutSection();
const promos = (await getPromotions()) || [];
const galleryItems = (await getGallery()) || [];

const businessName = cms?.name || business.name;

// Promotions
const today = new Date(); today.setHours(0, 0, 0, 0);
const activePromos = promos.filter((p: any) => {
  if (!p.endDate) return true;
  const end = new Date(p.endDate); end.setHours(0, 0, 0, 0);
  return today <= end;
}).sort((a: any, b: any) => Number(b.pinned) - Number(a.pinned)).slice(0, 6);

// Gallery
const featuredGallery = galleryItems.filter((it: any) => it.featured);
const photos = (featuredGallery.length > 0 ? featuredGallery : galleryItems)
  .filter((it: any) => it.type !== "video")
  .slice(0, 6);

// Google Reviews
const googleReviews = await getGooglePlaceReviews(cms?.googlePlaceId, { maxReviews: 4 });

// Hero
const heroEyebrow = business.taglineEn.split("in")[0]?.trim() || "Pest control in Charlotte, NC";
const heroTitle = cms?.homeHeroTitle || "We protect your home and business from pests";
const heroSubtitle = cms?.homeHeroSubtitle || "Professional, safe, and guaranteed pest control service. Serving Charlotte and surrounding areas in North Carolina.";
const heroImage = cms?.homeHeroImageUrl || "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1800&q=80";
const primaryCtaText = "Request service";
const primaryCtaUrl = "/en/agendar";
const secondaryCtaText = "View services";
const secondaryCtaUrl = "/en/servicios";

const serviceChips = business.serviceCategories.map((cat) => ({
  key: cat.key,
  label: cat.labelEn,
  href: `/en/servicios`,
}));
---

<Layout
  title={`${businessName} – Pest Control Charlotte NC`}
  description="Professional pest control in Charlotte, NC. Rodents, termites, bed bugs, cockroaches and more. Call us for a free quote!"
>
  <Header />
  <main id="contenido-principal">

    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-sky-950 via-slate-900 to-sky-900 text-white">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-25"
        style={`background-image: url('${heroImage}')`}
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-6xl px-4 py-20 sm:py-28 lg:py-36">
        <div class="max-w-2xl">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-cyan-400">{heroEyebrow}</p>
          <h1 class="font-['Manrope',sans-serif] text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            {heroTitle}
          </h1>
          <p class="mt-5 text-lg font-medium leading-relaxed text-sky-100 sm:text-xl">
            {heroSubtitle}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={primaryCtaUrl} class="btn-base btn-primary px-6 py-3 text-base shadow-[0_8px_24px_-8px_rgba(2,120,210,0.7)]">
              {primaryCtaText}
            </a>
            <a href={secondaryCtaUrl} class="btn-base btn-outline-light px-6 py-3 text-base">
              {secondaryCtaText}
            </a>
          </div>
          <!-- Service chips -->
          <div class="mt-8 flex flex-wrap gap-2">
            {serviceChips.map((chip) => (
              <a
                href={chip.href}
                class="rounded-full border border-sky-400/30 bg-sky-900/40 px-3 py-1 text-xs font-semibold text-sky-200 backdrop-blur-sm transition hover:bg-sky-700/60 hover:text-white"
              >
                {chip.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why us -->
    <section class="bg-white py-16 dark:bg-[rgb(8,20,38)]" data-reveal>
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { icon: "🛡️", title: "Licensed & Insured",   body: "All our technicians are certified and fully insured." },
            { icon: "🔬", title: "Proven Treatments",     body: "Safe, EPA-registered products that eliminate pests at the source." },
            { icon: "⚡", title: "Fast Response",         body: "Same-day or next-day appointments available in Charlotte." },
            { icon: "✅", title: "Guaranteed Results",    body: "We return for free if pests come back within the guarantee period." },
          ].map((card) => (
            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-6 dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
              <p class="mb-2 text-3xl">{card.icon}</p>
              <h3 class="font-['Manrope',sans-serif] text-base font-bold text-slate-900 dark:text-white">{card.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-[rgb(186,205,227)]">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services preview -->
    <section class="bg-slate-50 py-16 dark:bg-[rgb(6,16,30)]" data-reveal>
      <div class="mx-auto max-w-6xl px-4">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">What we do</p>
          <h2 class="font-['Manrope',sans-serif] mt-2 text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl">Our Services</h2>
          <p class="mx-auto mt-3 max-w-xl text-base text-slate-600 dark:text-[rgb(186,205,227)]">
            We offer specialized pest control treatments for homes and businesses in Charlotte, NC.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {business.serviceCategories.map((cat) => (
            <a
              href={`/en/servicios`}
              class="group rounded-xl border border-slate-200 bg-white p-5 transition hover:border-sky-300 hover:shadow-md dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)] dark:hover:border-sky-700"
            >
              <p class="font-['Manrope',sans-serif] font-semibold text-slate-900 group-hover:text-sky-700 dark:text-white dark:group-hover:text-sky-400">
                {cat.labelEn}
              </p>
              <p class="mt-1 text-xs text-slate-500 dark:text-[rgb(150,175,205)]">{cat.label}</p>
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/en/servicios" class="btn-base btn-secondary">View all services</a>
        </div>
      </div>
    </section>

    <!-- Promotions (if any) -->
    {activePromos.length > 0 && (
      <section class="bg-white py-16 dark:bg-[rgb(8,20,38)]" data-reveal>
        <div class="mx-auto max-w-6xl px-4">
          <div class="mb-8 text-center">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Limited time</p>
            <h2 class="font-['Manrope',sans-serif] mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">Special Offers</h2>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {activePromos.slice(0, 3).map((promo: any) => (
              <div class="rounded-xl border border-amber-100 bg-amber-50 p-5 dark:border-[rgb(80,60,20)] dark:bg-[rgb(28,22,8)]">
                <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">{promo.label || "Special offer"}</p>
                <h3 class="font-['Manrope',sans-serif] mt-1 font-bold text-slate-900 dark:text-white">{promo.title}</h3>
                {promo.shortDescription && (
                  <p class="mt-2 text-sm text-slate-600 dark:text-[rgb(186,205,227)]">{promo.shortDescription}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Google Reviews -->
    {googleReviews && googleReviews.reviews?.length > 0 && (
      <section class="bg-slate-50 py-16 dark:bg-[rgb(6,16,30)]" data-reveal>
        <div class="mx-auto max-w-6xl px-4">
          <div class="mb-8 text-center">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Customer reviews</p>
            <h2 class="font-['Manrope',sans-serif] mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">What our clients say</h2>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {googleReviews.reviews.map((review: any) => (
              <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
                <div class="flex items-center gap-3">
                  <img src={review.profilePhotoUrl} alt={review.authorName} class="h-9 w-9 rounded-full" loading="lazy" />
                  <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">{review.authorName}</p>
                    <p class="text-xs text-amber-500">{"★".repeat(review.rating)}</p>
                  </div>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-[rgb(186,205,227)]">
                  {review.text?.slice(0, 140)}{review.text?.length > 140 ? "…" : ""}
                </p>
              </div>
            ))}
          </div>
          <div class="mt-8 text-center">
            <a
              href={googleReviews.googleMapsUrl || cms?.mapsUrl || business.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-base btn-secondary"
            >
              See Google reviews
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="bg-sky-700 py-14 text-white dark:bg-sky-900" data-reveal>
      <div class="mx-auto max-w-2xl px-4 text-center">
        <h2 class="font-['Manrope',sans-serif] text-3xl font-extrabold">Ready to get rid of pests?</h2>
        <p class="mt-3 text-lg font-medium text-sky-100">
          Request your service today and our team will be there fast.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/en/agendar" class="btn-base bg-white px-6 py-3 font-bold text-sky-700 hover:bg-sky-50">Request service</a>
          <a href="/en/servicios" class="btn-base border border-white/60 px-6 py-3 font-semibold text-white hover:bg-white/10">View services</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getPrices } from "../../lib/sanity.js";
import { business } from "../../config/clinic";
import { getCategoryLabelEn } from "../../utils/category";
import { moneyUSD } from "../../utils/format";

type PriceRow = {
  _id?: string;
  title?: string;
  serviceTitle?: string;
  category?: string;
  priceFrom?: number;
  duration?: string;
  note?: string;
};

const cms = await getBusinessInfo();
const prices: PriceRow[] = (await getPrices()) || [];
const businessName = cms?.name || business.name;

const categories = [
  { key: "all",       label: "All"              },
  { key: "roedores",  label: "Rodents"          },
  { key: "cucarachas",label: "Cockroaches"      },
  { key: "termitas",  label: "Termites"         },
  { key: "chinches",  label: "Bed Bugs"         },
  { key: "hormigas",  label: "Ants"             },
  { key: "avispas",   label: "Wasps & Bees"     },
  { key: "inspeccion",label: "Inspection"       },
  { key: "general",   label: "General"          },
];

function getPriceLabel(item: PriceRow) {
  return item.serviceTitle || item.title || "Service";
}
---

<Layout
  title={`Pricing – ${businessName}`}
  description={`Transparent pest control pricing in Charlotte, NC. No hidden fees. Get a free quote from ${businessName} today.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-14 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Transparent rates</p>
        <h1 class="mt-2 font-['Manrope',sans-serif] text-4xl font-extrabold text-slate-900 sm:text-5xl dark:text-white">
          Pricing
        </h1>
        <p class="mt-3 max-w-xl text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          No hidden fees. Final price may vary based on space size and infestation level.
          <a href="/en/agendar" class="font-semibold text-red-700 hover:underline dark:text-red-400">Contact us</a> for a free quote.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-5xl px-4">

        {prices.length === 0 ? (
          <div class="rounded-2xl border border-slate-100 bg-white p-10 text-center dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
            <p class="text-slate-500 dark:text-[rgb(240,190,190)]">Pricing details coming soon. Contact us for a custom quote.</p>
            <a href="/en/agendar" class="btn-base btn-primary mt-5 inline-block">Request a quote</a>
          </div>
        ) : (
          <>
            <div class="mt-4 flex flex-wrap gap-2" id="price-filters">
              {categories.map((cat, idx) => (
                <button
                  type="button"
                  data-price-filter={cat.key}
                  class:list={["category-chip", idx === 0 && "category-chip--active"]}
                >
                  {cat.label}
                </button>
              ))}
            </div>

            <div class="mt-8 space-y-4" id="price-list">
              {prices.map((item) => {
                const label = getPriceLabel(item);
                const cat = item.category || "general";
                const catLabel = getCategoryLabelEn(cat);
                return (
                  <article
                    data-price-card
                    data-category={cat}
                    class="flex flex-col gap-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition hover:shadow-md sm:flex-row sm:items-center sm:justify-between dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]"
                  >
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="font-semibold text-slate-900 dark:text-white">{label}</h3>
                        <span class="rounded-full border border-red-200 bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 dark:border-red-800 dark:bg-red-900/30 dark:text-red-300">
                          {catLabel}
                        </span>
                      </div>
                      {item.note && (
                        <p class="mt-1 text-sm text-slate-500 dark:text-[rgb(210,170,170)]">{item.note}</p>
                      )}
                    </div>
                    <div class="flex shrink-0 items-center gap-6">
                      <div class="text-right">
                        {item.priceFrom != null && (
                          <p class="text-lg font-bold text-red-700 dark:text-red-400">{moneyUSD(item.priceFrom)}</p>
                        )}
                        {item.duration && (
                          <p class="text-xs text-slate-500 dark:text-[rgb(210,170,170)]">{item.duration}</p>
                        )}
                      </div>
                      <a
                        href={`/en/agendar?service=${encodeURIComponent(cat)}&services=${encodeURIComponent(label)}`}
                        class="btn-base btn-primary shrink-0 text-sm"
                      >
                        Request
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>

            <div id="price-empty" class="mt-8 hidden rounded-2xl border border-slate-100 bg-white p-8 text-center dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
              <p class="text-slate-500 dark:text-[rgb(240,190,190)]">No services in this category yet.</p>
            </div>
          </>
        )}

      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll("[data-price-filter]"));
    const cards = Array.from(document.querySelectorAll("[data-price-card]"));
    const empty = document.getElementById("price-empty");

    const setFilter = (key) => {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "general";
        const show = key === "all" || cat === key;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      if (empty) empty.classList.toggle("hidden", visible > 0);
      buttons.forEach((btn) => {
        btn.classList.toggle("category-chip--active", btn.getAttribute("data-price-filter") === key);
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => setFilter(btn.getAttribute("data-price-filter") || "all"));
    });
  })();
</script>

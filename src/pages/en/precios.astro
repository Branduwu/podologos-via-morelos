---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getPrices } from "../../lib/sanity.js";
import { business } from "../../config/clinic";
import { getCategoryLabelEn } from "../../utils/category";

type PriceItem = {
  _id?: string;
  title?: string;
  titleEn?: string;
  short?: string;
  shortEn?: string;
  priceFrom?: number;
  duration?: string;
  category?: string;
  note?: string;
};

const cms = await getBusinessInfo();
const prices: PriceItem[] = (await getPrices()) || [];
const businessName = cms?.name || business.name;
---

<Layout
  title={`Pricing – ${businessName}`}
  description="Transparent pest control pricing in Charlotte, NC. No hidden fees. Get a free quote today."
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-16 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Transparent rates</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white sm:text-5xl">Pricing</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          No hidden fees. Final price may vary based on space size and infestation level. Contact us for a free quote.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-5xl px-4">
        {prices.length === 0 ? (
          <div class="rounded-2xl border border-slate-100 bg-white p-10 text-center dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
            <p class="text-slate-500 dark:text-[rgb(240,190,190)]">Pricing details coming soon. Contact us for a custom quote.</p>
            <a href="/en/agendar" class="btn-base btn-primary mt-5 inline-block">Request a quote</a>
          </div>
        ) : (
          <div class="overflow-hidden rounded-2xl border border-slate-100 dark:border-[rgb(36,58,86)]" data-reveal>
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-100 bg-slate-50 dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                  <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-[rgb(240,190,190)]">Service</th>
                  <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-[rgb(240,190,190)]">Category</th>
                  <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-[rgb(240,190,190)]">From (USD)</th>
                  <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-[rgb(240,190,190)]">Duration</th>
                  <th class="px-5 py-3"></th>
                </tr>
              </thead>
              <tbody>
                {prices.map((item) => {
                  const title = item.titleEn || item.title || "Service";
                  const desc = item.shortEn || item.short || "";
                  const cat = getCategoryLabelEn(item.category);
                  return (
                    <tr class="border-b border-slate-50 bg-white transition hover:bg-red-50/30 dark:border-[rgb(50,12,12)] dark:bg-[rgb(28,5,5)] dark:hover:bg-[rgb(28,6,6)]">
                      <td class="px-5 py-4">
                        <p class="font-semibold text-slate-900 dark:text-white">{title}</p>
                        {desc && <p class="mt-0.5 text-xs text-slate-500 dark:text-[rgb(240,190,190)]">{desc}</p>}
                      </td>
                      <td class="px-5 py-4 text-slate-600 dark:text-[rgb(245,210,210)]">{cat}</td>
                      <td class="px-5 py-4 text-right font-semibold text-red-700 dark:text-red-400">
                        {item.priceFrom != null ? `$${item.priceFrom}` : "–"}
                      </td>
                      <td class="px-5 py-4 text-right text-slate-500 dark:text-[rgb(240,190,190)]">
                        {item.duration || "–"}
                      </td>
                      <td class="px-5 py-4 text-right">
                        <a href="/en/agendar" class="text-xs font-semibold text-red-700 hover:underline dark:text-red-400">
                          Request
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getBusinessInfo, getSpecialists } from "../../../lib/sanity.js";
import { business } from "../../../config/clinic";
import { resolveWhatsAppNumber } from "../../../utils/whatsapp";
import { getCategoryLabelEn } from "../../../utils/category";

type Technician = {
  _id?: string;
  name?: string;
  specialty?: string;
  specialtyEn?: string;
  shortBio?: string;
  shortBioEn?: string;
  focusAreas?: string[];
  focusAreasEn?: string[];
  photoUrl?: string;
  ctaText?: string;
  ctaTextEn?: string;
  ctaUrl?: string;
  useWhatsAppButton?: boolean;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  specialtyCategory?: string;
  slug?: string | { current?: string };
};

const cms = await getBusinessInfo();
const technicians: Technician[] = (await getSpecialists()) || [];
const businessName = cms?.name || business.name;
const waFallback = resolveWhatsAppNumber(cms?.whatsappSpecialistsNumber, business.whatsappNumber);

const getSlug = (t: Technician) =>
  typeof t.slug === "string" ? t.slug : t.slug?.current || "";
---

<Layout
  title={`Technicians – ${businessName}`}
  description={`Meet our certified pest control technicians at ${businessName} in Charlotte, NC.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-16 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Our team</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">Technicians</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          Our licensed and certified pest control specialists.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-5xl px-4">
        {technicians.length === 0 ? (
          <p class="text-slate-500 dark:text-[rgb(240,190,190)]">Technician profiles coming soon.</p>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
            {technicians.map((tech) => {
              const specialty = tech.specialtyEn || tech.specialty || "";
              const bio = tech.shortBioEn || tech.shortBio || "";
              const areas = tech.focusAreasEn || tech.focusAreas || [];
              const ctaLabel = tech.ctaTextEn || tech.ctaText || "Request this technician";
              const waNum = resolveWhatsAppNumber(tech.whatsAppNumber, waFallback);
              const waMsg = encodeURIComponent(
                tech.whatsAppMessage ||
                `Hi, I'd like to request service with ${tech.name || "your technician"} at ${businessName}.`
              );
              const ctaHref = tech.useWhatsAppButton && waNum
                ? `https://wa.me/${waNum}?text=${waMsg}`
                : (tech.ctaUrl || `/en/agendar${getSlug(tech) ? `?technician=${getSlug(tech)}` : ""}`);
              const isExternal = ctaHref.startsWith("https://wa.me");
              return (
                <div class="rounded-2xl border border-slate-100 bg-white shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                  {tech.photoUrl ? (
                    <img
                      src={tech.photoUrl}
                      alt={tech.name || "Technician"}
                      class="h-48 w-full rounded-t-2xl object-cover"
                      loading="lazy"
                      data-fallback-src="/placeholder.jpg"
                    />
                  ) : (
                    <div class="flex h-48 w-full items-center justify-center rounded-t-2xl bg-red-100 dark:bg-[rgb(24,6,6)]">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-red-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7z" />
                      </svg>
                    </div>
                  )}
                  <div class="p-5">
                    <h3 class="font-['Manrope',sans-serif] font-bold text-slate-900 dark:text-white">{tech.name}</h3>
                    {specialty && (
                      <p class="mt-0.5 text-sm font-medium text-red-700 dark:text-red-400">{specialty}</p>
                    )}
                    {getCategoryLabelEn(tech.specialtyCategory) && (
                      <span class="mt-2 inline-block rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 dark:bg-[rgb(24,6,6)] dark:text-red-400">
                        {getCategoryLabelEn(tech.specialtyCategory)}
                      </span>
                    )}
                    {bio && <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-[rgb(245,210,210)]">{bio.slice(0, 160)}{bio.length > 160 ? "…" : ""}</p>}
                    {areas.length > 0 && (
                      <ul class="mt-3 space-y-1">
                        {areas.slice(0, 4).map((area: string) => (
                          <li class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-[rgb(245,200,200)]">
                            <span class="text-red-400">✓</span> {area}
                          </li>
                        ))}
                      </ul>
                    )}
                    <a
                      href={ctaHref}
                      target={isExternal ? "_blank" : undefined}
                      rel={isExternal ? "noopener noreferrer" : undefined}
                      class="btn-base btn-primary mt-5 w-full text-center text-sm"
                    >
                      {ctaLabel}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

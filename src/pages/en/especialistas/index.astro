---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { business as businessConfig } from "../../../config/clinic";
import { getBusinessInfo, getSpecialists } from "../../../lib/sanity.js";
import { normalizeServiceSlug } from "../../../utils/prefill";
import { normalizeCategory } from "../../../utils/category";
import {
  buildContactMessage,
  buildWhatsAppUrl,
  resolveWhatsAppNumber,
  resolveWhatsAppReason,
} from "../../../utils/whatsapp";

type Specialist = {
  _id?: string;
  slug?: string;
  name?: string;
  specialty?: string;
  specialtyEn?: string;
  specialtyCategory?: string;
  shortBio?: string;
  shortBioEn?: string;
  focusAreas?: string[];
  focusAreasEn?: string[];
  ctaText?: string;
  ctaTextEn?: string;
  ctaUrl?: string;
  useWhatsAppButton?: boolean;
  whatsAppNumber?: string;
  whatsAppMessage?: string;
  photoUrl?: string;
};

const business = await getBusinessInfo();
const specialists: Specialist[] = (await getSpecialists()) || [];

function specialistHref(specialist: Specialist) {
  return `/en/especialistas/${encodeURIComponent((specialist?.slug || specialist?._id || "").trim())}`;
}

const specialistCategories = [
  { key: "all",        label: "All" },
  { key: "roedores",   label: "Rodents" },
  { key: "cucarachas", label: "Cockroaches" },
  { key: "termitas",   label: "Termites" },
  { key: "chinches",   label: "Bed Bugs" },
  { key: "hormigas",   label: "Ants" },
  { key: "avispas",    label: "Wasps" },
  { key: "inspeccion", label: "Inspection" },
  { key: "general",    label: "General" },
];

function specialistCategoryKey(specialty: string | undefined) {
  const text = normalizeCategory(specialty || "");
  if (!text) return "general";
  if (text.includes("roed") || text.includes("rata") || text.includes("raton")) return "roedores";
  if (text.includes("cucar")) return "cucarachas";
  if (text.includes("termit")) return "termitas";
  if (text.includes("chinch")) return "chinches";
  if (text.includes("hormig")) return "hormigas";
  if (text.includes("avispa") || text.includes("abeja")) return "avispas";
  if (text.includes("inspec")) return "inspeccion";
  return "general";
}

function specialistCategoryFromData(specialist: Specialist) {
  const fromCms = normalizeCategory(specialist.specialtyCategory || "");
  if (["roedores", "cucarachas", "termitas", "chinches", "hormigas", "avispas", "inspeccion", "general"].includes(fromCms)) return fromCms;
  return specialistCategoryKey(specialist.specialty);
}

const generalWaNumber = resolveWhatsAppNumber(
  business?.whatsappCitasNumber,
  businessConfig.whatsappNumber
);
const specialistsWaNumber = resolveWhatsAppNumber(
  business?.whatsappSpecialistsNumber,
  generalWaNumber
);

function agendarSpecialistHref(specialist: Specialist) {
  const service = normalizeServiceSlug(specialist.specialtyCategory || specialist.specialty || "");
  const slug = (specialist.slug || specialist._id || "").trim();
  const serviceName = (specialist.specialtyEn || specialist.specialty || "").trim();
  const params = new URLSearchParams();
  if (service) params.set("service", service);
  if (slug) params.set("specialist", slug);
  if (serviceName) params.append("services", serviceName);
  const qs = params.toString();
  return qs ? `/en/agendar?${qs}` : "/en/agendar";
}

function specialistWhatsAppHref(specialist: Specialist) {
  const waNumber = resolveWhatsAppNumber(
    specialist?.whatsAppNumber,
    specialistsWaNumber
  );
  const customReasonRaw = String(specialist.whatsAppMessage || "").trim();
  const reason = resolveWhatsAppReason(
    customReasonRaw || business?.whatsappSpecialistsMessage,
    "Hi, I'd like to schedule with {especialista} at {negocio}. Do you have availability?",
    {
      specialist: specialist.name || "this technician",
      service: specialist.specialtyEn || specialist.specialty || "Technician",
      business: business?.name || businessConfig.name,
      problem: business?.whatsappQuickProblemDefault || "",
    }
  );

  return buildWhatsAppUrl(
    buildContactMessage({
      service: specialist.specialtyEn || specialist.specialty || "Technician",
      reason,
    }),
    waNumber
  );
}

function canUseSpecialistWhatsApp(specialist: Specialist) {
  const waNumber = resolveWhatsAppNumber(
    specialist?.whatsAppNumber,
    specialistsWaNumber
  );
  return specialist.useWhatsAppButton !== false && Boolean(waNumber);
}
---

<Layout
  title={`Technicians | ${business?.name || "FumiPro NC"}`}
  description={`Meet the certified team at ${business?.name || "FumiPro NC"} in ${business?.area || "Charlotte, NC"}. Licensed pest control technicians.`}
>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="max-w-4xl text-left text-3xl font-bold tracking-tight md:text-4xl">Our Technicians</h1>
    <p class="mt-2 max-w-4xl text-left text-slate-800 dark:text-slate-200">
      Meet the certified team that protects your home or business in Charlotte, NC.
    </p>

    {specialists.length === 0 ? (
      <div class="mt-6 max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 text-left text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
        We'll share specialist profiles soon.
      </div>
    ) : (
      <>
        <div class="mt-6 flex flex-wrap gap-2" id="specialist-filters">
          {specialistCategories.map((cat, idx) => (
            <button
              type="button"
              data-specialist-filter={cat.key}
              class:list={[
                "category-chip",
                idx === 0 && "category-chip--active",
              ]}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="specialists-list">
          {specialists.map((specialist: Specialist) => (
            <article
              data-specialist-card
              data-category={specialistCategoryFromData(specialist)}
              class="card-surface overflow-hidden rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg flex h-full flex-col"
            >
              <img
                class="h-56 w-full object-cover"
                src={specialist.photoUrl || "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=1000&q=80"}
                alt={specialist.name || "Technician"}
                loading="lazy"
                data-fallback-src="/placeholder.jpg"
              />
              <div class="flex flex-1 flex-col p-5">
                <h2 class="text-lg font-bold">{specialist.name || "Technician"}</h2>
                <p class="mt-1 text-sm font-semibold text-red-700 dark:text-red-300">
                  {specialist.specialtyEn || specialist.specialty || "Specialty"}
                </p>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                  {specialist.shortBioEn || specialist.shortBio || "Profile available soon."}
                </p>

                {Array.isArray(specialist.focusAreasEn || specialist.focusAreas) &&
                  (specialist.focusAreasEn || specialist.focusAreas || []).length > 0 && (
                  <ul class="mt-3 space-y-1 text-sm text-slate-600 dark:text-slate-300">
                    {(specialist.focusAreasEn || specialist.focusAreas || []).slice(0, 4).map((area: string) => (
                      <li class="truncate">- {area}</li>
                    ))}
                  </ul>
                )}

                <div class="mt-4 grid gap-2 pt-1 md:mt-auto">
                  <a class="btn-base btn-primary w-full" href={specialistHref(specialist)}>
                    View profile
                  </a>
                  <a
                    class="btn-base btn-secondary w-full"
                    href={agendarSpecialistHref(specialist)}
                  >
                    Request this technician
                  </a>
                  {canUseSpecialistWhatsApp(specialist) && (
                    <a
                      class="btn-base btn-secondary w-full"
                      href={specialistWhatsAppHref(specialist)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      WhatsApp
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    <p id="specialists-empty" class="mt-6 hidden max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 text-left text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
      No specialists in that category yet.
    </p>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const specialistFilterButtons = Array.from(document.querySelectorAll("[data-specialist-filter]"));
  const specialistCards = Array.from(document.querySelectorAll("[data-specialist-card]"));
  const specialistEmpty = document.getElementById("specialists-empty");
  let activeSpecialistFilter = "all";

  const animateFilteredItems = (items) => {
    items.forEach((item, index) => {
      item.classList.remove("filter-item-in", "filter-item-in-slide");
      item.style.animationDelay = `${Math.min(index, 10) * 45}ms`;
      void item.offsetWidth;
      item.classList.add("filter-item-in-slide");
    });
  };

  const updateSpecialistFilterUI = () => {
    specialistFilterButtons.forEach((btn) => {
      const isActive = btn.dataset.specialistFilter === activeSpecialistFilter;
      btn.classList.toggle("category-chip--active", isActive);
    });
  };

  const applySpecialistFilter = (animate = false) => {
    let visibleCount = 0;
    const visibleCards = [];

    specialistCards.forEach((card) => {
      const category = card.dataset.category || "general";
      const visible = activeSpecialistFilter === "all" || category === activeSpecialistFilter;
      card.classList.toggle("hidden", !visible);
      if (visible) {
        visibleCount += 1;
        visibleCards.push(card);
      }
    });

    if (specialistEmpty) specialistEmpty.classList.toggle("hidden", visibleCount > 0);
    if (animate) requestAnimationFrame(() => animateFilteredItems(visibleCards));
  };

  specialistFilterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeSpecialistFilter = btn.dataset.specialistFilter || "all";
      updateSpecialistFilterUI();
      applySpecialistFilter(true);
    });
  });

  updateSpecialistFilterUI();
  applySpecialistFilter(false);
</script>

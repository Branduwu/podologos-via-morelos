---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo } from "../../lib/sanity.js";
import { business as businessConfig } from "../../config/clinic";
import { resolveWhatsAppNumber, buildWhatsAppUrl, buildContactMessage, resolveWhatsAppReason } from "../../utils/whatsapp";
import { safeCmsUrl } from "../../utils/url";

const cms = await getBusinessInfo();
const businessName = cms?.name || businessConfig.name;
const phone = cms?.phone || businessConfig.phoneDisplay;
const phoneTel = String(phone).replace(/\D/g, "") || businessConfig.phoneTel;
const address = cms?.address || businessConfig.address;
const mapsUrl = safeCmsUrl(cms?.mapsUrl, businessConfig.googleMapsUrl);
const weekdayHours = cms?.weekdayHours || "8 a.m. – 5 p.m.";
const saturdayHours = cms?.saturdayHours || "8 a.m. – 12 p.m.";
const sundayOpen = Boolean(cms?.sundayOpen);
const sundayHours = cms?.sundayHours || "";
const waNumber = resolveWhatsAppNumber(cms?.whatsappCitasNumber, businessConfig.whatsappNumber);
const waNumberClean = String(waNumber || "").replace(/\D/g, "");

const waMessage = buildContactMessage({
  reason: resolveWhatsAppReason(
    cms?.whatsappGeneralMessage,
    "Hi, I'd like to get information about pest control services at {negocio}. Can you help me?",
    { business: businessName, problem: "" }
  ),
});
const waLink = waNumberClean ? buildWhatsAppUrl(waMessage, waNumber) : null;

const facebookUrl = safeCmsUrl(cms?.facebookUrl, "");
const instagramUrl = safeCmsUrl(cms?.instagramUrl, "");
const tiktokUrl = safeCmsUrl(cms?.tiktokUrl, "");
const socials = [
  { label: "Facebook", url: facebookUrl, color: "text-blue-700 dark:text-blue-300" },
  { label: "Instagram", url: instagramUrl, color: "text-pink-700 dark:text-pink-300" },
  { label: "TikTok", url: tiktokUrl, color: "text-slate-800 dark:text-slate-200" },
].filter((x) => Boolean(x.url));

const serviceChips = businessConfig.serviceCategories.map((cat: any) => ({
  key: cat.key,
  label: cat.labelEn || cat.label,
}));
---

<Layout
  title={`Contact – ${businessName}`}
  description={`Contact ${businessName} for pest control services in Charlotte, NC. Phone, WhatsApp, and address.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-14 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-4xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Let's talk</p>
        <h1 class="mt-2 font-['Manrope',sans-serif] text-4xl font-extrabold text-slate-900 dark:text-white">Contact Us</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          We're here to help. Reach us by phone, WhatsApp, or come visit us in Charlotte, NC.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-4xl px-4">
        <div class="grid gap-6 lg:grid-cols-[1fr_320px]">

          <!-- Main contact card -->
          <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Contact information</h2>
            <div class="mt-4 space-y-3 text-sm text-slate-700 dark:text-[rgb(248,220,220)]">
              <p><span class="font-semibold">Address:</span> {address}</p>
              <p><span class="font-semibold">Phone:</span> <a href={`tel:${phoneTel}`} class="text-red-700 hover:underline dark:text-red-400">{phone}</a></p>
              {waNumber && <p><span class="font-semibold">WhatsApp:</span> <a href={waLink || "#"} target="_blank" rel="noopener noreferrer" class="text-red-700 hover:underline dark:text-red-400">{waNumber}</a></p>}
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
              {waLink && (
                <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-base btn-primary">
                  Send WhatsApp
                </a>
              )}
              {mapsUrl && (
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-base btn-secondary">
                  Get directions
                </a>
              )}
            </div>

            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
              <a href={`tel:${phoneTel}`} class="text-red-700 hover:underline dark:text-red-400">Call us</a>
              <a href="/en/agendar" class="text-red-700 hover:underline dark:text-red-400">Book online</a>
              <button id="copy-address-en" type="button" class="text-red-700 hover:underline dark:text-red-400">Copy address</button>
            </div>

            <!-- Service chips -->
            <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-[rgb(36,10,10)] dark:bg-[rgb(24,5,5)]">
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">Ask about a service</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {serviceChips.map((chip: any) => {
                  const msg = buildContactMessage({
                    service: chip.label,
                    reason: `Hi, I'm interested in ${chip.label} pest control at ${businessName}. Do you have availability?`,
                  });
                  const href = waNumberClean ? buildWhatsAppUrl(msg, waNumber) : "/en/agendar";
                  return (
                    <a
                      href={href}
                      target={waNumberClean ? "_blank" : undefined}
                      rel={waNumberClean ? "noopener noreferrer" : undefined}
                      class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-red-50 hover:border-red-300 hover:text-red-700 dark:border-[rgb(60,18,18)] dark:text-[rgb(248,220,220)] dark:hover:bg-[rgb(32,8,8)]"
                    >
                      {chip.label}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>

          <!-- Sidebar: hours + social -->
          <div class="space-y-5">
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">Hours</p>
              <div class="mt-3 space-y-2 text-sm font-medium text-slate-700 dark:text-[rgb(248,220,220)]">
                <p>Mon – Fri: {weekdayHours}</p>
                {saturdayHours && <p>Saturday: {saturdayHours}</p>}
                {sundayOpen && sundayHours
                  ? <p>Sunday: {sundayHours}</p>
                  : <p class="text-slate-400 dark:text-[rgb(210,135,135)]">Sunday: Closed</p>
                }
              </div>
            </div>

            {socials.length > 0 && (
              <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-[rgb(240,190,190)]">Social media</p>
                <div class="mt-4 space-y-3">
                  {socials.map((s) => (
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-3 rounded-xl border border-slate-100 px-4 py-3 text-sm font-medium hover:bg-slate-50 dark:border-[rgb(36,10,10)] dark:hover:bg-[rgb(32,8,8)]"
                    >
                      <span class={`font-bold ${s.color}`}>{s.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ address }}>
  const btn = document.getElementById("copy-address-en");
  if (btn) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(String(address || ""));
        btn.textContent = "Address copied!";
      } catch {
        btn.textContent = "Couldn't copy";
      }
      setTimeout(() => { btn.textContent = "Copy address"; }, 1600);
    });
  }
</script>

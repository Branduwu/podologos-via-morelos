---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo } from "../../lib/sanity.js";
import { business as businessConfig } from "../../config/clinic";
import {
  buildContactMessage,
  buildWhatsAppUrl,
  resolveWhatsAppNumber,
  resolveWhatsAppReason,
} from "../../utils/whatsapp";
import { safeCmsUrl } from "../../utils/url";

const business = await getBusinessInfo();
const facebookUrl = safeCmsUrl(business?.facebookUrl, "");
const instagramUrl = safeCmsUrl(business?.instagramUrl, "");
const tiktokUrl = safeCmsUrl(business?.tiktokUrl, "");
const socials = [
  { label: "Facebook", url: facebookUrl },
  { label: "Instagram", url: instagramUrl },
  { label: "TikTok", url: tiktokUrl },
].filter((x) => Boolean(x.url));

const address = business?.address || businessConfig.address;
const phoneDisplay = business?.phone || businessConfig.phoneDisplay;
const phoneTel = String(phoneDisplay).replace(/\D/g, "") || businessConfig.phoneTel;
const waNumber = resolveWhatsAppNumber(business?.whatsappCitasNumber, businessConfig.whatsappNumber);
const mapsUrl = safeCmsUrl(business?.mapsUrl, businessConfig.googleMapsUrl);

const serviceChips = businessConfig.serviceCategories.map((item: { key: string; label: string; labelEn: string }) => ({
  key: item.key,
  label: item.labelEn || item.label,
}));

function socialHandle(rawUrl: string): string {
  try {
    const url = new URL(rawUrl);
    const path = url.pathname.replace(/\/+$/, "");
    const last = path.split("/").filter(Boolean).pop();
    if (!last) return rawUrl;
    return last.startsWith("@") ? last : `@${last}`;
  } catch {
    return rawUrl;
  }
}

const primaryWaMessage = buildContactMessage({
  reason: resolveWhatsAppReason(
    business?.whatsappGeneralMessage,
    "Hi, I'd like to schedule a service at {negocio}. Can you help me?",
    {
      business: business?.name || businessConfig.name,
      problem: business?.whatsappQuickProblemDefault || "",
    }
  ),
});
const waPrimaryHref = buildWhatsAppUrl(primaryWaMessage, waNumber);

const socialItems = [
  { label: "Facebook", value: safeCmsUrl(business?.facebookUrl, "") },
  { label: "Instagram", value: safeCmsUrl(business?.instagramUrl, "") },
  { label: "TikTok", value: safeCmsUrl(business?.tiktokUrl, "") },
]
  .filter((x) => Boolean(x.value))
  .map((x) => ({ ...x, handle: socialHandle(String(x.value)) }));
---

<Layout title={`Contact | ${business?.name || "FumiPro NC"} Charlotte`} description="Contact us to schedule and ask questions about our services.">
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Contact</h1>
    <p class="mt-2 text-slate-800 dark:text-slate-200">We're here to help. We answer questions and guide you to request your pest control service.</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <!-- Contact CTA (EN version) — same structure as ContactCTA.astro -->
      <section class="card-surface rounded-2xl p-6">
        <h2 class="text-xl font-semibold">Contact</h2>
        <div class="mt-4 grid gap-2 text-sm text-slate-700 dark:text-slate-300">
          <p><span class="font-semibold">Address:</span> {address}</p>
          <p><span class="font-semibold">Phone:</span> <a class="text-red-700 hover:underline dark:text-red-300" href={`tel:${phoneTel}`}>{phoneDisplay}</a></p>
          <p><span class="font-semibold">WhatsApp:</span> <a class="text-red-700 hover:underline dark:text-red-300" href={waPrimaryHref} target="_blank" rel="noopener noreferrer">{waNumber}</a></p>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <a class="btn-base btn-primary w-full" href={waPrimaryHref} target="_blank" rel="noopener noreferrer">Send WhatsApp</a>
          <a class="btn-base btn-secondary w-full" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get directions</a>
        </div>

        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
          <a class="link-inline" href={`tel:${phoneTel}`}>Call us</a>
          <a class="link-inline" href="/en/agendar">Book online</a>
          <button id="copy-address-contact-en" type="button" class="link-inline">Copy address</button>
        </div>

        <div class="mt-5 rounded-2xl border border-slate-200/90 bg-slate-50/90 p-4 dark:border-slate-800 dark:bg-slate-900/60">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Select a service</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {serviceChips.map((chip: { key: string; label: string }) => {
              const href = buildWhatsAppUrl(
                buildContactMessage({
                  service: chip.label,
                  reason: resolveWhatsAppReason(
                    business?.whatsappGeneralMessage,
                    `Hi, I'm interested in ${chip.label} at {negocio}. Do you have availability?`,
                    {
                      service: chip.label,
                      business: business?.name || businessConfig.name,
                      problem: business?.whatsappQuickProblemDefault || "",
                    }
                  ),
                }),
                waNumber
              );
              return (
                <a
                  class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {chip.label}
                </a>
              );
            })}
          </div>
        </div>

        {socialItems.length > 0 && (
          <div class="mt-6 border-t border-slate-200 pt-4 dark:border-slate-800">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Social media</p>
            <div class="mt-2 flex flex-wrap gap-2 text-sm">
              {socialItems.map((item) => (
                <a class="text-red-700 hover:underline dark:text-red-300" href={item.value} target="_blank" rel="noopener noreferrer">
                  {item.label}: {item.handle}
                </a>
              ))}
            </div>
          </div>
        )}
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-950">
        <h2 class="text-xl font-semibold">Social networks</h2>
        {socials.length === 0 ? (
          <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">No social accounts configured yet.</p>
        ) : (
          <div class="mt-4 grid gap-3">
          {socials.some((s) => s.label === "Facebook") && (
          <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M13 9h3V6h-3c-2.8 0-5 2.2-5 5v2H6v3h2v5h3v-5h3l1-3h-4v-2c0-1.1.9-2 2-2z"/></svg>
            </span>
            <span>Facebook</span>
          </a>
          )}
          {socials.some((s) => s.label === "Instagram") && (
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-pink-100 text-pink-700 dark:bg-pink-900/30 dark:text-pink-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm10.5 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
            </span>
            <span>Instagram</span>
          </a>
          )}
          {socials.some((s) => s.label === "TikTok") && (
          <a href={tiktokUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M14 3c.4 1.7 1.8 3 3.5 3.2V9c-1.4-.1-2.6-.6-3.5-1.4V14a6 6 0 1 1-5.4-6v2.8a3.2 3.2 0 1 0 2.6 3.2V3H14z"/></svg>
            </span>
            <span>TikTok</span>
          </a>
          )}
        </div>
        )}
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ address }}>
  const copyBtn = document.getElementById("copy-address-contact-en");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(String(address || ""));
        copyBtn.textContent = "Address copied";
      } catch {
        copyBtn.textContent = "Could not copy";
      }
      setTimeout(() => {
        copyBtn.textContent = "Copy address";
      }, 1600);
    });
  }
</script>

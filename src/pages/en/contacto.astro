---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo } from "../../lib/sanity.js";
import { business } from "../../config/clinic";
import { resolveWhatsAppNumber } from "../../utils/whatsapp";

const cms = await getBusinessInfo();
const businessName = cms?.name || business.name;
const phone = cms?.phone || business.phoneDisplay;
const address = cms?.address || business.address;
const weekdayHours = cms?.weekdayHours || "8 a.m. – 5 p.m.";
const saturdayHours = cms?.saturdayHours || "8 a.m. – 12 p.m.";
const waNumber = resolveWhatsAppNumber(cms?.whatsappCitasNumber, business.whatsappNumber);
const waLink = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent(`Hi, I'd like to get information about ${businessName}'s pest control services.`)}`
  : null;
---

<Layout
  title={`Contact – ${businessName}`}
  description={`Contact ${businessName} for pest control services in Charlotte, NC. Phone, WhatsApp, and address.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-sky-50 to-white py-16 dark:from-[rgb(6,16,30)] dark:to-[rgb(8,20,38)]">
      <div class="mx-auto max-w-4xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Let's talk</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">Contact Us</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(186,205,227)]">
          We're here to help. Reach us by phone, WhatsApp, or come visit us in Charlotte, NC.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-4xl px-4">
        <div class="grid gap-6 sm:grid-cols-2">

          {phone && (
            <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
              <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Phone</p>
              <a href={`tel:${business.phoneTel}`} class="font-['Manrope',sans-serif] text-2xl font-bold text-slate-900 hover:text-sky-700 dark:text-white dark:hover:text-sky-400">
                {phone}
              </a>
            </div>
          )}

          {waLink && (
            <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-7 shadow-sm dark:border-[rgb(20,60,40)] dark:bg-[rgb(8,28,20)]">
              <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">WhatsApp</p>
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="font-['Manrope',sans-serif] text-xl font-bold text-emerald-700 hover:text-emerald-600 dark:text-emerald-300"
              >
                Message us on WhatsApp →
              </a>
            </div>
          )}

          <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
            <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Address</p>
            <p class="font-['Manrope',sans-serif] text-lg font-semibold text-slate-900 dark:text-white">{address}</p>
            {cms?.mapsUrl && (
              <a href={cms.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-medium text-sky-700 hover:underline dark:text-sky-400">
                Open in Google Maps →
              </a>
            )}
          </div>

          <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
            <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Hours</p>
            <div class="space-y-1.5 text-sm font-medium text-slate-700 dark:text-[rgb(196,216,240)]">
              <p>Mon – Fri: {weekdayHours}</p>
              <p>Saturday: {saturdayHours}</p>
              <p class="text-slate-400 dark:text-[rgb(120,150,185)]">Sunday: Closed</p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

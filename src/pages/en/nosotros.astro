---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo, getAboutSection, getSpecialists, getServices } from "../../lib/sanity.js";
import { business as businessConfig } from "../../config/clinic";
import { resolveWhatsAppNumber } from "../../utils/whatsapp";
const cms = await getBusinessInfo();
const about = await getAboutSection();
const technicians = (await getSpecialists()) || [];
const services = (await getServices()) || [];
const businessName = cms?.name || businessConfig.name;
const waFallback = resolveWhatsAppNumber(cms?.whatsappSpecialistsNumber, businessConfig.whatsappNumber);

const intro = about?.introEn || about?.intro ||
  `${businessName} is a professional pest control company serving Charlotte, NC and surrounding areas.`;
const secondary = about?.secondaryEn || about?.secondary ||
  "Our team of licensed technicians uses proven, safe treatments to eliminate pests and keep them away for good.";
const keyPoints: string[] = Array.isArray(about?.keyPointsEn) && about.keyPointsEn.length
  ? about.keyPointsEn.filter(Boolean)
  : Array.isArray(about?.keyPoints)
    ? about.keyPoints.filter(Boolean)
    : [
        "Licensed & insured technicians",
        "EPA-registered products",
        "Same-day service available",
        "Serving Charlotte, NC area",
      ];
const mainImage = about?.mainImageUrl || "";

const getSlug = (s: any) =>
  typeof s.slug === "string" ? s.slug : s.slug?.current || "";
---

<Layout
  title={`About Us – ${businessName}`}
  description={`Learn about ${businessName}, a professional pest control company in Charlotte, NC.`}
>
  <Header />
  <main id="contenido-principal">

    <!-- Hero -->
    <section class="bg-gradient-to-b from-red-50 to-white py-14 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Who we are</p>
        <h1 class="mt-2 font-['Manrope',sans-serif] text-4xl font-extrabold text-slate-900 sm:text-5xl dark:text-white">
          About FumiPro NC
        </h1>
        <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="text-lg leading-relaxed text-slate-700 dark:text-[rgb(248,220,220)]">{intro}</p>
            {secondary && (
              <p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-[rgb(245,200,200)]">{secondary}</p>
            )}
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/en/agendar" class="btn-base btn-primary">Request service</a>
              <a href="/en/servicios" class="btn-base btn-secondary">Our services</a>
            </div>
          </div>
          {mainImage && (
            <img
              src={mainImage}
              alt={businessName}
              class="h-64 w-full rounded-2xl object-cover lg:h-72 lg:w-80"
              loading="eager"
              data-fallback-src="/placeholder.jpg"
            />
          )}
        </div>
      </div>
    </section>

    <!-- Why choose us -->
    {keyPoints.length > 0 && (
      <section class="border-t border-slate-100 bg-white py-12 dark:border-[rgb(36,10,10)] dark:bg-[rgb(26,5,5)]">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Why choose us</h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {keyPoints.map((point: string) => (
              <div class="flex items-start gap-2.5 rounded-xl border border-slate-100 bg-slate-50 p-4 dark:border-[rgb(36,10,10)] dark:bg-[rgb(28,6,6)]">
                <span class="mt-0.5 shrink-0 text-red-500">✓</span>
                <span class="text-sm font-medium text-slate-700 dark:text-[rgb(248,220,220)]">{point}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Technicians -->
    {technicians.length > 0 && (
      <section class="py-14">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            {about?.specialistsTitleEn || "Our Technicians"}
          </h2>
          <p class="mt-2 text-slate-600 dark:text-[rgb(245,210,210)]">
            Licensed and certified to protect your family and home in Charlotte, NC.
          </p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {technicians.map((tech: any) => {
              const specialty = tech.specialtyEn || tech.specialty || "";
              const bio = tech.shortBioEn || tech.shortBio || "";
              const waNum = resolveWhatsAppNumber(tech.whatsAppNumber, waFallback);
              const waMsg = encodeURIComponent(
                tech.whatsAppMessage ||
                `Hi, I'd like to request service with ${tech.name || "your technician"} at ${businessName}.`
              );
              const slug = getSlug(tech);
              return (
                <article class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                  {tech.photoUrl ? (
                    <img src={tech.photoUrl} alt={tech.name} class="h-44 w-full object-cover" loading="lazy" data-fallback-src="/placeholder.jpg" />
                  ) : (
                    <div class="flex h-44 w-full items-center justify-center bg-red-50 dark:bg-[rgb(24,6,6)]">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-red-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7z"/>
                      </svg>
                    </div>
                  )}
                  <div class="p-5">
                    <p class="font-bold text-slate-900 dark:text-white">{tech.name}</p>
                    {specialty && <p class="mt-0.5 text-sm font-medium text-red-700 dark:text-red-400">{specialty}</p>}
                    {bio && <p class="mt-2 text-sm text-slate-600 dark:text-[rgb(245,210,210)]">{bio.slice(0, 120)}{bio.length > 120 ? "…" : ""}</p>}
                    <div class="mt-4 flex flex-col gap-2">
                      <a href={`/en/especialistas/${slug || ""}`} class="btn-base btn-secondary w-full text-center text-sm">View profile</a>
                      {waNum && (
                        <a href={`https://wa.me/${String(waNum).replace(/\D/g,"")}?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="btn-base btn-primary w-full text-center text-sm">WhatsApp</a>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Services -->
    {services.length > 0 && (
      <section class="border-t border-slate-100 py-14 dark:border-[rgb(36,10,10)]">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            {about?.servicesTitleEn || "Pest Control Services"}
          </h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {services.slice(0, 6).map((svc: any) => {
              const title = svc.titleEn || svc.title || "Service";
              const desc = svc.shortEn || svc.short || "";
              const slug = getSlug(svc);
              return (
                <div class="rounded-xl border border-slate-100 bg-white p-5 dark:border-[rgb(36,58,86)] dark:bg-[rgb(28,6,6)]">
                  <p class="font-semibold text-slate-900 dark:text-white">{title}</p>
                  {desc && <p class="mt-1 text-sm text-slate-500 dark:text-[rgb(240,190,190)]">{desc.slice(0, 90)}{desc.length > 90 ? "…" : ""}</p>}
                  {svc.priceFrom != null && (
                    <p class="mt-2 text-sm font-semibold text-red-700 dark:text-red-400">From ${svc.priceFrom}</p>
                  )}
                  <a href={`/en/agendar${slug ? `?service=${encodeURIComponent(slug)}` : ""}`} class="mt-3 inline-block text-xs font-semibold text-red-700 hover:underline dark:text-red-400">
                    Request →
                  </a>
                </div>
              );
            })}
          </div>
          {services.length > 6 && (
            <div class="mt-6 text-center">
              <a href="/en/servicios" class="btn-base btn-secondary">See all services</a>
            </div>
          )}
        </div>
      </section>
    )}

  </main>
  <Footer />
</Layout>

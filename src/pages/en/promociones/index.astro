---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getBusinessInfo, getPromotions } from "../../../lib/sanity.js";
import { business } from "../../../config/clinic";

const cms = await getBusinessInfo();
const promos = (await getPromotions()) || [];
const businessName = cms?.name || business.name;

const today = new Date(); today.setHours(0, 0, 0, 0);
const activePromos = promos.filter((p: any) => {
  if (!p.endDate) return true;
  const end = new Date(p.endDate); end.setHours(0, 0, 0, 0);
  return today <= end;
}).sort((a: any, b: any) => Number(b.pinned) - Number(a.pinned));
---

<Layout
  title={`Special Offers – ${businessName}`}
  description={`Current promotions and special offers from ${businessName} pest control in Charlotte, NC.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-red-50 to-white py-16 dark:from-[rgb(26,5,5)] dark:to-[rgb(28,5,5)]">
      <div class="mx-auto max-w-5xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Limited time</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">Special Offers</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(245,210,210)]">
          Take advantage of our current promotions on pest control services.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-5xl px-4">
        {activePromos.length === 0 ? (
          <p class="text-slate-500 dark:text-[rgb(240,190,190)]">No active promotions at this time. Check back soon!</p>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
            {activePromos.map((promo: any) => (
              <div class="rounded-2xl border border-amber-100 bg-amber-50 p-6 shadow-sm dark:border-[rgb(80,60,20)] dark:bg-[rgb(28,22,8)]">
                {promo.label && (
                  <span class="inline-block rounded-full bg-amber-200 px-2.5 py-0.5 text-xs font-bold text-amber-800 dark:bg-amber-900 dark:text-amber-200">
                    {promo.label}
                  </span>
                )}
                <h3 class="font-['Manrope',sans-serif] mt-2 font-bold text-slate-900 dark:text-white">{promo.title}</h3>
                {(promo.shortDescription || promo.description) && (
                  <p class="mt-2 text-sm text-slate-600 dark:text-[rgb(245,210,210)]">
                    {(promo.shortDescription || promo.description || "").slice(0, 160)}
                  </p>
                )}
                {promo.endDate && (
                  <p class="mt-3 text-xs text-amber-700 dark:text-amber-400">
                    Valid until: {new Date(promo.endDate).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </p>
                )}
                <a href="/en/agendar" class="btn-base btn-primary mt-4 block text-center text-sm">
                  Request now
                </a>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBusinessInfo } from "../../lib/sanity.js";
import { business } from "../../config/clinic";

const cms = await getBusinessInfo();
const businessName = cms?.name || business.name;
const address = cms?.address || business.address;
const mapsUrl = cms?.mapsUrl || business.googleMapsUrl;
---

<Layout
  title={`Location – ${businessName}`}
  description={`Find ${businessName} in Charlotte, NC. Get directions and view our location on Google Maps.`}
>
  <Header />
  <main id="contenido-principal">

    <section class="bg-gradient-to-b from-sky-50 to-white py-16 dark:from-[rgb(6,16,30)] dark:to-[rgb(8,20,38)]">
      <div class="mx-auto max-w-4xl px-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Where we are</p>
        <h1 class="font-['Manrope',sans-serif] mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">Location</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-[rgb(186,205,227)]">
          We serve Charlotte and surrounding areas in North Carolina.
        </p>
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-4xl px-4 space-y-6">
        <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
          <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">Address</p>
          <p class="font-['Manrope',sans-serif] text-xl font-bold text-slate-900 dark:text-white">{address}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            {mapsUrl && (
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-base btn-secondary"
              >
                Open in Google Maps
              </a>
            )}
            <a href="/en/agendar" class="btn-base btn-primary">Request service</a>
          </div>
        </div>

        {cms?.locationFacadeImageUrl && (
          <div class="overflow-hidden rounded-2xl border border-slate-100 dark:border-[rgb(36,58,86)]">
            <img
              src={cms.locationFacadeImageUrl}
              alt="Business location"
              class="h-64 w-full object-cover sm:h-80"
              loading="lazy"
            />
          </div>
        )}

        {cms?.locationGuideTips && cms.locationGuideTips.length > 0 && (
          <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm dark:border-[rgb(36,58,86)] dark:bg-[rgb(12,28,50)]">
            <h2 class="font-['Manrope',sans-serif] mb-4 text-lg font-bold text-slate-900 dark:text-white">Getting here</h2>
            <ul class="space-y-2">
              {cms.locationGuideTips.map((tip: string) => (
                <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-[rgb(186,205,227)]">
                  <span class="mt-0.5 text-sky-500">→</span>
                  {tip}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

  </main>
  <Footer />
</Layout>

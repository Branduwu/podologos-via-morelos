# =============================================================================
# FUMIGACION BRANCH – FumiPro NC
# =============================================================================
# IMPORTANTE: Esta rama usa un proyecto de Sanity SEPARADO del de podologos.
# Pasos para configurar:
#   1. Ve a https://www.sanity.io/manage y crea un nuevo proyecto (ej. "fumipronc")
#   2. Copia el Project ID y pégalo en todas las variables SANITY_*_PROJECT_ID
#   3. Para el studioHost y studioAppId, actualiza cms/sanity.cli.js
# =============================================================================

# URL del sitio (para SEO y canonical links)
PUBLIC_SITE_URL=https://fumipronc.vercel.app

# Sentry – Error tracking (opcional)
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Sanity – Frontend (lectura de contenido)
# Reemplaza con el Project ID del NUEVO proyecto de fumigacion
SANITY_PROJECT_ID=
SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity Studio – CMS (cms/)
# Reemplaza con el Project ID del NUEVO proyecto de fumigacion
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Sanity Studio – Hostname y App ID (ver cms/sanity.cli.js)
# Obtén el App ID desde el Sanity Dashboard después de hacer el primer deploy del studio
SANITY_STUDIO_HOSTNAME=fumipronc
SANITY_STUDIO_APP_ID=

# Google Places – Reseñas de Google en la página de inicio
# Obtén tu API key en https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
